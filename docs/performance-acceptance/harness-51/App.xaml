<Application x:Class="Acceptance51.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Acceptance51">
  <Application.Resources><ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
    <Style x:Key="SmallIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}" />
    <Style x:Key="PageProgressRingStyle" TargetType="ProgressRing" />
    <local:FixtureConverter x:Key="BitmapConverter" />
    <local:FixtureConverter x:Key="ObjectToVisibilityConverter" VisibilityMode="True" />
  </ResourceDictionary></Application.Resources>
</Application>
