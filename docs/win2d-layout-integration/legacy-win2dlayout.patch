From 357fade2dcdd62f727df23caabc98407111f31af Mon Sep 17 00:00:00 2001
From: MangMax <MangMax@users.noreply.github.com>
Date: Mon, 2 Nov 2026 01:44:43 +0800
Subject: [PATCH] perf: reuse one device text layout for danmaku measure and
 draw

Measure with a CanvasTextLayout created directly from the render device
instead of a 0x0 CanvasRenderTarget and temporary drawing session. Reuse
that layout for the final target by setting RequestedSize to the measured
size, replacing the second layout previously created on the drawing
session. Measured widths/heights, expiry checks, positions and drawing
code are unchanged.

Co-Authored-By: Claude Code <noreply@anthropic.com>
---
 src/Danmaku.Legacy/DanmakuRender.cs | 339 ++++++++++++++--------------
 1 file changed, 166 insertions(+), 173 deletions(-)

diff --git a/src/Danmaku.Legacy/DanmakuRender.cs b/src/Danmaku.Legacy/DanmakuRender.cs
index 822165c..0dd04f6 100644
--- a/src/Danmaku.Legacy/DanmakuRender.cs
+++ b/src/Danmaku.Legacy/DanmakuRender.cs
@@ -281,32 +281,26 @@ namespace Richasy.Danmaku.Legacy
                         return;
                     }
 
-                    // Measure text size
-                    using (CanvasRenderTarget tempRenderTarget = new CanvasRenderTarget(_device, 0, 0, _dpi))
+                    // Measure with a device-backed layout. CanvasTextLayout only captures
+                    // the resource creator's device, so this has the same metrics as the
+                    // previous 0x0 target/session measurement without allocating a target.
+                    using CanvasTextLayout textLayout = new CanvasTextLayout(_device, danmakuText, textFormat, CanvasWidth - 24f, 0);
+                    // Leave padding space for border
+                    renderItem.Width = (float)textLayout.LayoutBounds.Width + 8f;
+                    renderItem.Height = (float)textLayout.LayoutBounds.Height;
+                    textLayout.Options = CanvasDrawTextOptions.EnableColorFont;
+                    if (renderItem.HasOutline)
                     {
-                        using (CanvasDrawingSession drawingSession = tempRenderTarget.CreateDrawingSession())
-                        {
-                            using (CanvasTextLayout textLayout = new CanvasTextLayout(drawingSession, danmakuText, textFormat, CanvasWidth - 24f, 0))
-                            {
-                                // Leave padding space for border
-                                renderItem.Width = (float)textLayout.LayoutBounds.Width + 8f;
-                                renderItem.Height = (float)textLayout.LayoutBounds.Height;
-                                textLayout.Options = CanvasDrawTextOptions.EnableColorFont;
-                                if (renderItem.HasOutline)
-                                {
-                                    renderItem.Height += renderItem.OutlineSize;
-                                }
+                        renderItem.Height += renderItem.OutlineSize;
+                    }
 
-                                if (renderItem.Width <= 0 || renderItem.Height <= 0)
-                                {
-                                    return;
-                                }
-                                if (_maxDanmakuSize > 0 && (renderItem.Width >= _maxDanmakuSize || renderItem.Height >= _maxDanmakuSize))
-                                {
-                                    return;
-                                }
-                            }
-                        }
+                    if (renderItem.Width <= 0 || renderItem.Height <= 0)
+                    {
+                        return;
+                    }
+                    if (_maxDanmakuSize > 0 && (renderItem.Width >= _maxDanmakuSize || renderItem.Height >= _maxDanmakuSize))
+                    {
+                        return;
                     }
 
                     // Exact measured-width lifetime: do not allocate textures for
@@ -319,175 +313,174 @@ namespace Richasy.Danmaku.Legacy
