<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <RollForward>LatestPatch</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>preview</LangVersion>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- Match the production app's observable-property generator configuration. -->
    <MvvmToolkitEnableINotifyPropertyChangingSupport>false</MvvmToolkitEnableINotifyPropertyChangingSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- 与 UI 工程的 GlobalUsing.cs 对齐：链接的 AI 源文件直接使用 StringBuilder 等类型。 -->
    <Using Include="System.Text" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\Controls\Markdown\MarkdownImageLoader.cs" Link="Markdown\MarkdownImageLoader.cs" />
    <ProjectReference Include="..\..\externals\bili-kernel\src\Services\Services.Media\Services.Media.csproj" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\Danmaku\*.cs" Link="Danmaku\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Exercise the real page commands with headless adapters for Windows-only services. -->
  <ItemGroup>
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\Controls\IncrementVerticalScrollControl.xaml.cs" Link="Scroll\IncrementVerticalScrollControl.xaml.cs" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\Controls\RecommendationScrollAnchor.cs" Link="Scroll\RecommendationScrollAnchor.cs" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\Components\SearchBoxViewModel\*.cs" Link="Search\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\Items\SearchSuggestItemViewModel.cs" Link="Search\SearchSuggestItemViewModel.cs" />
    <ProjectReference Include="..\..\externals\bili-kernel\src\BiliKernel.Abstractions\BiliKernel.Abstractions.csproj" />
    <ProjectReference Include="..\..\externals\bili-kernel\src\Services\Services.Article\Services.Article.csproj" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\View\PopularPageViewModel\*.cs" Link="Popular\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\View\ViewLaterPageViewModel\*.cs" Link="ViewLater\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\View\VideoPartitionPageViewModel\*.cs" Link="Partition\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\Components\VideoPartitionDetailViewModel\*.cs" Link="Partition\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\Items\PartitionViewModel.cs" Link="Partition\PartitionViewModel.cs" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\Recommend\*.cs" Link="Recommend\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI.Models\Constants\RecommendFeedSource.cs" Link="Recommend\RecommendFeedSource.cs" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI.Models\Constants\PopularSectionType.cs" Link="Popular\PopularSectionType.cs" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI.Models\Constants\VideoCardStyle.cs" Link="Popular\VideoCardStyle.cs" />
  </ItemGroup>

  <!--
    空降助手的纯逻辑与 WinUI 无关，直接链接源文件进行测试，
    避免测试项目引用 WinUI 可执行项目。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\SponsorBlock\*.cs" Link="SponsorBlock\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\Items\SponsorBlockCategorySettingViewModel.cs" Link="ViewModels\Items\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI.Models\Constants\SettingNames.cs" Link="Models\Constants\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    通用纯逻辑与 WinUI 无关，按目录整体链接，新增修复无需改动测试工程。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\Toolkits\Pure\*.cs" Link="Toolkits\Pure\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    AI 编排核心（上下文采集、提示词构建、配置快照、请求执行）与 WinUI 无关，
    整目录链接以便直接测试；WinUI/AgentKernel 适配器放在 Services\AI，不在此列。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\AI\**\*.cs" Link="AI\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    图片客户端只依赖 System.Net.Http，与 WinUI 无关；直接链接源文件，
    用本地 TLS 服务器验证真实客户端的证书校验与取消行为。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\Extensions\InternalHttpExtensions.cs" Link="Extensions\InternalHttpExtensions.cs" />
  </ItemGroup>

  <!--
    清晰度选择策略是纯逻辑：只依赖格式与偏好，不依赖 WinUI / 账号 VM，
    因此直接链接源文件验证选择规则，无需引用 WinUI 可执行项目。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\Resolvers\QualitySelectionStrategy.cs" Link="Resolvers\QualitySelectionStrategy.cs" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI.Models\Constants\PreferQualityType.cs" Link="Resolvers\PreferQualityType.cs" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI.Models\Constants\EpisodeAccessTag.cs" Link="Episodes\EpisodeAccessTag.cs" />
  </ItemGroup>

  <!-- Real navigation/cache logic; adapters provide only the Windows presentation surface. -->
  <ItemGroup>
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Core/NavigationViewModel.cs" Link="Navigation/NavigationViewModel.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/Controls/MainFrame.xaml.cs" Link="Navigation/MainFrame.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/Controls/OverlayFrame.xaml.cs" Link="Navigation/OverlayFrame.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/Pages/IParameterPage.cs" Link="Navigation/IParameterPage.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/Pages/IInitializePage.cs" Link="Navigation/IInitializePage.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/View/ICancelPageViewModel.cs" Link="Navigation/ICancelPageViewModel.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Desktop/BiliCopilot.UI/Controls/NavigationPageFactory.cs" Link="Navigation/NavigationPageFactory.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Items/NotifyMessageItemViewModel/*.cs" Link="NotifyMessage/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Core/PlayerViewModel/PlayerViewModel.Playback.cs" Link="Playback/PlayerViewModel.Playback.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Core/DanmakuRenderViewModel/*.cs" Link="Playback/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/Toolkits/FontCatalog.cs" Link="Playback/FontCatalog.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI.Models/Constants/DanmakuRendererType.cs" Link="Playback/DanmakuRendererType.cs" />
  </ItemGroup>
  <ItemGroup><Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Core/PlayerViewModel/PlayerViewModel.Speed.cs" Link="Playback/PlayerViewModel.Speed.cs" /></ItemGroup>
  <!-- 关闭后/迟到回调的会话复查：入队回调、换集与迟到写入的闸门与 WinUI 无关，直接链接验证。 -->
  <ItemGroup><Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Core/PlayerViewModel/PlayerViewModel.LateCallbacks.cs" Link="Playback/PlayerViewModel.LateCallbacks.cs" /></ItemGroup>
  <!-- 释放/回滚的失效入口与同步会话检查；只用适配器提供的关闭标记与弹幕会话字段。 -->
  <ItemGroup><Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Core/PlayerViewModel/PlayerViewModel.Session.cs" Link="Playback/PlayerViewModel.Session.cs" /></ItemGroup>

  <!-- 播放会话的生命周期（创建/登记/初始化回滚/释放）与 WinUI 无关，用假会话直接测试。 -->
  <ItemGroup>
    <Compile Include="../../src/Desktop/BiliCopilot.UI/Player/*.cs" Link="Player/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Article list refresh and reader identity; adapters only supply the card item, comments/AI and OS surface. -->
  <ItemGroup>
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Components/ArticlePartitionDetailViewModel/*.cs" Link="Article/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/View/ArticleReaderPageViewModel/*.cs" Link="Article/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI.Models/Constants/ArticleCardStyle.cs" Link="Article/ArticleCardStyle.cs" />
  </ItemGroup>

  <!-- 用户空间页的目标归属：页面与动态分区视图模型是生产代码，适配器只补 WinUI 展示层与内核接口假实现。 -->
  <ItemGroup>
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/View/UserSpacePageViewModel/*.cs" Link="UserSpace/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Components/UserMomentDetailViewModel/*.cs" Link="UserSpace/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI.Models/PinItem.cs" Link="UserSpace/PinItem.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI.Models/Constants/PinContentType.cs" Link="UserSpace/PinContentType.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI.Models/Constants/MomentCardStyle.cs" Link="UserSpace/MomentCardStyle.cs" />
  </ItemGroup>
  <!-- Real search recovery regression; legacy investigation switch remains supported. -->
  <PropertyGroup Condition="'$(SearchRecoveryRegression)' == 'true' Or '$(SearchRecoveryInvestigation)' == 'true'">
    <DefineConstants>$(DefineConstants);SEARCH_RECOVERY_INVESTIGATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(SearchRecoveryRegression)' == 'true' Or '$(SearchRecoveryInvestigation)' == 'true'">
    <Compile Remove="NavigationFrameTests.cs;NavigationViewModelTests.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/Pages/Overlay/SearchPage.xaml.cs" Link="SearchRecovery/SearchPage.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/View/SearchPageViewModel/*.cs" Link="SearchRecovery/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Components/VideoSearchSectionDetailViewModel/*.cs" Link="SearchRecovery/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Components/PgcSearchSectionDetailViewModel/*.cs" Link="SearchRecovery/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI.Models/Constants/SeasonCardStyle.cs" Link="SearchRecovery/SeasonCardStyle.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Items/ISearchSectionDetailViewModel.cs" Link="SearchRecovery/ISearchSectionDetailViewModel.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI.Models/Constants/SearchSectionType.cs" Link="SearchRecovery/SearchSectionType.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Desktop/BiliCopilot.UI/Controls/Article/ArticleReader.Content.cs" Link="Article/ArticleReader.Content.cs" />
  </ItemGroup>

  <!--
    直播分区详情/页面视图模型是生产代码；适配器只补 WinUI 展示层与直播卡片条目。
    覆盖「分区列表加载失败或返回空标签」的收尾路径（#171）。
  -->
  <ItemGroup>
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/Components/LivePartitionDetailViewModel/*.cs" Link="LivePartition/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/ViewModels/View/LivePartitionPageViewModel/*.cs" Link="LivePartition/%(Filename)%(Extension)" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI/Controls/LivePartition/LiveSubPartitionSelector.xaml.cs" Link="LivePartition/LiveSubPartitionSelector.cs" />
    <Compile Include="../../src/Desktop/BiliCopilot.UI.Models/Constants/LiveCardStyle.cs" Link="LivePartition/LiveCardStyle.cs" />
  </ItemGroup>
</Project>
