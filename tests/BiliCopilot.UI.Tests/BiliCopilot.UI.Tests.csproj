<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>preview</LangVersion>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    空降助手的纯逻辑与 WinUI 无关，直接链接源文件进行测试，
    避免测试项目引用 WinUI 可执行项目。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\SponsorBlock\*.cs" Link="SponsorBlock\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\Items\SponsorBlockCategorySettingViewModel.cs" Link="ViewModels\Items\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI.Models\Constants\SettingNames.cs" Link="Models\Constants\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
