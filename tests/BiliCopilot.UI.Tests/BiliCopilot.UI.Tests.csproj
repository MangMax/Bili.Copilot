<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>preview</LangVersion>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Exercise the real page commands with headless adapters for Windows-only services. -->
  <ItemGroup>
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\Components\SearchBoxViewModel\*.cs" Link="Search\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\Items\SearchSuggestItemViewModel.cs" Link="Search\SearchSuggestItemViewModel.cs" />
    <ProjectReference Include="..\..\externals\bili-kernel\src\BiliKernel.Abstractions\BiliKernel.Abstractions.csproj" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\View\PopularPageViewModel\*.cs" Link="Popular\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI.Models\Constants\PopularSectionType.cs" Link="Popular\PopularSectionType.cs" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI.Models\Constants\VideoCardStyle.cs" Link="Popular\VideoCardStyle.cs" />
  </ItemGroup>

  <!--
    空降助手的纯逻辑与 WinUI 无关，直接链接源文件进行测试，
    避免测试项目引用 WinUI 可执行项目。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\SponsorBlock\*.cs" Link="SponsorBlock\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\ViewModels\Items\SponsorBlockCategorySettingViewModel.cs" Link="ViewModels\Items\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI.Models\Constants\SettingNames.cs" Link="Models\Constants\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    通用纯逻辑与 WinUI 无关，按目录整体链接，新增修复无需改动测试工程。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Desktop\BiliCopilot.UI\Toolkits\Pure\*.cs" Link="Toolkits\Pure\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
