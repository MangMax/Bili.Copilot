<?xml version="1.0" encoding="utf-8" ?>
<local:PgcEpisodesSectionBase
    x:Class="BiliCopilot.UI.Controls.Player.PgcEpisodesSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:playervm="using:BiliCopilot.UI.ViewModels.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Name="DefaultTemplate" x:DataType="items:EpisodeItemViewModel">
            <components:EpisodeCardControl Style="{StaticResource PlayerEpisodeCardStyle}" ViewModel="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Name="IndexTemplate" x:DataType="items:EpisodeItemViewModel">
            <base:AppToggleCard
                Padding="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                BorderBrush="Transparent"
                BorderThickness="2"
                Command="{x:Bind PlayCommand}"
                IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                IsEnableCheck="False">
                <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Text="{x:Bind Index, Mode=OneTime}" />
                    <Border
                        Width="8"
                        Height="8"
                        Margin="0,4,4,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="{x:Bind AccessTagAutomationName, Mode=OneWay}"
                        CornerRadius="4"
                        Visibility="{x:Bind IsAccessTagHighlighted, Mode=OneWay}">
                        <Border.Background>
                            <SolidColorBrush Color="{x:Bind AccessTagColor, Mode=OneWay}" />
                        </Border.Background>
                    </Border>
                </Grid>
            </base:AppToggleCard>
        </DataTemplate>
        <StackLayout x:Name="DefaultLayout" Spacing="8" />
        <UniformGridLayout
            x:Name="IndexLayout"
            ItemsStretch="Fill"
            MinColumnSpacing="8"
            MinItemHeight="40"
            MinItemWidth="36"
            MinRowSpacing="8" />
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  正片 / 花絮 / 预告等分组切换  -->
        <ComboBox
            Margin="12,8,12,0"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="PgcEpisodeGroupSelector"
            ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.SelectedGroup, Mode=TwoWay}"
            Visibility="{x:Bind ViewModel.HasMultipleGroups, Mode=OneWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="playervm:PgcPlayerEpisodeGroupViewModel">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ToggleSwitch
            Grid.Row="1"
            Margin="12,8,12,0"
            IsOn="{x:Bind ViewModel.OnlyIndex, Mode=TwoWay}"
            OffContent="{ext:Locale Name=OnlyIndex}"
            OnContent="{ext:Locale Name=OnlyIndex}"
            Toggled="OnIndexToggledAsync"
            Visibility="{x:Bind ViewModel.ShowIndexToggle, Mode=OneWay}" />

        <Grid Grid.Row="2">
            <ScrollView
                x:Name="DefaultView"
                Padding="12,0"
                x:Load="{x:Bind ViewModel.ShowIndexLayout, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}">
                <repeater:AppRepeater
                    Margin="0,0,0,12"
                    ItemTemplate="{StaticResource DefaultTemplate}"
                    ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                    Layout="{StaticResource DefaultLayout}" />
            </ScrollView>
            <ScrollView
                x:Name="IndexView"
                Padding="12,0"
                x:Load="{x:Bind ViewModel.ShowIndexLayout, Mode=OneWay}">
                <repeater:AppRepeater
                    Margin="0,0,0,12"
                    ItemTemplate="{StaticResource IndexTemplate}"
                    ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}"
                    Layout="{StaticResource IndexLayout}" />
            </ScrollView>
        </Grid>
    </Grid>
</local:PgcEpisodesSectionBase>
