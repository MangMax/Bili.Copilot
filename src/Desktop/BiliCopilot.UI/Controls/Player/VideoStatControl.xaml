<?xml version="1.0" encoding="utf-8" ?>
<local:VideoPlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Player.VideoStatControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:comp="using:BiliCopilot.UI.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Orientation="Horizontal" Spacing="12">
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="{ext:Locale Name=PlayCount}">
            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconPlayCircle}" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind ViewModel.PlayCount, Mode=OneWay, Converter={StaticResource CountConverter}}" TextLineBounds="Tight" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="{ext:Locale Name=ReplyCount}">
            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconComment}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind ViewModel.CommentCount, Mode=OneWay, Converter={StaticResource CountConverter}}" TextLineBounds="Tight" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" ToolTipService.ToolTip="{ext:Locale Name=DanmakuCount}">
            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconDanmaku}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind ViewModel.DanmakuCount, Mode=OneWay, Converter={StaticResource CountConverter}}" TextLineBounds="Tight" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconEye}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind ViewModel.OnlineCountText, Mode=OneWay}" TextLineBounds="Tight" Style="{StaticResource CaptionTextBlockStyle}" />
        </StackPanel>
    </StackPanel>
</local:VideoPlayerControlBase>
