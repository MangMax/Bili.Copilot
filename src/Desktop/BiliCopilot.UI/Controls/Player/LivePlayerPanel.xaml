<?xml version="1.0" encoding="utf-8" ?>
<local:LivePlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Player.LivePlayerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        直播侧栏与点播侧栏同构：固定 360、头部留白、1px 分割线、正文占满高度。
        竖屏/窄窗口只收起聊天内容，不改变窗口布局。
    -->
    <Grid Width="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Padding="16,16,16,12" Spacing="10">
            <!--  标题行：标题 + 在浏览器打开（图标按钮）。  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <base:TrimTextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    MaxLines="2"
                    Text="{x:Bind ViewModel.Title, Mode=OneWay, FallbackValue=''}" />
                <Button
                    Grid.Column="1"
                    Padding="6"
                    VerticalAlignment="Top"
                    AutomationProperties.Name="{ext:Locale Name=OpenInBrowser}"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.OpenInBrowserCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{ext:Locale Name=OpenInBrowser}">
                    <ic:SymbolIcon FontSize="14" Symbol="Globe" />
                </Button>
            </Grid>

            <!--  UP 主：与点播侧栏同一套头像/昵称布局。  -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:UpSectionControl
                    Margin="-8,0,0,0"
                    HorizontalAlignment="Left"
                    Avatar="{x:Bind ViewModel.UpAvatar, Mode=OneWay}"
                    IsFollowButtonShown="False"
                    Subtitle="{x:Bind ViewModel.TagName, Mode=OneWay}"
                    UserName="{x:Bind ViewModel.UpName, Mode=OneWay}" />
                <Border
                    Grid.Column="1"
                    Padding="7,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="4">
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.RoomStatusText, Mode=OneWay, FallbackValue=''}" />
                </Border>
            </Grid>

            <!--  统计行：热度、在线人数、开播时长。  -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.PopularityText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                    <ic:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Symbol="Heart" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.PopularityText, Mode=OneWay, FallbackValue=''}" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.ViewerCountText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                    <ic:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Symbol="People" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ViewerCountText, Mode=OneWay, FallbackValue=''}" />
                </StackPanel>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.UptimeText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                    <ic:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Symbol="Clock" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.UptimeText, Mode=OneWay, FallbackValue=''}" />
                </StackPanel>
            </StackPanel>

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Text="{x:Bind ViewModel.RoomStateDescription, Mode=OneWay, FallbackValue=''}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsRoomTerminal, Mode=OneWay, FallbackValue=Collapsed}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Height="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <local:LiveChatSidebar
                x:Name="ChatSidebar"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}" />

            <StackPanel
                Grid.Row="1"
                Padding="16,8,16,12"
                Spacing="10">
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.ErrorText, Mode=OneWay, FallbackValue=''}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.ErrorText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}" />
            </StackPanel>
        </Grid>
    </Grid>
</local:LivePlayerControlBase>
