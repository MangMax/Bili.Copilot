<?xml version="1.0" encoding="utf-8" ?>
<local:LivePlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Player.LivePlayerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Width="360" MinHeight="320">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Rectangle
            Height="12"
            HorizontalAlignment="Stretch"
            Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <StackPanel
            Grid.Row="1"
            Padding="16,4,16,12"
            Spacing="6">
            <base:TrimTextBlock
                FontSize="18"
                FontWeight="SemiBold"
                MaxLines="2"
                Text="{x:Bind ViewModel.Title, Mode=OneWay, FallbackValue=''}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.UpName, Mode=OneWay, FallbackValue=''}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.RoomStatusText, Mode=OneWay, FallbackValue=''}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.TagName, Mode=OneWay, FallbackValue=''}"
                    Visibility="{x:Bind ViewModel.TagName, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}" />
            </StackPanel>
        </StackPanel>
        <Border
            Grid.Row="2"
            Height="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <!--
            聊天侧栏（#197）占满剩余高度，房间信息与画质/线路收在其下方。
            侧栏折叠后聊天区让出空间，但画质/线路/兜底入口仍然可用；
            侧栏只在自己的行里伸缩，不触碰全屏与画中画的窗口级布局。
        -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <local:LiveChatSidebar
                x:Name="ChatSidebar"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsChatCollapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}, FallbackValue=Visible}" />
        <StackPanel
            Grid.Row="1"
            Padding="16,8,16,12"
            Spacing="10">
            <!--  画质来自内核返回的格式；选择后重新取地址并原位重开，只持久化清晰度标识。  -->
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{ext:Locale Name=Quality}" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Name"
                    ItemsSource="{x:Bind ViewModel.Qualities, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" />
            </StackPanel>
            <!--  线路来自排序后的候选；线路偏好跨刷新保留，但不落盘签名地址。  -->
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{ext:Locale Name=PlayLine}" />
                <ComboBox
                    HorizontalAlignment="Stretch"
                    DisplayMemberPath="Name"
                    ItemsSource="{x:Bind ViewModel.Lines, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedLine, Mode=TwoWay}" />
            </StackPanel>
            <!--  弹幕连接状态与准入计数（#196）：紧凑调试行，便于用户反馈时取证。  -->
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                Text="{x:Bind ViewModel.DanmakuConnectionText, Mode=OneWay, FallbackValue=''}" />
            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind ViewModel.DanmakuCountersText, Mode=OneWay, FallbackValue=''}"
                TextWrapping="Wrap" />
            <!--  地址/鉴权/解码失败时给出可读原因与兜底入口。  -->
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Text="{x:Bind ViewModel.ErrorText, Mode=OneWay, FallbackValue=''}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.ErrorText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}" />
            <HyperlinkButton
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.OpenInBrowserCommand, Mode=OneWay}"
                Content="{ext:Locale Name=OpenInBrowser}" />
        </StackPanel>
        </Grid>
    </Grid>
</local:LivePlayerControlBase>