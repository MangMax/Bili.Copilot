<?xml version="1.0" encoding="utf-8" ?>
<local:PgcPlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Player.PgcOperationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:icons="using:BiliCopilot.UI.Icons"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="20">
        <StackPanel Orientation="Horizontal" Spacing="16">
            <local:LikeButton
                Command="{x:Bind ViewModel.ToggleLikeCommand, Mode=OneWay}"
                IsCompactOverlay="{x:Bind ViewModel.Parent.Player.IsCompactOverlay, Mode=OneWay, FallbackValue=False}"
                IsLiked="{x:Bind ViewModel.IsLiked, Mode=OneWay}"
                Tip="{x:Bind ViewModel.LikeCount, Mode=OneWay, Converter={StaticResource CountConverter}}"
                TripleCommand="{x:Bind ViewModel.TripleCommand, Mode=OneWay}" />
            <local:CoinButton
                AlsoLike="{x:Bind ViewModel.IsCoinAlsoLike, Mode=TwoWay}"
                Command="{x:Bind ViewModel.CoinCommand, Mode=OneWay}"
                IsCoined="{x:Bind ViewModel.IsCoined, Mode=OneWay}"
                Tip="{x:Bind ViewModel.CoinCount, Mode=OneWay, Converter={StaticResource CountConverter}}" />
            <local:FavoriteButton
                Command="{x:Bind ViewModel.FavoriteCommand, Mode=OneWay}"
                InitializeCommand="{x:Bind ViewModel.InitializeFavoritesCommand}"
                IsFavorited="{x:Bind ViewModel.IsFavorited, Mode=OneWay}"
                ItemsSource="{x:Bind ViewModel.FavoriteFolders, Mode=OneWay}"
                Tip="{x:Bind ViewModel.FavoriteCount, Mode=OneWay, Converter={StaticResource CountConverter}}" />
        </StackPanel>
        <Button
            Padding="16,8"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="PgcPlayerFollow"
            Command="{x:Bind ViewModel.ToggleFollowCommand, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.CanChangeFollowStatus, Mode=OneWay, FallbackValue=False}"
            Visibility="{x:Bind ViewModel.IsFollow, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontFamily="{StaticResource BiliIconsFontFamily}"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Glyph="{StaticResource IconHeart}" />
                <TextBlock Text="{ext:Locale Name=PgcFollow}" />
            </StackPanel>
        </Button>
        <ToggleSplitButton
            Padding="16,8"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            AutomationProperties.AutomationId="PgcPlayerFollowMenu"
            AutomationProperties.Name="{ext:Locale Name=PgcFollowed}"
            Click="OnFollowedClick"
            IsChecked="True"
            IsEnabled="{x:Bind ViewModel.CanChangeFollowStatus, Mode=OneWay, FallbackValue=False}"
            Visibility="{x:Bind ViewModel.IsFollow, Mode=OneWay, FallbackValue=Collapsed}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontFamily="{StaticResource BiliIconsFontFamily}"
                    FontSize="14"
                    Glyph="{x:Bind icons:IconGlyph.Checkmark, Mode=OneTime}" />
                <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=PgcFollowed}" />
            </StackPanel>
            <ToggleSplitButton.Flyout>
                <MenuFlyout Placement="Bottom">
                    <MenuFlyoutItem Command="{x:Bind ViewModel.MarkWantWatchCommand, Mode=OneWay}" Text="{ext:Locale Name=MarkWantWatch}" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.MarkWatchingCommand, Mode=OneWay}" Text="{ext:Locale Name=MarkWatching}" />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.MarkWatchedCommand, Mode=OneWay}" Text="{ext:Locale Name=MarkWatched}" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.ToggleFollowCommand, Mode=OneWay}" Text="{ext:Locale Name=PgcUnfollow}" />
                </MenuFlyout>
            </ToggleSplitButton.Flyout>
        </ToggleSplitButton>
        <local:DownloadButton ViewModel="{x:Bind ViewModel.Downloader, Mode=OneWay}" />
        <StackPanel Spacing="4">
            <TextBlock
                HorizontalAlignment="Left"
                FontSize="12"
                IsTextSelectionEnabled="True">
                <Run Text="SS" />
                <Run FontWeight="Bold" Text="{x:Bind ViewModel.SeasonId, Mode=OneWay}" />
            </TextBlock>
            <TextBlock
                HorizontalAlignment="Left"
                FontSize="12"
                IsTextSelectionEnabled="True">
                <Run Text="EP" />
                <Run FontWeight="Bold" Text="{x:Bind ViewModel.EpisodeId, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>
    </StackPanel>
</local:PgcPlayerControlBase>
