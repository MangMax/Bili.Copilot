<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Player.LiveChatMessageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--  进房提示：浅色单行，不占卡片高度。  -->
        <TextBlock
            Margin="12,2"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="{x:Bind ViewModel.EnterText, Mode=OneWay, FallbackValue=''}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsEnterRoom, Mode=OneWay, FallbackValue=Collapsed}" />

        <!--  普通弹幕：与点播评论同构的卡片；正文复用 EmoteTextBlock。  -->
        <Grid
            Margin="0,0,0,4"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            ColumnSpacing="12"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind ViewModel.ShowNormalRow, Mode=OneWay, FallbackValue=Visible}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  头像：PersonPicture 自带空态占位，加载失败也不会留下空洞。  -->
            <PersonPicture
                Width="32"
                Height="32"
                VerticalAlignment="Top"
                ProfilePicture="{x:Bind ViewModel.AvatarUri, Mode=OneWay, Converter={StaticResource BitmapConverter}}" />

            <StackPanel Grid.Column="1" Spacing="4">
                <!--  发言人一行：姓名、等级图、勋章、舰长、头衔。  -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind ViewModel.NameBrush, Mode=OneWay}"
                        Text="{x:Bind ViewModel.UserName, Mode=OneWay, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis" />
                    <Image
                        Height="10"
                        VerticalAlignment="Center"
                        Source="{x:Bind ViewModel.UserLevelNumber, Mode=OneWay, Converter={StaticResource LevelImageConverter}}"
                        Visibility="{x:Bind ViewModel.HasUserLevel, Mode=OneWay, FallbackValue=Collapsed}" />
                    <Border
                        Padding="4,0"
                        VerticalAlignment="Center"
                        BorderBrush="{x:Bind ViewModel.MedalBrush, Mode=OneWay}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{x:Bind ViewModel.HasMedal, Mode=OneWay, FallbackValue=Collapsed}">
                        <TextBlock
                            FontSize="10"
                            Foreground="{x:Bind ViewModel.MedalBrush, Mode=OneWay}"
                            Text="{x:Bind ViewModel.MedalText, Mode=OneWay, FallbackValue=''}" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.BadgeText, Mode=OneWay, FallbackValue=''}"
                        Visibility="{x:Bind ViewModel.BadgeText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.UserTitle, Mode=OneWay, FallbackValue=''}"
                        Visibility="{x:Bind ViewModel.HasTitle, Mode=OneWay, FallbackValue=Collapsed}" />
                </StackPanel>

                <comp:EmoteTextBlock
                    FontSize="13"
                    MaxLines="10"
                    Text="{x:Bind ViewModel.Content, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!--  醒目留言卡片：金额与剩余时间，删除/到期后由列表移除。  -->
        <Border
            Padding="8,6"
            Background="{ThemeResource AccentFillColorSecondaryBrush}"
            CornerRadius="6"
            Visibility="{x:Bind ViewModel.IsSuperChat, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.PriceText, Mode=OneWay, FallbackValue=''}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.UserName, Mode=OneWay, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="11"
                        Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RemainingText, Mode=OneWay, FallbackValue=''}"
                        Visibility="{x:Bind ViewModel.IsRemainingVisible, Mode=OneWay, FallbackValue=Collapsed}" />
                </Grid>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.Text, Mode=OneWay, FallbackValue=''}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
