<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Player.LiveChatMessageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--  普通弹幕/进房：徽标行 + 昵称与正文（含表情图片）。  -->
        <StackPanel
            Spacing="2"
            Visibility="{x:Bind ViewModel.IsSuperChat, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}, FallbackValue=Visible}">
            <StackPanel
                Orientation="Horizontal"
                Spacing="4"
                Visibility="{x:Bind ViewModel.HasAnyBadge, Mode=OneWay, FallbackValue=Collapsed}">
                <Border
                    Padding="4,0"
                    VerticalAlignment="Center"
                    Background="{x:Bind ViewModel.MedalBrush, Mode=OneWay}"
                    CornerRadius="3"
                    Visibility="{x:Bind ViewModel.HasMedal, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.MedalName, Mode=OneWay, FallbackValue=''}" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontWeight="SemiBold"
                    Foreground="{x:Bind ViewModel.MedalBrush, Mode=OneWay}"
                    Text="{x:Bind ViewModel.MedalLevel, Mode=OneWay, FallbackValue=''}"
                    Visibility="{x:Bind ViewModel.HasMedal, Mode=OneWay, FallbackValue=Collapsed}" />
                <Border
                    Padding="3,0"
                    VerticalAlignment="Center"
                    BorderBrush="{x:Bind ViewModel.UserLevelBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Visibility="{x:Bind ViewModel.HasUserLevel, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock
                        FontSize="9"
                        Foreground="{x:Bind ViewModel.UserLevelBrush, Mode=OneWay}"
                        Text="{x:Bind ViewModel.UserLevel, Mode=OneWay, FallbackValue=''}" />
                </Border>
                <Border
                    Padding="4,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    CornerRadius="3"
                    Visibility="{x:Bind ViewModel.BadgeText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.BadgeText, Mode=OneWay, FallbackValue=''}" />
                </Border>
                <Border
                    Padding="4,0"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="3"
                    Visibility="{x:Bind ViewModel.HasTitle, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.UserTitle, Mode=OneWay, FallbackValue=''}" />
                </Border>
            </StackPanel>

            <RichTextBlock
                x:Name="ContentBlock"
                FontSize="12"
                IsTextSelectionEnabled="False"
                LineHeight="18"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  醒目留言卡片：金额与剩余时间，删除/到期后由列表移除。  -->
        <Border
            Padding="8,6"
            Background="{ThemeResource AccentFillColorSecondaryBrush}"
            CornerRadius="6"
            Visibility="{x:Bind ViewModel.IsSuperChat, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.PriceText, Mode=OneWay, FallbackValue=''}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.UserName, Mode=OneWay, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="11"
                        Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RemainingText, Mode=OneWay, FallbackValue=''}"
                        Visibility="{x:Bind ViewModel.IsRemainingVisible, Mode=OneWay, FallbackValue=Collapsed}" />
                </Grid>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.Text, Mode=OneWay, FallbackValue=''}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
