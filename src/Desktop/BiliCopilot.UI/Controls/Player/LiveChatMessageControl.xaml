<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Player.LiveChatMessageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comp="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <!--  系统提示（连接/重连/下播）：居中浅色单行，不套评论卡片。  -->
        <TextBlock
            Margin="12,2"
            HorizontalAlignment="Center"
            FontSize="11"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.ShowSystemRow, Mode=OneWay, FallbackValue=Collapsed}">
            <Run Text="{x:Bind ViewModel.SystemText, Mode=OneWay, FallbackValue=''}" />
            <Run Text="{x:Bind ViewModel.SystemDetail, Mode=OneWay, FallbackValue=''}" />
        </TextBlock>

        <!--  进房提示：浅色单行，不占卡片高度。  -->
        <TextBlock
            Margin="12,2"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
            Text="{x:Bind ViewModel.EnterText, Mode=OneWay, FallbackValue=''}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.IsEnterRoom, Mode=OneWay, FallbackValue=Collapsed}" />

        <!--  普通弹幕：与点播评论同构的卡片；正文复用 EmoteTextBlock。  -->
        <Grid
            Margin="0,0,0,4"
            Padding="12"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            ColumnSpacing="12"
            CornerRadius="{StaticResource ControlCornerRadius}"
            Visibility="{x:Bind ViewModel.ShowNormalRow, Mode=OneWay, FallbackValue=Visible}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  头像：PersonPicture 自带空态占位，加载失败也不会留下空洞。  -->
            <Grid
                Width="32"
                Height="32"
                VerticalAlignment="Top">
                <Border
                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                    CornerRadius="16">
                    <ic:SymbolIcon
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Symbol="Person" />
                </Border>
                <Border CornerRadius="16">
                    <Image
                        Source="{x:Bind ViewModel.AvatarSource, Mode=OneWay}"
                        Stretch="UniformToFill" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Spacing="4">
                <!--  发言人一行：姓名、等级图、勋章、舰长、头衔。  -->
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        MaxWidth="140"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind ViewModel.NameBrush, Mode=OneWay, Converter={StaticResource BrushOrDefaultConverter}, ConverterParameter=TextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.UserName, Mode=OneWay, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <Border
                        Grid.Column="1"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        Background="{x:Bind ViewModel.MedalBackgroundBrush, Mode=OneWay, Converter={StaticResource BrushOrDefaultConverter}, ConverterParameter=ControlFillColorSecondaryBrush}"
                        BorderBrush="{x:Bind ViewModel.MedalBrush, Mode=OneWay, Converter={StaticResource BrushOrDefaultConverter}, ConverterParameter=TextFillColorSecondaryBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{x:Bind ViewModel.HasMedal, Mode=OneWay, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Image
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center"
                                Source="{x:Bind ViewModel.MedalGuardIconSource, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasMedalGuardIcon, Mode=OneWay, FallbackValue=Collapsed}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{x:Bind ViewModel.MedalTextBrush, Mode=OneWay, Converter={StaticResource BrushOrDefaultConverter}, ConverterParameter=TextFillColorPrimaryBrush}"
                                Text="{x:Bind ViewModel.MedalText, Mode=OneWay, FallbackValue=''}" />
                        </StackPanel>
                    </Border>
                    <Image
                        Grid.Column="2"
                        Height="18"
                        VerticalAlignment="Center"
                        Source="{x:Bind ViewModel.TitleIconSource, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasTitleIcon, Mode=OneWay, FallbackValue=Collapsed}" />
                    <Border
                        Grid.Column="3"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="{x:Bind ViewModel.BadgeText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.BadgeText, Mode=OneWay, FallbackValue=''}" />
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <comp:EmoteTextBlock
                        FontSize="13"
                        MaxLines="10"
                        Text="{x:Bind ViewModel.Content, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Bottom"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.MergeText, Mode=OneWay, FallbackValue=''}"
                        Visibility="{x:Bind ViewModel.MergeText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}, FallbackValue=Collapsed}" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!--  醒目留言卡片：金额与剩余时间，删除/到期后由列表移除。  -->
        <Border
            Padding="8,6"
            Background="{ThemeResource AccentFillColorSecondaryBrush}"
            CornerRadius="6"
            Visibility="{x:Bind ViewModel.IsSuperChat, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.PriceText, Mode=OneWay, FallbackValue=''}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.UserName, Mode=OneWay, FallbackValue=''}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="11"
                        Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.RemainingText, Mode=OneWay, FallbackValue=''}"
                        Visibility="{x:Bind ViewModel.IsRemainingVisible, Mode=OneWay, FallbackValue=Collapsed}" />
                </Grid>
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Text="{x:Bind ViewModel.Text, Mode=OneWay, FallbackValue=''}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
