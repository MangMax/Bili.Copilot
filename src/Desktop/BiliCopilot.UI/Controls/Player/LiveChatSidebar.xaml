<?xml version="1.0" encoding="utf-8" ?>
<local:LiveChatControlBase
    x:Class="BiliCopilot.UI.Controls.Player.LiveChatSidebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:live="using:BiliCopilot.UI.Live"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题栏：折叠按钮键盘可达（Button 自带 Tab 焦点与 Enter/Space 激活）。  -->
        <Grid Padding="12,8,8,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="CollapseButton"
                Width="32"
                Height="32"
                AutomationProperties.Name="{ext:Locale Name=LiveChatCollapse}"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind ViewModel.ToggleChatCollapsedCommand, Mode=OneWay}"
                ToolTipService.ToolTip="{ext:Locale Name=LiveChatCollapse}">
                <Grid>
                    <FontIcon
                        FontSize="12"
                        Glyph="&#xE76B;"
                        Visibility="{x:Bind ViewModel.IsChatCollapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}, FallbackValue=Visible}" />
                    <FontIcon
                        FontSize="12"
                        Glyph="&#xE76C;"
                        Visibility="{x:Bind ViewModel.IsChatCollapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
                </Grid>
            </Button>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Text="{ext:Locale Name=LiveChatTitle}" />
            <ProgressRing
                Grid.Column="2"
                Width="16"
                Height="16"
                VerticalAlignment="Center"
                AutomationProperties.Name="{ext:Locale Name=LiveChatBackfilling}"
                IsActive="{x:Bind ViewModel.IsChatBackfilling, Mode=OneWay, FallbackValue=False}"
                Visibility="{x:Bind ViewModel.IsChatBackfilling, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}" />
        </Grid>

        <!--
            消息区：沿用 ChatSessionBody 的滚动所有权范式——外层 ScrollView + ItemsRepeater，
            只实例化可见区附近的条目；自动跟随由 40ms 稳定定时器驱动，用户上滚即停止。
        -->
        <Grid Grid.Row="1">
            <ScrollView
                x:Name="ChatView"
                Style="{StaticResource PageScrollViewStyle}"
                Visibility="{x:Bind ViewModel.IsChatCollapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}, FallbackValue=Visible}">
                <ItemsRepeater Margin="12,0,12,8" ItemsSource="{x:Bind ViewModel.ChatMessages, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="live:LiveChatMessageItem">
                            <local:LiveChatMessageControl Margin="0,3" ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollView>
            <base:EmptyHolder
                Description="{ext:Locale Name=LiveChatEmpty}"
                Emoji="&#x1F4AC;"
                Visibility="{x:Bind ViewModel.IsChatEmpty, Mode=OneWay, FallbackValue=Collapsed}" />

            <!--  回到底部：只在用户离开底部时出现，点击恢复自动跟随。  -->
            <Button
                x:Name="BackToBottomButton"
                Margin="0,0,0,12"
                Padding="10,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                AutomationProperties.Name="{ext:Locale Name=LiveChatBackToBottom}"
                Background="{ThemeResource AcrylicInAppFillColorCustomBrush}"
                Click="OnBackToBottomClick"
                CornerRadius="16"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontSize="10" Glyph="&#xE74B;" />
                    <TextBlock FontSize="12" Text="{ext:Locale Name=LiveChatBackToBottom}" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  屏蔽：只做展示侧过滤，计数可见；不发送、不送礼。  -->
        <Expander
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Visibility="{x:Bind ViewModel.IsChatCollapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}, FallbackValue=Visible}">
            <Expander.Header>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock FontSize="12" Text="{ext:Locale Name=LiveChatBlockTitle}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.ChatBlockCountersText, Mode=OneWay, FallbackValue=''}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Expander.Header>
            <StackPanel Padding="4,0,4,8" Spacing="6">
                <TextBox
                    x:Name="BlockUserIdBox"
                    AutomationProperties.Name="{ext:Locale Name=LiveChatBlockUserIdPlaceholder}"
                    Header="UID"
                    PlaceholderText="{ext:Locale Name=LiveChatBlockUserIdPlaceholder}" />
                <TextBox
                    x:Name="BlockUserNameBox"
                    AutomationProperties.Name="{ext:Locale Name=LiveChatBlockUserNamePlaceholder}"
                    Header="{ext:Locale Name=LiveChatBlockUserNamePlaceholder}"
                    PlaceholderText="{ext:Locale Name=LiveChatBlockUserNamePlaceholder}" />
                <TextBox
                    x:Name="BlockKeywordBox"
                    AutomationProperties.Name="{ext:Locale Name=LiveChatBlockKeywordPlaceholder}"
                    Header="{ext:Locale Name=LiveChatBlockKeywordPlaceholder}"
                    PlaceholderText="{ext:Locale Name=LiveChatBlockKeywordPlaceholder}" />
                <Button
                    HorizontalAlignment="Stretch"
                    Click="OnApplyBlockRulesClick"
                    Content="{ext:Locale Name=LiveChatBlockApply}" />
            </StackPanel>
        </Expander>
    </Grid>
</local:LiveChatControlBase>
