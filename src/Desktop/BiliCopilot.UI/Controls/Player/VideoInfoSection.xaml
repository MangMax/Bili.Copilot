<?xml version="1.0" encoding="utf-8" ?>
<local:VideoPlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Player.VideoInfoSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Richasy.BiliKernel.Models.Base"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BiliCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollView Style="{StaticResource PageScrollViewStyle}">
        <StackPanel Margin="16,12" Spacing="20">
            <StackPanel Spacing="8">
                <local:UpSectionControl
                    Margin="-8,0,0,0"
                    HorizontalAlignment="Left"
                    ActiveCommand="{x:Bind ViewModel.OpenUserSpaceCommand, Mode=OneWay}"
                    Avatar="{x:Bind ViewModel.UpAvatar, Mode=OneWay}"
                    IsFollow="{x:Bind ViewModel.IsFollow, Mode=OneWay}"
                    IsFollowButtonShown="{x:Bind ViewModel.IsMyVideo, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                    Subtitle="{x:Bind ViewModel.PublishRelativeTime, Mode=OneWay}"
                    ToggleFollowCommand="{x:Bind ViewModel.ToggleFollowCommand, Mode=OneWay}"
                    UserName="{x:Bind ViewModel.UpName, Mode=OneWay}" />
                <components:CollaboratorListControl
                    CollapseText="{ext:Locale Name=CollaboratorListCollapse}"
                    ExpandText="{ext:Locale Name=CollaboratorListExpand}"
                    Header="{ext:Locale Name=CreativeTeam}"
                    ItemsSource="{x:Bind ViewModel.Collaborators, Mode=OneWay}"
                    ScrollLeftText="{ext:Locale Name=CollaboratorListScrollLeft}"
                    ScrollRightText="{ext:Locale Name=CollaboratorListScrollRight}"
                    Visibility="{x:Bind ViewModel.HasCollaborators, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <local:VideoStatControl Margin="8,0,0,8" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                <repeater:AppRepeater ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                    <repeater:AppRepeater.ItemTemplate>
                        <DataTemplate x:DataType="app:BiliTag">
                            <Button
                                Padding="6,4"
                                AutomationProperties.AutomationId="{x:Bind Id, Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind Name, Mode=OneTime}"
                                Background="Transparent"
                                Click="OnTagButtonClick"
                                Content="{x:Bind Name, Mode=OneTime}"
                                FontSize="11" />
                        </DataTemplate>
                    </repeater:AppRepeater.ItemTemplate>
                    <repeater:AppRepeater.Layout>
                        <community:WrapLayout HorizontalSpacing="8" VerticalSpacing="8" />
                    </repeater:AppRepeater.Layout>
                </repeater:AppRepeater>
                <Grid
                    Padding="12,8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Visibility="{x:Bind ViewModel.Description, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <components:TimestampTextBlock
                        SeekCommand="{x:Bind ViewModel.Parent.SeekToTimestampCommand, Mode=OneWay, FallbackValue={x:Null}}"
                        Text="{x:Bind ViewModel.Description, Mode=OneWay}" />
                </Grid>
            </StackPanel>
            <StackPanel Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <local:LikeButton
                        Command="{x:Bind ViewModel.ToggleLikeCommand, Mode=OneWay}"
                        IsCompactOverlay="{x:Bind ViewModel.Parent.Player.IsCompactOverlay, Mode=OneWay, FallbackValue=False}"
                        IsLiked="{x:Bind ViewModel.IsLiked, Mode=OneWay}"
                        Tip="{x:Bind ViewModel.LikeCount, Mode=OneWay, Converter={StaticResource CountConverter}}"
                        TripleCommand="{x:Bind ViewModel.TripleCommand, Mode=OneWay}" />
                    <local:CoinButton
                        AlsoLike="{x:Bind ViewModel.IsCoinAlsoLike, Mode=TwoWay}"
                        Command="{x:Bind ViewModel.CoinCommand, Mode=OneWay}"
                        IsCoined="{x:Bind ViewModel.IsCoined, Mode=OneWay}"
                        Tip="{x:Bind ViewModel.CoinCount, Mode=OneWay, Converter={StaticResource CountConverter}}" />
                    <local:FavoriteButton
                        Command="{x:Bind ViewModel.FavoriteCommand, Mode=OneWay}"
                        InitializeCommand="{x:Bind ViewModel.InitializeFavoritesCommand}"
                        IsFavorited="{x:Bind ViewModel.IsFavorited, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.FavoriteFolders, Mode=OneWay}"
                        Tip="{x:Bind ViewModel.FavoriteCount, Mode=OneWay, Converter={StaticResource CountConverter}}" />
                </StackPanel>
                <local:DownloadButton ViewModel="{x:Bind ViewModel.Downloader, Mode=OneWay}" />
                <StackPanel Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Left"
                        FontSize="12"
                        IsTextSelectionEnabled="True">
                        <Run Text="AV" />
                        <Run FontWeight="Bold" Text="{x:Bind ViewModel.AvId, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        HorizontalAlignment="Left"
                        FontSize="12"
                        IsTextSelectionEnabled="True">
                        <Run Text="BV" />
                        <Run FontWeight="Bold" Text="{x:Bind ViewModel.BvId, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollView>
</local:VideoPlayerControlBase>
