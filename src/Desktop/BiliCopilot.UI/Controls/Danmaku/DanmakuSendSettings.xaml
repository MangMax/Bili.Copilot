<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Danmaku.DanmakuSendSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:Richasy.BiliKernel.Models"
    xmlns:converters="using:BiliCopilot.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:DanmakuLocationConverter x:Key="DanmakuLocationConverter" />
    </UserControl.Resources>

    <StackPanel Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="{ext:Locale Name=FontSize}" />
            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="16">
                <RadioButton
                    x:Name="StandardItem"
                    MinWidth="0"
                    AutomationProperties.AutomationId="DanmakuStandardSizeRadio"
                    Click="OnSizeItemClick"
                    Content="{ext:Locale Name=Standard}"
                    IsChecked="{x:Bind ViewModel.IsStandardSize, Mode=OneWay}"
                    Tag="Standard" />
                <RadioButton
                    x:Name="SmallItem"
                    MinWidth="0"
                    AutomationProperties.AutomationId="DanmakuSmallSizeRadio"
                    Click="OnSizeItemClick"
                    Content="{ext:Locale Name=Small}"
                    IsChecked="{x:Bind ViewModel.IsStandardSize, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                    Tag="Small" />
            </StackPanel>
        </StackPanel>
        <ComboBox
            x:Name="DanmakuLocationComboBox"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="DanmakuLocationComboBox"
            Header="{ext:Locale Name=Location}"
            ItemsSource="{x:Bind ViewModel.Locations, Mode=OneWay}"
            SelectedItem="{x:Bind ViewModel.Location, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="app:DanmakuLocation">
                    <TextBlock Text="{x:Bind Converter={StaticResource DanmakuLocationConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Spacing="12">
            <TextBlock Text="{ext:Locale Name=Color}" />
            <Grid
                Margin="0,-4,0,0"
                ColumnSpacing="8"
                Visibility="{x:Bind ViewModel.CanSendColoredDanmaku, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="DanmakuColorInput"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="DanmakuColorInput"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{ext:Locale Name=DanmakuColorHex}"
                    LostFocus="OnColorInputLostFocus"
                    MaxLength="7"
                    Text="{x:Bind ViewModel.Color, Mode=OneWay, Converter={StaticResource ColorTextConverter}}"
                    TextChanged="OnColorInputChanged" />
                <Rectangle
                    Grid.Column="1"
                    Width="80"
                    Fill="{x:Bind ViewModel.Color, Mode=OneWay, Converter={StaticResource BrushConverter}}"
                    RadiusX="4"
                    RadiusY="4" />
            </Grid>
            <ItemsRepeater
                x:Name="ColorRepeater"
                HorizontalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Colors, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.CanSendColoredDanmaku, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsJustification="SpaceBetween"
                        MaximumRowsOrColumns="7"
                        MinColumnSpacing="6"
                        MinItemHeight="32"
                        MinItemWidth="38"
                        MinRowSpacing="6" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="Color">
                        <Button
                            Width="38"
                            MinWidth="0"
                            Padding="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="{x:Bind Converter={StaticResource ColorTextConverter}, Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind Converter={StaticResource ColorTextConverter}}"
                            Click="OnColorItemClick"
                            DataContext="{x:Bind}"
                            ToolTipService.ToolTip="{x:Bind Converter={StaticResource ColorTextConverter}}">
                            <Rectangle
                                Fill="{x:Bind Converter={StaticResource BrushConverter}}"
                                RadiusX="3"
                                RadiusY="3" />
                        </Button>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{ext:Locale Name=DanmakuColorLevelRequired}"
                Visibility="{x:Bind ViewModel.CanSendColoredDanmaku, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
