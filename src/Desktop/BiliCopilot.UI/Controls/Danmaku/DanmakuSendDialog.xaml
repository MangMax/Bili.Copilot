<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="BiliCopilot.UI.Controls.Danmaku.DanmakuSendDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Danmaku"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{ext:Locale Name=SendDanmaku}"
    CloseButtonText="{ext:Locale Name=Cancel}"
    DefaultButton="Primary"
    PrimaryButtonText="{ext:Locale Name=Confirm}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <StackPanel
        Width="320"
        Spacing="12">
        <TextBox
            x:Name="InputBox"
            HorizontalAlignment="Stretch"
            PlaceholderText="{ext:Locale Name=DanmakuPlaceholder}" />
        <local:DanmakuSendSettings ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
    </StackPanel>
</ContentDialog>
