<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Settings.AboutSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="4">
        <base:SettingsCard
            Description="{x:Bind Update.VersionStatusText, Mode=OneWay}"
            Header="{ext:Locale Name=AppName}">
            <base:SettingsCard.HeaderIcon>
                <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/StoreLogo.png" />
            </base:SettingsCard.HeaderIcon>
            <Button
                AutomationProperties.AutomationId="SettingsUpdatePrimaryAction"
                Command="{x:Bind Update.SettingsActionCommand}"
                Content="{x:Bind Update.SettingsActionName, Mode=OneWay}" />
        </base:SettingsCard>

        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                AutomationProperties.AutomationId="SettingsUpdateReleaseNotes"
                Content="{ext:Locale Name=UpdateReleaseNotes}"
                Style="{StaticResource SubtleButtonStyle}"
                Visibility="{x:Bind Update.CanShowReleaseNotes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="380" Spacing="8">
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Update.DisplayReleaseNotes, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                            <HyperlinkButton
                                AutomationProperties.AutomationId="SettingsUpdateRelease"
                                Command="{x:Bind Update.OpenReleaseCommand}"
                                Content="{ext:Locale Name=UpdateOpenReleaseAction}" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button
                AutomationProperties.AutomationId="SettingsUpdateMirrors"
                Content="{ext:Locale Name=UpdateMirrorPrefixes}"
                Style="{StaticResource SubtleButtonStyle}">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel MaxWidth="320" Spacing="8">
                            <TextBlock Text="{ext:Locale Name=UpdateMirrorPrefixesDescription}" TextWrapping="Wrap" />
                            <TextBox
                                MaxHeight="120"
                                AutomationProperties.AutomationId="UpdateMirrorPrefixes"
                                AutomationProperties.Name="{ext:Locale Name=UpdateMirrorPrefixes}"
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                Text="{x:Bind ViewModel.UpdateMirrorPrefixes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <HyperlinkButton
                AutomationProperties.AutomationId="AboutProjectHome"
                Content="{ext:Locale Name=ProjectHomePage}"
                NavigateUri="https://github.com/MangMax/Bili.Copilot" />
            <HyperlinkButton
                AutomationProperties.AutomationId="AboutBiliHome"
                Content="{ext:Locale Name=BiliHomePage}"
                NavigateUri="https://space.bilibili.com/5992670" />
        </StackPanel>
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.Copyright, Mode=OneWay}"
            TextWrapping="Wrap" />
    </StackPanel>
</local:SettingsPageControlBase>
