<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Settings.AboutSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="4">
        <base:SettingsCard
            AutomationProperties.AutomationId="AboutAppVersion"
            Description="{x:Bind Update.VersionStatusText, Mode=OneWay}"
            Header="{ext:Locale Name=AppName}">
            <base:SettingsCard.HeaderIcon>
                <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/StoreLogo.png" />
            </base:SettingsCard.HeaderIcon>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <ProgressBar
                    Width="120"
                    AutomationProperties.AutomationId="AboutUpdateProgress"
                    IsIndeterminate="{x:Bind Update.IsProgressIndeterminate, Mode=OneWay}"
                    Maximum="100"
                    Minimum="0"
                    Value="{x:Bind Update.DisplayDownloadProgress, Mode=OneWay}"
                    Visibility="{x:Bind Update.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button
                    MinWidth="120"
                    AutomationProperties.AutomationId="CheckForUpdates"
                    AutomationProperties.Name="{x:Bind Update.MainActionText, Mode=OneWay}"
                    Command="{x:Bind Update.MainActionCommand}"
                    Content="{x:Bind Update.MainActionText, Mode=OneWay}" />
            </StackPanel>
        </base:SettingsCard>

        <base:SettingsExpander
            AutomationProperties.AutomationId="AboutUpdateNotes"
            Header="{ext:Locale Name=UpdateReleaseNotes}"
            IsExpanded="True"
            Visibility="{x:Bind Update.CanShowReleaseNotes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <base:SettingsExpander.HeaderIcon>
                <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconDocumentBulletList}" />
            </base:SettingsExpander.HeaderIcon>
            <HyperlinkButton
                AutomationProperties.AutomationId="AboutUpdateRelease"
                Command="{x:Bind Update.OpenReleaseCommand}"
                Content="{ext:Locale Name=UpdateOpenReleaseAction}" />
            <base:SettingsExpander.ItemsFooter>
                <ScrollViewer
                    MaxHeight="280"
                    Padding="16,12"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        AutomationProperties.AutomationId="AboutUpdateReleaseNotes"
                        IsTextSelectionEnabled="True"
                        Text="{x:Bind Update.DisplayReleaseNotes, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </base:SettingsExpander.ItemsFooter>
        </base:SettingsExpander>

        <StackPanel Orientation="Horizontal" Spacing="4">
            <HyperlinkButton
                AutomationProperties.AutomationId="AboutProjectHome"
                Content="{ext:Locale Name=ProjectHomePage}"
                NavigateUri="https://github.com/MangMax/Bili.Copilot" />
            <HyperlinkButton
                AutomationProperties.AutomationId="AboutOriginalProjectHome"
                Content="{ext:Locale Name=OriginalProjectHomePage}"
                NavigateUri="https://github.com/Richasy/Bili.Copilot" />
            <HyperlinkButton
                AutomationProperties.AutomationId="AboutBiliHome"
                Content="{ext:Locale Name=BiliHomePage}"
                NavigateUri="https://space.bilibili.com/5992670" />
        </StackPanel>
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.Copyright, Mode=OneWay}"
            TextWrapping="Wrap" />
    </StackPanel>
</local:SettingsPageControlBase>
