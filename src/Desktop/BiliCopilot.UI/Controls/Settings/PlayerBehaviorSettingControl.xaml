<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Settings.PlayerBehaviorSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:constants="using:BiliCopilot.UI.Models.Constants"
    xmlns:converters="using:BiliCopilot.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Settings"
    xmlns:sponsorblock="using:BiliCopilot.UI.SponsorBlock"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  类别行复用设置面板自带的展开项样式（内边距、分隔线、行距）。
                      该样式定义在控件库的 Generic.xaml 里，应用级字典查不到，必须在本地合并一次  -->
                <ResourceDictionary Source="ms-appx:///Richasy.WinUIKernel.Share/Base/SettingsControls/SettingsExpander/SettingsExpander.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:PreferQualityTypeConverter x:Key="PreferQualityConverter" />
            <converters:ExternalPlayerTypeConverter x:Key="ExternalPlayerTypeConverter" />
            <converters:DisplayModeConverter x:Key="DisplayModeConverter" />
            <converters:PreferDecodeTypeConverter x:Key="PreferDecodeConverter" />
            <converters:SponsorBlockBehaviorConverter x:Key="SponsorBlockBehaviorConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <base:SettingsExpander Description="{ext:Locale Name=PlayerBehaviorDescription}" Header="{ext:Locale Name=PlayerBehavior}">
        <base:SettingsExpander.HeaderIcon>
            <ic:SymbolIcon Symbol="Replay" />
        </base:SettingsExpander.HeaderIcon>
        <base:SettingsExpander.Items>
            <base:SettingsCard
                x:Name="HideMain"
                Description="{ext:Locale Name=HideMainWindowOnPlayDescription}"
                Header="{ext:Locale Name=HideMainWindowOnPlay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.HideMainWindowOnPlay, Mode=TwoWay}" />
            </base:SettingsCard>
            <base:SettingsCard
                x:Name="Integration"
                Description="{ext:Locale Name=UseIntegrationBehaviorDescription}"
                Header="{ext:Locale Name=UseIntegrationBehavior}"
                Visibility="{x:Bind ViewModel.HideMainWindowOnPlay, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.UseIntegrationWhenSinglePlayWindow, Mode=TwoWay}" />
            </base:SettingsCard>
            <base:SettingsCard Description="{ext:Locale Name=PreferDecodeDescription}" Header="{ext:Locale Name=PreferDecode}">
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{x:Bind ViewModel.PreferDecodeCollection, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PreferDecode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PreferDecodeType">
                            <TextBlock Text="{x:Bind Converter={StaticResource PreferDecodeConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </base:SettingsCard>
            <base:SettingsCard
                Description="{ext:Locale Name=CustomMpvConfigDescription}"
                Header="{ext:Locale Name=CustomMpvConfig}"
                Visibility="{x:Bind ViewModel.IsMpvCustomOptionVisible, Mode=OneWay}">
                <Button
                    MinWidth="120"
                    Command="{x:Bind ViewModel.OpenMpvConfigInEditorCommand, Mode=OneWay}"
                    Content="{ext:Locale Name=OpenConfig}" />
            </base:SettingsCard>
            <base:SettingsCard Header="{ext:Locale Name=PreferQuality}">
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{x:Bind ViewModel.PreferQualityCollection, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PreferQuality, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PreferQualityType">
                            <TextBlock Text="{x:Bind Converter={StaticResource PreferQualityConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </base:SettingsCard>
            <base:SettingsCard Header="{ext:Locale Name=DefaultPlayerDisplayMode}">
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{x:Bind ViewModel.PlayerDisplayModeCollection, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.DefaultPlayerDisplayMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PlayerDisplayMode">
                            <TextBlock Text="{x:Bind Converter={StaticResource DisplayModeConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </base:SettingsCard>
            <base:SettingsCard
                x:Name="ShowNextTip"
                Description="{ext:Locale Name=PlayNextWithoutTipDescription}"
                Header="{ext:Locale Name=PlayNextWithoutTip}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.PlayNextWithoutTip, Mode=TwoWay}" />
            </base:SettingsCard>
            <base:SettingsCard Description="{ext:Locale Name=AutoNextRelatedVideoDescription}" Header="{ext:Locale Name=AutoNextRelatedVideo}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsAutoPlayNextRecommendVideo, Mode=TwoWay}" />
            </base:SettingsCard>
            <base:SettingsCard Description="{ext:Locale Name=StopWhenEndOfPlaylistDescription}" Header="{ext:Locale Name=StopWhenEndOfPlaylist}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.EndWithPlaylist, Mode=TwoWay}" />
            </base:SettingsCard>
            <base:SettingsCard Description="{ext:Locale Name=NoP2PDescription}" Header="{ext:Locale Name=NoP2P}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.NoP2P, Mode=TwoWay}" />
            </base:SettingsCard>
            <base:SettingsCard Description="{ext:Locale Name=SponsorBlockDescription}" Header="{ext:Locale Name=SponsorBlock}">
                <ToggleSwitch
                    AutomationProperties.AutomationId="SponsorBlockEnabledToggle"
                    IsOn="{x:Bind ViewModel.IsSponsorBlockEnabled, Mode=TwoWay}" />
            </base:SettingsCard>
        </base:SettingsExpander.Items>
        <!--
            类别行为紧接在开关之后逐行排列，与上方其他设置行共用同一套展开项样式。
            放进 ItemsFooter 而不是 Items，是因为这里每一行本身就是 SettingsCard：
            作为 Item 会再套一层卡片，只能通过 ItemTemplate 才能保持原样，而标题又需要随开关联动隐藏。
        -->
        <base:SettingsExpander.ItemsFooter>
            <ItemsRepeater
                ItemsSource="{x:Bind ViewModel.SponsorBlockCategorySettings, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsSponsorBlockEnabled, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="items:SponsorBlockCategorySettingViewModel">
                        <base:SettingsCard
                            Header="{x:Bind DisplayName}"
                            Style="{StaticResource DefaultSettingsExpanderItemStyle}">
                            <ComboBox
                                AutomationProperties.AutomationId="{x:Bind Category}"
                                AutomationProperties.Name="{x:Bind DisplayName}"
                                MinWidth="140"
                                ItemsSource="{x:Bind AvailableBehaviors}"
                                SelectedItem="{x:Bind Behavior, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="sponsorblock:SponsorBlockBehavior">
                                        <TextBlock Text="{x:Bind Converter={StaticResource SponsorBlockBehaviorConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </base:SettingsCard>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </base:SettingsExpander.ItemsFooter>
    </base:SettingsExpander>
</local:SettingsPageControlBase>
