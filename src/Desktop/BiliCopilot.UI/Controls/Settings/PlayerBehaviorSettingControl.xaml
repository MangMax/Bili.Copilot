<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Settings.PlayerBehaviorSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:constants="using:BiliCopilot.UI.Models.Constants"
    xmlns:converters="using:BiliCopilot.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <converters:PreferQualityTypeConverter x:Key="PreferQualityConverter" />
            <converters:PreferDecodeTypeConverter x:Key="PreferDecodeConverter" />
            <converters:PreferCodecTypeConverter x:Key="PreferCodecConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <base:SettingsExpander Description="{ext:Locale Name=PlaybackNetworkQualityDescription}" Header="{ext:Locale Name=SettingsSubsectionPlaybackNetworkQuality}">
        <base:SettingsExpander.HeaderIcon>
            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconReplay}" />
        </base:SettingsExpander.HeaderIcon>
        <base:SettingsExpander.Items>
            <base:SettingsCard Header="{ext:Locale Name=PreferQuality}">
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{x:Bind ViewModel.PreferQualityCollection, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PreferQuality, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PreferQualityType">
                            <TextBlock Text="{x:Bind Converter={StaticResource PreferQualityConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </base:SettingsCard>
            <base:SettingsCard Description="{ext:Locale Name=PreferCodecDescription}" Header="{ext:Locale Name=PreferCodec}">
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{x:Bind ViewModel.PreferCodecCollection, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PreferCodec, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PreferCodecType">
                            <TextBlock Text="{x:Bind Converter={StaticResource PreferCodecConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </base:SettingsCard>
            <base:SettingsCard Description="{ext:Locale Name=PreferDecodeDescription}" Header="{ext:Locale Name=PreferDecode}">
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{x:Bind ViewModel.PreferDecodeCollection, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.PreferDecode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PreferDecodeType">
                            <TextBlock Text="{x:Bind Converter={StaticResource PreferDecodeConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </base:SettingsCard>
            <base:SettingsCard
                Header="{ext:Locale Name=PlaybackRoute}"
                Description="{ext:Locale Name=PlaybackRouteDescription}">
                <ComboBox
                    MinWidth="160"
                    AutomationProperties.AutomationId="PlaybackRoutePreference"
                    AutomationProperties.Name="{ext:Locale Name=PlaybackRoute}"
                    SelectedIndex="{x:Bind ViewModel.PlaybackRouteIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{ext:Locale Name=PlaybackRouteAuto}" />
                    <ComboBoxItem Content="{ext:Locale Name=PlaybackRoutePrimary}" />
                    <ComboBoxItem Content="{ext:Locale Name=PlaybackRouteBackup}" />
                    <ComboBoxItem Content="{ext:Locale Name=PlaybackRouteAli}" />
                    <ComboBoxItem Content="{ext:Locale Name=PlaybackRouteTencent}" />
                    <ComboBoxItem Content="{ext:Locale Name=PlaybackRouteHuawei}" />
                    <ComboBoxItem Content="{ext:Locale Name=PlaybackRouteOverseas}" />
                </ComboBox>
            </base:SettingsCard>
            <base:SettingsCard Description="{ext:Locale Name=NoP2PDescription}" Header="{ext:Locale Name=NoP2P}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.NoP2P, Mode=TwoWay}" />
            </base:SettingsCard>
            <base:SettingsCard Description="{ext:Locale Name=UseWebPlayerWhenLiveDescription}" Header="{ext:Locale Name=UseWebPlayerWhenLive}">
                <ToggleSwitch
                    AutomationProperties.AutomationId="UseWebPlayerWhenLive"
                    AutomationProperties.Name="{ext:Locale Name=UseWebPlayerWhenLive}"
                    IsOn="{x:Bind ViewModel.UseWebPlayerWhenLive, Mode=TwoWay}" />
            </base:SettingsCard>
        </base:SettingsExpander.Items>
    </base:SettingsExpander>
</local:SettingsPageControlBase>
