<?xml version="1.0" encoding="utf-8" ?>
<local:ChatMessageControlBase
    x:Class="BiliCopilot.UI.Controls.Message.ChatSessionBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Message"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollView x:Name="MessageView" Style="{StaticResource PageScrollViewStyle}">
            <!--
                ItemsStackPanel 放在 ScrollView 里的 ItemsControl 中会让部分条目无法测量而显示为空白。
                这里改用 ItemsRepeater + StackLayout：仍由外层 ScrollView 承载滚动，
                但只实例化可见区域附近的条目，避免长会话一次性创建全部消息控件。
            -->
            <Grid
                MaxWidth="800"
                Margin="20,12,20,20">
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:ChatMessageItemViewModel">
                            <local:ChatMessageItemControl
                                Margin="0,4"
                                HorizontalAlignment="Stretch"
                                ViewModel="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                    <ItemsRepeater.Layout>
                        <StackLayout />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </Grid>
        </ScrollView>
        <ProgressRing
            Width="20"
            Height="20"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            AutomationProperties.Name="{ext:Locale Name=LoadingAndWait}"
            IsActive="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoadingOlder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        <base:EmptyHolder
            Description="{ext:Locale Name=NoMessage}"
            Emoji="&#x1F37B;"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        <base:LoadingWidget Text="{ext:Locale Name=LoadingAndWait}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <local:ChatMessageBox
            Grid.Row="1"
            MaxWidth="800"
            Margin="20,12"
            ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
    </Grid>
</local:ChatMessageControlBase>
