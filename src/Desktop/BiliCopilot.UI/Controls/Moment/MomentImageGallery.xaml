<?xml version="1.0" encoding="utf-8" ?>
<base:LayoutUserControlBase
    x:Class="BiliCopilot.UI.Controls.Moment.MomentImageGallery"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:appearance="using:Richasy.BiliKernel.Models.Appearance"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Moment"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ItemsRepeater
            x:Name="ImageRepeater"
            ElementPrepared="OnElementPrepared"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind ItemsSource, Mode=OneWay}">
            <ItemsRepeater.ItemTemplate>
                <DataTemplate x:DataType="appearance:BiliImage">
                    <Button
                        Padding="0"
                        MinWidth="0" MinHeight="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="{x:Bind local:MomentImageGallery.GetImageAutomationId(Uri), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind local:MomentImageGallery.GetImageAutomationName(Uri), Mode=OneTime}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnImageClick"
                        CornerRadius="8"
                        Tag="{x:Bind}">
                        <controls:RecommendationCoverImage
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            CornerRadius="8"
                            ImageOpened="OnImageOpened"
                            Source="{x:Bind SourceUri, Mode=OneTime}" />
                    </Button>
                </DataTemplate>
            </ItemsRepeater.ItemTemplate>
            <ItemsRepeater.Layout>
                <local:MomentImageLayout x:Name="ImageLayout" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>
    </Grid>
</base:LayoutUserControlBase>
