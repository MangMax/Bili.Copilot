<?xml version="1.0" encoding="utf-8"?>
<local:UserSpacePageControlBase
    x:Class="BiliCopilot.UI.Controls.Moment.UserSpacePageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Moment"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid
        SizeChanged="OnHeaderSizeChanged">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState
                    x:Name="Wide" />
                <VisualState
                    x:Name="Compact">
                    <VisualState.Setters>
                        <Setter
                            Target="Statistics.(Grid.Row)"
                            Value="1" />
                        <Setter
                            Target="Statistics.(Grid.Column)"
                            Value="0" />
                        <Setter
                            Target="Statistics.(Grid.ColumnSpan)"
                            Value="3" />
                        <Setter
                            Target="Statistics.Margin"
                            Value="0,16,0,0" />
                        <Setter
                            Target="SpaceBanner.Height"
                            Value="180" />
                        <Setter
                            Target="UserNameText.MaxWidth"
                            Value="220" />
                        <Setter
                            Target="FollowText.Visibility"
                            Value="Collapsed" />
                        <Setter
                            Target="RefreshText.Visibility"
                            Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="Auto" />
            </Grid.RowDefinitions>
            <Grid
                x:Name="SpaceBanner"
                Height="240"
                IsHitTestVisible="False" />
            <Border
                Grid.Row="1"
                Padding="28,0,28,20">
                <Grid
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid
                        Width="112"
                        Height="112"
                        Margin="0,-40,0,0"
                        VerticalAlignment="Top">
                        <Border
                            Padding="4"
                            CornerRadius="56"
                            Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid>
                                <PersonPicture
                                    Width="104"
                                    Height="104"
                                    DisplayName="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                                <controls:RecommendationCoverImage
                                    Width="104"
                                    Height="104"
                                    CornerRadius="52"
                                    Source="{x:Bind ViewModel.Card.Profile.User.Avatar.SourceUri, Mode=OneWay, FallbackValue={x:Null}}"
                                    Visibility="{x:Bind ViewModel.Card, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                        <Image
                            Width="24"
                            Height="24"
                            Margin="0,0,4,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Source="ms-appx:///Assets/vip.png"
                            Visibility="{x:Bind ViewModel.Card.Profile.IsVip, Mode=OneWay, FallbackValue=Collapsed}" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="8"
                        Margin="0,16,0,0"
                        VerticalAlignment="Top">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8">
                            <TextBlock
                                x:Name="UserNameText"
                                MaxWidth="480"
                                Style="{StaticResource TitleTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind ViewModel.UserName, Mode=OneWay}"
                                Text="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                            <Image
                                Height="12"
                                VerticalAlignment="Center"
                                Source="{x:Bind ViewModel.Card.Profile.Level, Mode=OneWay, Converter={StaticResource LevelImageConverter}, FallbackValue={x:Null}}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            TextWrapping="Wrap"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            Text="{x:Bind ViewModel.Card.Profile.Introduce, Mode=OneWay, FallbackValue=''}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Card.Profile.Introduce, Mode=OneWay, FallbackValue=''}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Visibility="{x:Bind ViewModel.Card, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                            <Run Text="UID " /><Run Text="{x:Bind ViewModel.Card.Profile.User.Id, Mode=OneWay, FallbackValue=''}" />
                        </TextBlock>
                    </StackPanel>
                    <Grid
                        x:Name="Statistics"
                        Grid.Column="2"
                        Margin="24,20,0,0"
                        ColumnSpacing="24"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.Card, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Spacing="2"
                            MinWidth="64">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Card.Community.FansCount, Mode=OneWay, Converter={StaticResource CountConverter}, FallbackValue='—'}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{ext:Locale Name=FansCount}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Spacing="2"
                            MinWidth="64">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Card.Community.FollowCount, Mode=OneWay, Converter={StaticResource CountConverter}, FallbackValue='—'}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{ext:Locale Name=FollowCount}" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Spacing="2"
                            MinWidth="64">
                            <TextBlock
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                Text="{x:Bind ViewModel.Card.Community.LikeCount, Mode=OneWay, Converter={StaticResource CountConverter}, FallbackValue='—'}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{ext:Locale Name=LikeCount}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <StackPanel
            Grid.Row="1"
            Margin="24,0"
            Spacing="4">
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsUserInformationLoading, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasUserInformationError, Mode=OneWay}"
                IsClosable="False"
                Severity="Warning"
                Message="{ext:Locale Name=FailedToGetUserInformation}">
                <InfoBar.ActionButton>
                    <Button
                        Content="{ext:Locale Name=Retry}"
                        Command="{x:Bind ViewModel.InitializeUserInformationCommand}"
                        AutomationProperties.AutomationId="RetrySpaceProfile" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>
        <Grid
            Grid.Row="2"
            Padding="24,0"
            MinHeight="52"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <components:SlidingTabBar
                x:Name="Selector"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="SpaceSections"
                Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
            <Grid
                VerticalAlignment="Center"
                ColumnSpacing="8"
                Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center">
                    <Run
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{ext:Locale Name=Search}" />
                    <Run
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind ViewModel.SearchKeyword, Mode=OneWay}" />
                </TextBlock>
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.ExitSearchCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{ext:Locale Name=ExitSearch}"
                    AutomationProperties.Name="{ext:Locale Name=ExitSearch}"
                    AutomationProperties.AutomationId="ExitSpaceSearch">
                    <ic:SymbolIcon
                        FontSize="16"
                        Symbol="Dismiss" />
                </Button>
            </Grid>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <ToggleButton
                    Command="{x:Bind ViewModel.ToggleFollowCommand}"
                    IsChecked="{x:Bind ViewModel.IsFollowed, Mode=OneWay}"
                    AutomationProperties.AutomationId="FollowSpaceUser"
                    AutomationProperties.Name="{x:Bind local:UserSpacePageHeader.GetFollowLabel(ViewModel.IsFollowed), Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind local:UserSpacePageHeader.GetFollowLabel(ViewModel.IsFollowed), Mode=OneWay}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <ic:SymbolIcon
                            FontSize="16"
                            Symbol="Heart"
                            VerticalAlignment="Center"
                            IconVariant="{x:Bind ViewModel.IsFollowed, Mode=OneWay, Converter={StaticResource BoolToIconVariantConverter}}" />
                        <TextBlock
                            x:Name="FollowText"
                            Text="{x:Bind local:UserSpacePageHeader.GetFollowLabel(ViewModel.IsFollowed), Mode=OneWay}" />
                    </StackPanel>
                </ToggleButton>
                <Button
                    Command="{x:Bind ViewModel.PinCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="{ext:Locale Name=FixedContent}"
                    AutomationProperties.Name="{ext:Locale Name=FixedContent}"
                    AutomationProperties.AutomationId="PinSpaceUser">
                    <ic:SymbolIcon
                        FontSize="16"
                        Symbol="Pin" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    AutomationProperties.Name="{ext:Locale Name=Refresh}"
                    ToolTipService.ToolTip="{ext:Locale Name=Refresh}"
                    AutomationProperties.AutomationId="RefreshSpace">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <ic:SymbolIcon
                            FontSize="16"
                            Symbol="ArrowSync"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="RefreshText"
                            Text="{ext:Locale Name=Refresh}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</local:UserSpacePageControlBase>
