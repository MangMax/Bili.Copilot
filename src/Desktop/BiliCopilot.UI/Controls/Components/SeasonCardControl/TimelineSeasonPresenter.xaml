<?xml version="1.0" encoding="utf-8" ?>
<local:SeasonCardPresenter
    x:Class="BiliCopilot.UI.Controls.Components.TimelineSeasonPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <controls:BlurCoverImage
            CornerRadius="{StaticResource ControlCornerRadius}"
            Source="{x:Bind ViewModel.Cover, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}" />
        <StackPanel
            Padding="12,8"
            VerticalAlignment="Bottom"
            Spacing="8">
            <base:TrimTextBlock
                FontWeight="Bold"
                Foreground="White"
                MaxLines="1"
                Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <Border
                HorizontalAlignment="Left"
                Style="{StaticResource CardCoverBadgeStyle}"
                Visibility="{x:Bind ViewModel.IsSubtitleAccent, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <TextBlock
                    Style="{StaticResource CardCoverBadgeTextStyle}"
                    MaxLines="1"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
            </Border>
            <Border
                HorizontalAlignment="Left"
                Style="{StaticResource CardCoverScrimBadgeStyle}"
                Visibility="{x:Bind ViewModel.IsSubtitleScrim, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <TextBlock
                    Style="{StaticResource CardCoverScrimBadgeTextStyle}"
                    MaxLines="1"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}" />
            </Border>
        </StackPanel>
    </Grid>
</local:SeasonCardPresenter>
