<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Components.RefreshResultTipControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    AutomationProperties.AutomationId="RefreshResultTip"
    IsTabStop="False"
    mc:Ignorable="d">

    <InfoBar
        x:Name="Bar"
        IsClosable="False"
        IsIconVisible="True"
        IsOpen="{x:Bind IsOpen, Mode=OneWay}"
        Message="{x:Bind Message, Mode=OneWay}"
        Severity="Informational">
        <InfoBar.ActionButton>
            <HyperlinkButton
                AutomationProperties.AutomationId="UndoRefreshButton"
                Command="{x:Bind UndoCommand, Mode=OneWay}"
                Content="{ext:Locale Name=UndoRefresh}" />
        </InfoBar.ActionButton>
    </InfoBar>
</UserControl>
