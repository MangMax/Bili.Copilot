<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Components.RefreshResultTipControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    IsTabStop="False"
    mc:Ignorable="d">

    <!--
        固定在内容区左下角，与页面里 LoadingWidget 的落点一致：胶囊、亚克力底、1px 描边、24 圆角、20 内边距。
        刷新中与完成态共用这一个容器，所以「正在刷新推荐视频」变成「撤销刷新」时原地变形。
        同一时刻只会有一个提示：刷新期间页面不再显示 LoadingWidget，由这里承担进度。
    -->
    <StackPanel
        Padding="20,12"
        Margin="20,0,0,20"
        HorizontalAlignment="Left"
        VerticalAlignment="Bottom"
        AutomationProperties.AutomationId="RefreshResultTip"
        AutomationProperties.LiveSetting="Polite"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultSolidBrush}"
        BorderThickness="1"
        CornerRadius="24"
        Orientation="Horizontal"
        Spacing="8"
        Visibility="{x:Bind local:RefreshResultTipControl.GetVisibility(State), Mode=OneWay}">

        <Grid x:Name="TipContent" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <!--  刷新中显示进度环，完成后换成撤销图标；两者同尺寸同位置，切换时不跳动。  -->
        <Grid
            Grid.Column="0"
            Width="20"
            Height="20"
            VerticalAlignment="Center">
            <ProgressRing
                Width="20"
                Height="20"
                MinWidth="20"
                MinHeight="20"
                AutomationProperties.AccessibilityView="Raw"
                IsActive="{x:Bind local:RefreshResultTipControl.IsProgressVisible(State), Mode=OneWay}"
                Visibility="{x:Bind local:RefreshResultTipControl.GetProgressVisibility(State), Mode=OneWay}" />
            <ic:SymbolIcon
                Width="16"
                Height="16"
                FontSize="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                AutomationProperties.AccessibilityView="Raw"
                Symbol="ArrowUndo"
                Visibility="{x:Bind local:RefreshResultTipControl.GetUndoIconVisibility(State), Mode=OneWay}" />
        </Grid>

        <!--  LiveSetting 放在 TextBlock 上：它自带自动化对等体，文案变化才能被读屏播报。  -->
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="RefreshResultTipMessage"
            AutomationProperties.LiveSetting="Polite"
            Text="{x:Bind Message, Mode=OneWay}"
            Visibility="{x:Bind local:RefreshResultTipControl.GetMessageVisibility(State), Mode=OneWay}" />

        <!--
            悬停背景要有内边距才不像贴在文字上，但文字位置不能因此偏移：
            用等量负外边距抵消，胶囊内的文字仍与加载文案对齐。
        -->
        <HyperlinkButton
            Grid.Column="2"
            Padding="8,2"
            Margin="-8,-2"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="UndoRefreshButton"
            AutomationProperties.Name="{ext:Locale Name=UndoRefresh}"
            Command="{x:Bind UndoCommand, Mode=OneWay}"
            Content="{ext:Locale Name=UndoRefresh}"
            Visibility="{x:Bind local:RefreshResultTipControl.GetUndoVisibility(State), Mode=OneWay}" />

        <!--  手动关闭：只收起提示，不撤销刷新.  -->
        <Button
            Grid.Column="3"
            Width="28"
            Height="28"
            Padding="0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="DismissRefreshTipButton"
            AutomationProperties.Name="{ext:Locale Name=Close}"
            Background="Transparent"
            BorderThickness="0"
            Command="{x:Bind DismissCommand, Mode=OneWay}"
            Visibility="{x:Bind local:RefreshResultTipControl.GetUndoVisibility(State), Mode=OneWay}">
            <ic:SymbolIcon FontSize="12" Symbol="Dismiss" />
        </Button>
        </Grid>

        <animations:Implicit.ShowAnimations>
            <animations:OpacityAnimation
                From="0"
                To="1"
                Duration="0:0:0.24" />
            <animations:TranslationAnimation
                From="0,20"
                To="0,0"
                Duration="0:0:0.2" />
        </animations:Implicit.ShowAnimations>
        <animations:Implicit.HideAnimations>
            <animations:OpacityAnimation
                From="1"
                To="0"
                Duration="0:0:0.24" />
        </animations:Implicit.HideAnimations>
    </StackPanel>
</UserControl>
