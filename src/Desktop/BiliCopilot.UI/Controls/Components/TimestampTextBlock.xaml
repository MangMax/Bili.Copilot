<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Components.TimestampTextBlock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="4">
        <RichTextBlock
            x:Name="RichBlock"
            IsTextSelectionEnabled="True"
            IsTextTrimmedChanged="OnTextTrimmedChanged"
            LineHeight="28"
            TextTrimming="CharacterEllipsis"
            TextWrapping="Wrap" />
        <Button
            x:Name="ExpansionButton"
            Padding="6,4"
            AutomationProperties.AutomationId="DescriptionExpandButton"
            BorderThickness="0"
            Click="OnExpansionClick"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
