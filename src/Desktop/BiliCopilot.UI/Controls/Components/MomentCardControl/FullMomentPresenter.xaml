<?xml version="1.0" encoding="utf-8" ?>
<local:MomentCardPresenter x:Class="BiliCopilot.UI.Controls.Components.FullMomentPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Components"
    xmlns:moment="using:BiliCopilot.UI.Controls.Moment">
    <StackPanel Padding="22,20" Spacing="12">
        <local:MomentAuthorHeader ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
        <local:EmoteTextBlock MaxLines="5" ExpandInline="True" FontSize="14"
            Text="{x:Bind ViewModel.Description, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.Description, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}" />
        <moment:MomentPresenter ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.NoData, Converter={StaticResource BoolToVisibilityReverseConverter}, Mode=OneWay}" />
        <local:MomentItemOperationPanel Margin="0,4,0,0" ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
    </StackPanel>
</local:MomentCardPresenter>
