<?xml version="1.0" encoding="utf-8" ?>
<local:MomentItemOperationPanelBase x:Class="BiliCopilot.UI.Controls.Components.MomentItemOperationPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:icons="using:BiliCopilot.UI.Icons"
    xmlns:local="using:BiliCopilot.UI.Controls.Components">
    <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="{x:Bind SeparatorPadding, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="16">
            <ToggleButton x:Name="LikeButton" Padding="6,4" MinHeight="28" BorderThickness="0" Background="Transparent"
                AutomationProperties.AutomationId="MomentLike" AutomationProperties.Name="{ext:Locale Name=Like}"
                Command="{x:Bind ViewModel.ToggleLikeCommand, Mode=OneWay}"
                IsChecked="{x:Bind ViewModel.IsLiked, Mode=OneWay}" ToolTipService.ToolTip="{ext:Locale Name=Like}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconThumbLikeFilled}" Width="14" Height="16" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.LikeCount, Mode=OneWay, Converter={StaticResource CountConverter}}" />
                </StackPanel>
            </ToggleButton>
            <Button Padding="6,4" MinHeight="28" BorderThickness="0" Background="Transparent" Style="{StaticResource SubtleButtonStyle}"
                AutomationProperties.AutomationId="MomentComment" AutomationProperties.Name="{ext:Locale Name=Reply}"
                Command="{x:Bind ViewModel.ShowCommentCommand, Mode=OneWay}" ToolTipService.ToolTip="{ext:Locale Name=Reply}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconComment}" Width="14" Height="16" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.CommentCount, Mode=OneWay, Converter={StaticResource CountConverter}}" />
                </StackPanel>
            </Button>
            <Button Padding="6,4" MinHeight="28" BorderThickness="0" Background="Transparent" Style="{StaticResource SubtleButtonStyle}"
                AutomationProperties.AutomationId="MomentFavorite" AutomationProperties.Name="{ext:Locale Name=Favorite}"
                Click="OnFavoriteClick" ToolTipService.ToolTip="{ext:Locale Name=Favorite}"
                Visibility="{x:Bind ViewModel.CanFavorite, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{x:Bind icons:IconGlyph.SelectStar(ViewModel.IsFavorited), Mode=OneWay}" Width="14" Height="16" VerticalAlignment="Center" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind local:MomentItemOperationPanel.FormatFavoriteCount(ViewModel.FavoriteCount), Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Border>
</local:MomentItemOperationPanelBase>
