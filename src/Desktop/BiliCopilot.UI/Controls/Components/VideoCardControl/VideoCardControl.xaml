<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Components">

    <!-- Popular design tokens: outer radius = cover radius + inset. -->
    <CornerRadius x:Key="PopularCoverRadius">4</CornerRadius>
    <CornerRadius x:Key="PopularCardRadius">12</CornerRadius>
    <SolidColorBrush x:Key="PopularMediaForeground" Color="White" />
    <SolidColorBrush x:Key="PopularTagBackground" Color="Black" />
    <!-- Match the content and accent badges in the approved web design. -->
    <SolidColorBrush x:Key="PopularContentBadgeBackground" Color="#CC0C4470" />
    <Style
        x:Key="FeedVideoCardStyle"
        TargetType="local:VideoCardControl">
        <!-- Grid slots may be taller than the content after a column-width change. -->
        <Setter
            Property="VerticalAlignment"
            Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:VideoCardControl">
                    <base:CardControl
                        x:Name="RootCard"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Top"
                        CornerRadius="{StaticResource PopularCardRadius}"
                        AutomationProperties.AutomationId="PopularVideoPlay"
                        AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PopularHoverStates">
                                <VisualState x:Name="PopularNormal">
                                    <VisualState.Setters>
                                        <Setter
                                            Target="PopularAuthorText.Foreground"
                                            Value="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PopularPointerOver">
                                    <VisualState.Setters>
                                        <Setter
                                            Target="PopularAuthorText.Foreground"
                                            Value="{ThemeResource TextFillColorPrimaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <local:PopularVideoCardPanel>
                            <local:VideoMediaPresenter
                                x:Name="VideoMedia"
                                ViewModel="{TemplateBinding ViewModel}" />
                            <Grid
                                Padding="0,10,0,0"
                                RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="46" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}"
                                    MaxLines="2"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    LineHeight="20"
                                    ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}" />
                                <Grid
                                    Grid.Row="1"
                                    ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="UserButton"
                                        Width="40"
                                        Height="40"
                                        Padding="0"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource AvatarButtonStyle}"
                                        IsEnabled="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.CanOpenUserSpace}"
                                        ToolTipService.ToolTip="{ext:Locale Name=EnterUserSpace}"
                                        AutomationProperties.AutomationId="PopularVideoAvatar"
                                        AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.AuthorDisplayName}">
                                        <Grid
                                            Width="40"
                                            Height="40">
                                            <Border
                                                CornerRadius="20"
                                                Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                <TextBlock
                                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.AuthorInitial}"
                                                    FontSize="14.4"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <controls:RecommendationCoverImage
                                                Width="40"
                                                Height="40"
                                                CornerRadius="20"
                                                Source="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Avatar}" />
                                        </Grid>
                                    </Button>
                                    <Grid
                                        Grid.Column="1"
                                        RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20" />
                                            <RowDefinition Height="22" />
                                        </Grid.RowDefinitions>
                                        <controls:InlineTextButton
                                            x:Name="AuthorButton"
                                            IsEnabled="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.CanOpenUserSpace}"
                                            AutomationProperties.AutomationId="PopularVideoAuthor"
                                            AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.AuthorDisplayName}"
                                            ToolTipService.ToolTip="{ext:Locale Name=EnterUserSpace}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Margin="0,0,4,0"
                                                    Padding="5,0"
                                                    Height="18"
                                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.IsFollowing, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock
                                                        Text="{ext:Locale Name=Followed}"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        FontSize="11"
                                                        VerticalAlignment="Center">
                                                        <TextBlock.RenderTransform>
                                                            <TranslateTransform Y="-1" />
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock
                                                    x:Name="PopularAuthorText"
                                                    Grid.Column="1"
                                                    LineHeight="18"
                                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.AuthorDisplayName}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </controls:InlineTextButton>
                                        <Grid
                                            Grid.Row="1"
                                            ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <local:PopularVideoLabelsPanel
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.HasPopularLabels, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border
                                                    Padding="6,0"
                                                    Height="20"
                                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PopularRecommendReason, Converter={StaticResource ObjectToVisibilityConverter}}">
                                                    <TextBlock
                                                        Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PopularRecommendReason}"
                                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                                        FontSize="11"
                                                        TextTrimming="CharacterEllipsis"
                                                        VerticalAlignment="Center"
                                                        ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PopularRecommendReason}">
                                                        <TextBlock.RenderTransform>
                                                            <TranslateTransform Y="-1" />
                                                        </TextBlock.RenderTransform>
                                                    </TextBlock>
                                                </Border>
                                                <Border
                                                    Padding="6,0"
                                                    Height="20"
                                                    CornerRadius="{StaticResource ControlCornerRadius}"
                                                    Background="{StaticResource PopularTagBackground}"
                                                    Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.TagName, Converter={StaticResource ObjectToVisibilityConverter}}">
                                                    <Grid
                                                        ColumnSpacing="3"
                                                        VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition />
                                                        </Grid.ColumnDefinitions>
                                                        <ic:SymbolIcon
                                                            Symbol="Tag"
                                                            FontSize="10"
                                                            Margin="0,1,0,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{StaticResource PopularMediaForeground}"
                                                            AutomationProperties.AccessibilityView="Raw" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.TagName}"
                                                            Foreground="{StaticResource PopularMediaForeground}"
                                                            FontSize="11"
                                                            TextTrimming="CharacterEllipsis"
                                                            VerticalAlignment="Center"
                                                            ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.TagName}" />
                                                    </Grid>
                                                </Border>
                                            </local:PopularVideoLabelsPanel>
                                            <TextBlock
                                                Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PopularDisplayTime}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                LineHeight="18"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.HasPopularLabels, Converter={StaticResource BoolToVisibilityReverseConverter}}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PopularDisplayTime}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                LineHeight="18"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.HasPopularLabels, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Button
                                                x:Name="MoreButton"
                                                Grid.Column="2"
                                                Width="22"
                                                Height="22"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                AutomationProperties.AutomationId="PopularVideoMore"
                                                AutomationProperties.Name="{ext:Locale Name=MoreOptions}"
                                                ToolTipService.ToolTip="{ext:Locale Name=MoreOptions}">
                                                <ic:SymbolIcon
                                                    Symbol="MoreVertical"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </local:PopularVideoCardPanel>
                    </base:CardControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Grid feeds share one template; the view-model style preserves scene-specific commands. -->
    <Style x:Key="HotVideoCardStyle" TargetType="local:VideoCardControl" BasedOn="{StaticResource FeedVideoCardStyle}" />
    <Style x:Key="PopularFeedVideoCardStyle" TargetType="local:VideoCardControl" BasedOn="{StaticResource FeedVideoCardStyle}" />
    <Style x:Key="RecommendVideoCardStyle" TargetType="local:VideoCardControl" BasedOn="{StaticResource FeedVideoCardStyle}" />
    <Style x:Key="RankVideoCardStyle" TargetType="local:VideoCardControl" BasedOn="{StaticResource FeedVideoCardStyle}" />
    <Style x:Key="PartitionVideoCardStyle" TargetType="local:VideoCardControl" BasedOn="{StaticResource FeedVideoCardStyle}" />
    <Style x:Key="SearchVideoCardStyle" TargetType="local:VideoCardControl" BasedOn="{StaticResource FeedVideoCardStyle}" />
    <Style x:Key="ViewLaterVideoCardStyle" TargetType="local:VideoCardControl" BasedOn="{StaticResource FeedVideoCardStyle}" />
    <Style x:Key="FavoriteVideoCardStyle" TargetType="local:VideoCardControl" BasedOn="{StaticResource FeedVideoCardStyle}" />



    <Style x:Key="MomentVideoCardStyle" TargetType="local:VideoCardControl">
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:VideoCardControl">
                    <StackPanel>
                        <Button x:Name="RootCard"
                            Padding="8" Background="Transparent" BorderThickness="0"
                            CornerRadius="{StaticResource PopularCardRadius}"
                            UseSystemFocusVisuals="True"
                            AutomationProperties.AutomationId="MomentVideoPlay"
                            AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.AccessibleTitle}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <ContentPresenter Padding="{TemplateBinding Padding}"
                                        Content="{TemplateBinding Content}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                                </ControlTemplate>
                            </Button.Template>
                            <local:PopularVideoCardPanel>
                                <local:VideoMediaPresenter x:Name="VideoMedia" ViewModel="{TemplateBinding ViewModel}" />
                                <Border MinHeight="{TemplateBinding MinimumTitleHeight}">
                                <TextBlock Margin="0,10,0,0" FontSize="14" FontWeight="Normal" LineHeight="20"
                                    Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title, Converter={StaticResource ObjectToVisibilityConverter}}"
                                    MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}"
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}" />
                                </Border>
                            </local:PopularVideoCardPanel>
                        </Button>
                        <Border Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ShowDescription, Converter={StaticResource BoolToVisibilityConverter}}">
                            <local:EmoteTextBlock Margin="8,0,8,8" FontSize="12" MaxLines="3"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.DescriptionContent}"
                                Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Description, Converter={StaticResource ObjectToVisibilityConverter}}" />
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HistoryVideoCardStyle" TargetType="local:VideoCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:VideoCardControl">
                    <base:CardControl x:Name="RootCard">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="116" />
                            </Grid.RowDefinitions>
                            <controls:BasicCoverImage
                                CornerRadius="4,4,0,0"
                                DecodeWidth="600"
                                Source="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Cover}" />
                            <Grid
                                Grid.Row="1"
                                Padding="16,12,16,16"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text=""
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <Run Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.ProgressText}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Duration}" />
                                </TextBlock>

                                <base:TrimTextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}" />
                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                                        <Run Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.CollectTime}" />
                                        <Run Text="{ext:Locale Name=Play}" />
                                    </TextBlock>
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        ToolTipService.ToolTip="{ext:Locale Name=PlayCount}">
                                        <ic:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
                                            Symbol="PlayCircle" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PlayCount, Converter={StaticResource CountConverter}}"
                                            TextLineBounds="Tight" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </base:CardControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UgcSeasonFavoriteVideoCardStyle" TargetType="local:VideoCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:VideoCardControl">
                    <base:CardControl x:Name="RootCard">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="116" />
                            </Grid.RowDefinitions>
                            <controls:BasicCoverImage
                                CornerRadius="4,4,0,0"
                                DecodeWidth="600"
                                Source="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Cover}" />
                            <Grid
                                Grid.Row="1"
                                Padding="16,12,16,16"
                                RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text=""
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap">
                                    <Run Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.ProgressText}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Duration}" />
                                </TextBlock>
                                <base:TrimTextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}" />
                                <Grid Grid.Row="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PublishRelativeTime}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        ToolTipService.ToolTip="{ext:Locale Name=PlayCount}">
                                        <ic:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
                                            Symbol="PlayCircle" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PlayCount, Converter={StaticResource CountConverter}}"
                                            TextLineBounds="Tight" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </base:CardControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayerRecommendVideoCardStyle" TargetType="local:VideoCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:VideoCardControl">
                    <base:CardControl x:Name="RootCard" Height="104">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="148" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <controls:BasicCoverImage
                                Margin="6"
                                VerticalAlignment="Stretch"
                                CornerRadius="4"
                                DecodeWidth="600"
                                Source="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Cover}" />
                            <Border
                                Margin="8"
                                Padding="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.6" Color="Black" />
                                </Border.Background>
                                <TextBlock
                                    Foreground="White"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Duration}" />
                            </Border>
                            <Grid
                                Grid.Column="1"
                                Padding="12,4,12,8"
                                VerticalAlignment="Stretch"
                                RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:InlineTextButton
                                    AutomationProperties.HelpText="{ext:Locale Name=EnterUserSpace}"
                                    AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Author}"
                                    x:Name="AuthorButton"

                                    ToolTipService.ToolTip="{ext:Locale Name=EnterUserSpace}"
                                    Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Author, Converter={StaticResource ObjectToVisibilityConverter}}">
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Author}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </controls:InlineTextButton>

                                <base:TrimTextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    MaxLines="2"
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}" />
                                <StackPanel
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        ToolTipService.ToolTip="{ext:Locale Name=PlayCount}">
                                        <ic:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
                                            Symbol="PlayCircle" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PlayCount, Converter={StaticResource CountConverter}}"
                                            TextLineBounds="Tight" />
                                    </StackPanel>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        ToolTipService.ToolTip="{ext:Locale Name=DanmakuCount}"
                                        Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.DanmakuCount, Converter={StaticResource ObjectToVisibilityConverter}}">
                                        <ic:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Symbol="TextBulletList" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.DanmakuCount, Converter={StaticResource CountConverter}}"
                                            TextLineBounds="Tight" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </base:CardControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayerSeasonVideoCardStyle" TargetType="local:VideoCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:VideoCardControl">
                    <base:AppToggleCard
                        x:Name="RootCard"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.IsSelected}"
                        IsEnableCheck="False">
                        <Grid Height="86">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <controls:BasicCoverImage
                                Margin="6"
                                VerticalAlignment="Stretch"
                                CornerRadius="4"
                                DecodeWidth="600"
                                Source="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Cover}" />
                            <Border
                                Margin="8"
                                Padding="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                CornerRadius="{StaticResource ControlCornerRadius}">
                                <Border.Background>
                                    <SolidColorBrush Opacity="0.6" Color="Black" />
                                </Border.Background>
                                <TextBlock
                                    Foreground="White"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Duration}" />
                            </Border>
                            <Grid
                                Grid.Column="1"
                                Padding="8,8,12,12"
                                VerticalAlignment="Stretch"
                                RowSpacing="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PublishRelativeTime}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap" />

                                <base:TrimTextBlock
                                    Grid.Row="1"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    MaxLines="2"
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}" />
                                <StackPanel
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    Spacing="12">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        ToolTipService.ToolTip="{ext:Locale Name=PlayCount}">
                                        <ic:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
                                            Symbol="PlayCircle" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.PlayCount, Converter={StaticResource CountConverter}}"
                                            TextLineBounds="Tight" />
                                    </StackPanel>
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="4"
                                        ToolTipService.ToolTip="{ext:Locale Name=DanmakuCount}"
                                        Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.DanmakuCount, Converter={StaticResource ObjectToVisibilityConverter}}">
                                        <ic:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Symbol="TextBulletList" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.DanmakuCount, Converter={StaticResource CountConverter}}"
                                            TextLineBounds="Tight" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </base:AppToggleCard>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlayerPlaylistVideoCardStyle" TargetType="local:VideoCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:VideoCardControl">
                    <base:AppToggleCard
                        x:Name="RootCard"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        IsChecked="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.IsSelected}"
                        IsEnableCheck="False">
                        <Grid Height="98">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <controls:BasicCoverImage
                                Margin="6"
                                VerticalAlignment="Stretch"
                                CornerRadius="4"
                                DecodeWidth="600"
                                Source="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Cover}" />
                            <Border
                                Margin="8"
                                Padding="4"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                CornerRadius="{StaticResource ControlCornerRadius}">
