<?xml version="1.0" encoding="utf-8" ?>
<local:VideoMediaPresenterBase
    x:Class="BiliCopilot.UI.Controls.Components.VideoMediaPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Components">
    <local:CardMediaFrame Cover="{x:Bind ViewModel.Cover, Mode=OneWay, FallbackValue={x:Null}}">
        <local:CardMediaFrame.TopStart>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Border
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Visibility="{x:Bind ViewModel.RankPosition, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <Grid>
                        <TextBlock
                            Text="{x:Bind ViewModel.RankLabel, Mode=OneWay, FallbackValue={x:Null}}"
                            Margin="2,2,0,0"
                            Foreground="#80000000"
                            FontSize="27"
                            LineHeight="27"
                            FontWeight="Bold" />
                        <TextBlock
                            Text="{x:Bind ViewModel.RankLabel, Mode=OneWay, FallbackValue={x:Null}}"
                            Foreground="White"
                            FontSize="27"
                            LineHeight="27"
                            FontWeight="Bold" />
                    </Grid>
                </Border>
                <Border
                    Height="20"
                    Padding="6,0"
                    CornerRadius="4"
                    Background="{StaticResource CardContentBadgeBackground}"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.IsDynamicVideo, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock
                        Text="{ext:Locale Name=DynamicVideo}"
                        FontSize="11"
                        FontWeight="Medium"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource CardMediaForeground}" />
                </Border>
                <Border
                    Height="20"
                    Padding="6,0"
                    CornerRadius="4"
                    Background="{StaticResource CardContentBadgeBackground}"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.IsCollaborativeSubmission, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock
                        Text="{ext:Locale Name=CollaborativeSubmission}"
                        FontSize="11"
                        FontWeight="Medium"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource CardMediaForeground}" />
                </Border>
                <Border
                    Height="20"
                    Padding="6,0"
                    CornerRadius="4"
                    Background="{StaticResource CardContentBadgeBackground}"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.IsChargingExclusive, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock
                        Text="{ext:Locale Name=ChargingExclusive}"
                        FontSize="11"
                        FontWeight="Medium"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource CardMediaForeground}" />
                </Border>
            </StackPanel>
        </local:CardMediaFrame.TopStart>
        <local:CardMediaFrame.TopEnd>
            <Border
                Style="{StaticResource CardCoverBadgeStyle}"
                Visibility="{x:Bind ViewModel.HasPopularRecommendReason, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                <TextBlock
                    Text="{x:Bind ViewModel.PopularRecommendReason, Mode=OneWay, FallbackValue={x:Null}}"
                    Style="{StaticResource CardCoverBadgeTextStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.PopularRecommendReason, Mode=OneWay, FallbackValue={x:Null}}" />
            </Border>
        </local:CardMediaFrame.TopEnd>
        <local:CardMediaFrame.BottomStart>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <local:CardStatControl
                    Text="{x:Bind ViewModel.PlayCount, Converter={StaticResource CountConverter}, Mode=OneWay, FallbackValue={x:Null}}"
                    ToolTipService.ToolTip="{ext:Locale Name=PlayCount}"
                    Visibility="{x:Bind ViewModel.HasPopularPlayCount, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <local:CardStatControl.Icon>
                        <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconPlayCircle}" Width="14" Height="18" VerticalAlignment="Center" FontSize="14" Foreground="#F2FFFFFF" IsHitTestVisible="False" />
                    </local:CardStatControl.Icon>
                </local:CardStatControl>
                <local:CardStatControl
                    Text="{x:Bind ViewModel.DanmakuCount, Converter={StaticResource CountConverter}, Mode=OneWay, FallbackValue={x:Null}}"
                    ToolTipService.ToolTip="{ext:Locale Name=DanmakuCount}"
                    Visibility="{x:Bind ViewModel.HasPopularDanmaku, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <local:CardStatControl.Icon>
                        <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconDanmaku}" Width="14" Height="18" VerticalAlignment="Center" FontSize="14" Foreground="#F2FFFFFF" IsHitTestVisible="False" />
                    </local:CardStatControl.Icon>
                </local:CardStatControl>
                <local:CardStatControl
                    Text="{x:Bind ViewModel.LikeCount, Converter={StaticResource CountConverter}, Mode=OneWay, FallbackValue={x:Null}}"
                    ToolTipService.ToolTip="{ext:Locale Name=LikeCount}"
                    Visibility="{x:Bind ViewModel.HasPopularLikes, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <local:CardStatControl.Icon>
                        <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconThumbLikeFilled}" Width="14" Height="18" VerticalAlignment="Center" FontSize="14" Foreground="#F2FFFFFF" IsHitTestVisible="False" />
                    </local:CardStatControl.Icon>
                </local:CardStatControl>
            </StackPanel>
        </local:CardMediaFrame.BottomStart>
        <local:CardMediaFrame.BottomEnd>
            <TextBlock
                Text="{x:Bind ViewModel.Duration, Mode=OneWay, FallbackValue={x:Null}}"
                FontSize="11.5"
                Foreground="#F2FFFFFF"
                VerticalAlignment="Center" />
        </local:CardMediaFrame.BottomEnd>
    </local:CardMediaFrame>
</local:VideoMediaPresenterBase>
