                    </local:CardStatControl.Icon>
                </local:CardStatControl>
                <local:CardStatControl
                    Text="{x:Bind ViewModel.LikeCount, Converter={StaticResource CountConverter}, Mode=OneWay, FallbackValue={x:Null}}"
                    ToolTipService.ToolTip="{ext:Locale Name=LikeCount}"
                    Visibility="{x:Bind ViewModel.HasPopularLikes, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <local:CardStatControl.Icon>
                        <Path
                            Width="14"
                            Height="18"
                            VerticalAlignment="Center"
                            Stretch="Uniform"
                            Fill="#F2FFFFFF"
                            IsHitTestVisible="False"
                            Data="M9.77234 30.8573V11.7471H7.54573C5.50932 11.7471 3.85742 13.3931 3.85742 15.425V27.1794C3.85742 29.2112 5.50932 30.8573 7.54573 30.8573H9.77234ZM11.9902 30.8573V11.7054C14.9897 10.627 16.6942 7.8853 17.1055 3.33591C17.2666 1.55463 18.9633 0.814421 20.5803 1.59505C22.1847 2.36964 23.243 4.32583 23.243 6.93947C23.243 8.50265 23.0478 10.1054 22.6582 11.7471H29.7324C31.7739 11.7471 33.4289 13.402 33.4289 15.4435C33.4289 15.7416 33.3928 16.0386 33.3215 16.328L30.9883 25.7957C30.2558 28.7683 27.5894 30.8573 24.528 30.8573H11.9911H11.9902Z" />
                    </local:CardStatControl.Icon>
                </local:CardStatControl>
            </StackPanel>
        </local:CardMediaFrame.BottomStart>
        <local:CardMediaFrame.BottomEnd>
            <TextBlock
                Text="{x:Bind ViewModel.Duration, Mode=OneWay, FallbackValue={x:Null}}"
                FontSize="11.5"
                Foreground="#F2FFFFFF"
                VerticalAlignment="Center" />
        </local:CardMediaFrame.BottomEnd>
    </local:CardMediaFrame>
</local:VideoMediaPresenterBase>
