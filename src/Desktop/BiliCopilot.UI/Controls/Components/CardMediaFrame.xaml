<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Components.CardMediaFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    IsTabStop="False">
    <Grid>
        <ContentPresenter Content="{x:Bind Placeholder, Mode=OneWay}" />
        <Border
            x:Name="CoverClip"
            Background="Transparent"
            CornerRadius="{StaticResource CardCoverRadius}">
            <controls:RecommendationCoverImage
                x:Name="CoverImage"
                CornerRadius="{StaticResource CardCoverRadius}"
                ShadeColor="#D106080C"
                Source="{x:Bind Cover, Mode=OneWay, FallbackValue={x:Null}}" />
        </Border>
        <ContentPresenter
            Margin="10,8,10,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Content="{x:Bind TopStart, Mode=OneWay}" />
        <Grid
            Margin="10,0,10,7"
            VerticalAlignment="Bottom"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ContentPresenter
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Content="{x:Bind BottomStart, Mode=OneWay}" />
            <ContentPresenter
                Grid.Column="1"
                VerticalAlignment="Center"
                Content="{x:Bind BottomEnd, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
