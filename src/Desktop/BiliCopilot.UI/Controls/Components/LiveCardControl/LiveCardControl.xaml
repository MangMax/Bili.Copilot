<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Components">

    <!--
        Grid live cards reuse the popular video card frame:
        PopularVideoCardPanel owns the 16:10 cover, the metadata keeps its
        natural height, and labels use the shared CardTagControl.
    -->
    <Style x:Key="LiveGridCardStyle" TargetType="local:LiveCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:LiveCardControl">
                    <base:CardControl
                        x:Name="RootCard"
                        Padding="8"
                        Background="Transparent"
                        BorderThickness="0"
                        VerticalAlignment="Top"
                        CornerRadius="{StaticResource PopularCardRadius}"
                        AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}">
                        <local:PopularVideoCardPanel>
                            <local:LiveMediaPresenter ViewModel="{TemplateBinding ViewModel}" />
                            <Grid
                                Padding="0,10,0,0"
                                RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="46" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}"
                                    MaxLines="2"
                                    TextWrapping="Wrap"
                                    TextTrimming="CharacterEllipsis"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    LineHeight="20"
                                    ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Title}" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <!-- 推荐直播流不返回头像，收起头像槽位让作者与标签占满整行. -->
                                    <Grid
                                        x:Name="AvatarSlot"
                                        Width="40"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.HasAvatar, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button
                                            x:Name="UserButton"
                                            Width="40"
                                            Height="40"
                                            Padding="0"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource AvatarButtonStyle}"
                                            ToolTipService.ToolTip="{ext:Locale Name=EnterUserSpace}"
                                            AutomationProperties.AutomationId="LiveAvatar"
                                            AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Author}">
                                            <Grid
                                                Width="40"
                                                Height="40">
                                                <Border
                                                    CornerRadius="20"
                                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock
                                                        Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.AuthorInitial}"
                                                        FontSize="14.4"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Border>
                                                <controls:RecommendationCoverImage
                                                    Width="40"
                                                    Height="40"
                                                    CornerRadius="20"
                                                    Source="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Avatar}" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <Grid
                                        Grid.Column="1"
                                        RowSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="20" />
                                            <RowDefinition Height="22" />
                                        </Grid.RowDefinitions>
                                        <controls:InlineTextButton
                                            x:Name="AuthorButton"
                                            AutomationProperties.AutomationId="LiveAuthor"
                                            AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Author}"
                                            ToolTipService.ToolTip="{ext:Locale Name=EnterUserSpace}">
                                            <TextBlock
                                                LineHeight="18"
                                                Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Author}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                TextTrimming="CharacterEllipsis" />
                                        </controls:InlineTextButton>
                                        <Grid
                                            Grid.Row="1"
                                            ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <local:PopularVideoLabelsPanel
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                                <local:CardTagControl
                                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Subtitle}"
                                                    ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.Subtitle}"
                                                    Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.HasSubtitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <local:CardTagControl
                                                    Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.TagName}"
                                                    ToolTipService.ToolTip="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.TagName}"
                                                    Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.HasTagName, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </local:PopularVideoLabelsPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.CollectRelativeTime}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                LineHeight="18"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding RelativeSource={RelativeSource Mode=TemplatedParent}, Path=ViewModel.HasCollectTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <Button
                                                x:Name="MoreButton"
                                                Grid.Column="2"
                                                Width="22"
                                                Height="22"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                AutomationProperties.AutomationId="LiveMore"
                                                AutomationProperties.Name="{ext:Locale Name=MoreOptions}"
                                                ToolTipService.ToolTip="{ext:Locale Name=MoreOptions}">
                                                <ic:SymbolIcon
                                                    Symbol="MoreVertical"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </local:PopularVideoCardPanel>
                    </base:CardControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RecommendLiveCardStyle"
        BasedOn="{StaticResource LiveGridCardStyle}"
        TargetType="local:LiveCardControl" />

    <Style
        x:Key="SearchLiveCardStyle"
        BasedOn="{StaticResource LiveGridCardStyle}"
        TargetType="local:LiveCardControl" />

    <Style
        x:Key="PartitionLiveCardStyle"
        BasedOn="{StaticResource LiveGridCardStyle}"
        TargetType="local:LiveCardControl" />

    <Style
        x:Key="HistoryLiveCardStyle"
        BasedOn="{StaticResource LiveGridCardStyle}"
        TargetType="local:LiveCardControl" />

    <Style x:Key="FollowLiveCardStyle" TargetType="local:LiveCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:LiveCardControl">
                    <base:CardControl x:Name="RootCard">
                        <local:FollowLivePresenter ViewModel="{TemplateBinding ViewModel}" />
                    </base:CardControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
