<?xml version="1.0" encoding="utf-8" ?>
<local:UpdateButtonBase
    x:Class="BiliCopilot.UI.Controls.Components.UpdateButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BiliCopilot.UI.Controls.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <FlyoutBase.AttachedFlyout>
        <Flyout Placement="Bottom">
            <StackPanel
                MaxWidth="360"
                Spacing="8"
                PointerEntered="OnInfoPointerEntered"
                PointerExited="OnInfoPointerExited">
                <TextBlock
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <ScrollViewer
                    MaxHeight="220"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind ViewModel.CanShowReleaseNotes, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ReleaseNotes, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Flyout>
    </FlyoutBase.AttachedFlyout>

    <Grid
        Margin="0,0,8,0"
        VerticalAlignment="Center"
        Background="Transparent"
        PointerEntered="OnButtonPointerEntered"
        PointerExited="OnButtonPointerExited"
        Visibility="{x:Bind ViewModel.IsButtonVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
        <Button
            x:Name="ActionButton"
            MinHeight="28"
            Padding="8,0"
            AutomationProperties.AutomationId="UpdatePrimaryAction"
            AutomationProperties.Name="{x:Bind ViewModel.MainActionText, Mode=OneWay}"
            Background="Transparent"
            BorderThickness="0"
            Click="OnActionClick"
            Command="{x:Bind ViewModel.MainActionCommand}"
            CornerRadius="14">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Grid
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center">
                    <FontIcon
                        FontFamily="{StaticResource BiliIconsFontFamily}"
                        FontSize="14"
                        Glyph="{x:Bind ViewModel.IconSymbol, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                    <ProgressRing
                        Width="16"
                        Height="16"
                        IsActive="{x:Bind ViewModel.IsDownloading, Mode=OneWay}"
                        IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                        Maximum="100"
                        Minimum="0"
                        Value="{x:Bind ViewModel.DisplayDownloadProgress, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsDownloading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.MainActionText, Mode=OneWay}" />
            </StackPanel>
        </Button>
    </Grid>
</local:UpdateButtonBase>
