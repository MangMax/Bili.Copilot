<?xml version="1.0" encoding="utf-8" ?>
<local:HeaderAccountControlBase
    x:Class="BiliCopilot.UI.Controls.Components.HeaderAccountControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ProgressRing
            x:Name="LoadingRing"
            Width="20"
            Height="20"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsInitializing, Mode=OneWay}" />
        <Button Style="{StaticResource AvatarButtonStyle}">
            <controls:BasicCoverImage
                x:Name="Avatar"
                Width="28"
                Height="28"
                x:Load="{x:Bind ViewModel.IsInitializing, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                CornerRadius="14"
                DecodeWidth="56"
                Source="{x:Bind ViewModel.MyProfile.User.Avatar.Uri, Mode=OneWay, FallbackValue={x:Null}}"
                Visibility="{x:Bind ViewModel.MyProfile, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}" />
            <Button.Flyout>
                <MenuFlyout
                    Closed="OnFlyoutClosed"
                    Opened="OnFlyoutOpened"
                    Placement="Bottom">
                    <MenuFlyoutItem>
                        <MenuFlyoutItem.Template>
                            <ControlTemplate>
                                <local:AccountCard Width="300" />
                            </ControlTemplate>
                        </MenuFlyoutItem.Template>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.ShowMomentsCommand}"
                        KeyboardAcceleratorTextOverride="{x:Bind ViewModel.MomentCount, Mode=OneWay, Converter={StaticResource CountConverter}}"
                        Text="{ext:Locale Name=MyDynamic}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconDesignIdeas}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.ShowFollowsCommand}"
                        KeyboardAcceleratorTextOverride="{x:Bind ViewModel.FollowCount, Mode=OneWay, Converter={StaticResource CountConverter}}"
                        Text="{ext:Locale Name=MyFollow}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconPeopleEye}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem
                        Command="{x:Bind ViewModel.ShowFansCommand}"
                        KeyboardAcceleratorTextOverride="{x:Bind ViewModel.FansCount, Mode=OneWay, Converter={StaticResource CountConverter}}"
                        Text="{ext:Locale Name=MyFans}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconPeopleCommunity}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind ViewModel.OpenPersonalWebsiteCommand}" Text="{ext:Locale Name=Personal}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconPerson}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.ShowFavoritesCommand}" Text="{ext:Locale Name=MyFavorite}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconStarLineHorizontal3}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.ShowViewLaterCommand}" Text="{ext:Locale Name=ViewLater}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconCalendarClock}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind ViewModel.ShowHistoryCommand}" Text="{ext:Locale Name=ViewHistory}">
                        <MenuFlyoutItem.Icon>
                            <FontIcon FontFamily="{StaticResource BiliIconsFontFamily}" Glyph="{StaticResource IconHistory}" />
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.Flyout>
        </Button>
    </Grid>
</local:HeaderAccountControlBase>
