<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Components.CardMetaPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <Grid RowSpacing="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>
        <ContentPresenter
            Grid.RowSpan="2"
            VerticalAlignment="Center"
            Content="{x:Bind Avatar, Mode=OneWay}" />
        <ContentPresenter
            Grid.Column="1"
            VerticalAlignment="Center"
            Content="{x:Bind Author, Mode=OneWay}" />
        <Grid
            Grid.Row="1"
            Grid.Column="1">
            <ContentPresenter
                x:Name="MetaPresenter"
                Content="{x:Bind Meta, Mode=OneWay}" />
            <Grid
                x:Name="DefaultMetaRow"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="{x:Bind Badges, Mode=OneWay}" />
                <ContentPresenter
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{x:Bind Info, Mode=OneWay}" />
                <ContentPresenter
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="{x:Bind Actions, Mode=OneWay}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
