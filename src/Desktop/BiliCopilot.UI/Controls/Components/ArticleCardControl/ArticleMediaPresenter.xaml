<?xml version="1.0" encoding="utf-8" ?>
<local:ArticleMediaPresenterBase
    x:Class="BiliCopilot.UI.Controls.Components.ArticleMediaPresenter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:BiliCopilot.UI.Controls.Components">
    <local:CardMediaFrame Cover="{x:Bind ViewModel.Cover, Mode=OneWay, FallbackValue={x:Null}}">
        <local:CardMediaFrame.Placeholder>
            <Border
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="{StaticResource CardCoverRadius}"
                Visibility="{x:Bind ViewModel.HasCover, Converter={StaticResource BoolToVisibilityReverseConverter}, Mode=OneWay, FallbackValue=Visible}">
                <ic:SymbolIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="28"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Symbol="Book" />
            </Border>
        </local:CardMediaFrame.Placeholder>
        <local:CardMediaFrame.TopStart>
            <Border
                Background="{StaticResource CardContentBadgeBackground}"
                Style="{StaticResource CardTagBorderStyle}">
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ic:SymbolIcon
                        Symbol="Book"
                        FontSize="10"
                        Foreground="{StaticResource CardMediaForeground}" />
                    <TextBlock
                        Style="{StaticResource CardTagTextStyle}"
                        Text="{ext:Locale Name=Article}" />
                </StackPanel>
            </Border>
        </local:CardMediaFrame.TopStart>
        <local:CardMediaFrame.BottomStart>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <local:CardStatControl
                    Text="{x:Bind ViewModel.ViewCount, Converter={StaticResource CountConverter}, Mode=OneWay, FallbackValue={x:Null}}"
                    ToolTipService.ToolTip="{ext:Locale Name=ReadCount}"
                    Visibility="{x:Bind ViewModel.HasViewCount, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <local:CardStatControl.Icon>
                        <ic:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#F2FFFFFF"
                            Symbol="Eye" />
                    </local:CardStatControl.Icon>
                </local:CardStatControl>
                <local:CardStatControl
                    Text="{x:Bind ViewModel.ReplyCount, Converter={StaticResource CountConverter}, Mode=OneWay, FallbackValue={x:Null}}"
                    ToolTipService.ToolTip="{ext:Locale Name=ReplyCount}"
                    Visibility="{x:Bind ViewModel.HasReplyCount, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <local:CardStatControl.Icon>
                        <ic:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#F2FFFFFF"
                            Symbol="Comment" />
                    </local:CardStatControl.Icon>
                </local:CardStatControl>
                <local:CardStatControl
                    Text="{x:Bind ViewModel.LikeCount, Converter={StaticResource CountConverter}, Mode=OneWay, FallbackValue={x:Null}}"
                    ToolTipService.ToolTip="{ext:Locale Name=LikeCount}"
                    Visibility="{x:Bind ViewModel.HasLikeCount, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay, FallbackValue=Collapsed}">
                    <local:CardStatControl.Icon>
                        <ic:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#F2FFFFFF"
                            Symbol="ThumbLike" />
                    </local:CardStatControl.Icon>
                </local:CardStatControl>
            </StackPanel>
        </local:CardMediaFrame.BottomStart>
    </local:CardMediaFrame>
</local:ArticleMediaPresenterBase>
