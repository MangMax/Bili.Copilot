<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="BiliCopilot.UI.Controls.Components.FavoriteFolderDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:repeater="using:Richasy.WinUIKernel.Share.Base.Repeater"
    Title="{ext:Locale Name=Favorite}"
    CloseButtonText="{ext:Locale Name=Cancel}"
    DefaultButton="Primary"
    PrimaryButtonText="{ext:Locale Name=Confirm}"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">

    <Grid
        Width="360"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{ext:Locale Name=FavoriteTip}"
            TextWrapping="Wrap" />
        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            AutomationProperties.AutomationId="FavoriteFolderSearch"
            AutomationProperties.Name="{ext:Locale Name=SearchFavoriteFolder}"
            PlaceholderText="{ext:Locale Name=SearchFavoriteFolder}"
            Text="{x:Bind ViewModel.FavoriteSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Grid Grid.Row="2" MinHeight="220">
            <ScrollView MaxHeight="320" Style="{StaticResource PageScrollViewStyle}">
                <repeater:AppRepeater ItemsSource="{x:Bind ViewModel.FilteredFavoriteFolders, Mode=OneWay}">
                    <repeater:AppRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:PlayerFavoriteFolderViewModel">
                            <ToggleButton
                                Padding="16,12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="{x:Bind Data.Id, Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind Data.Title, Mode=OneTime}"
                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        MaxLines="1"
                                        Text="{x:Bind Data.Title, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Data.TotalCount, Mode=OneTime}"
                                        ToolTipService.ToolTip="{ext:Locale Name=Total}" />
                                </Grid>
                            </ToggleButton>
                        </DataTemplate>
                    </repeater:AppRepeater.ItemTemplate>
                    <repeater:AppRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </repeater:AppRepeater.Layout>
                </repeater:AppRepeater>
            </ScrollView>
            <ProgressRing
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoadingFavorites, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsLoadingFavorites, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{ext:Locale Name=NoMatchFavoriteFolder}"
                Visibility="{x:Bind ViewModel.HasNoFavoriteFolderResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
            <base:EmptyHolder
                Description="{ext:Locale Name=FavoriteFoldersLoadFailed}"
                Visibility="{x:Bind ViewModel.IsFavoriteFoldersLoadFailed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <base:EmptyHolder.ActionElement>
                    <HyperlinkButton
                        AutomationProperties.AutomationId="FavoriteFolderRetry"
                        Command="{x:Bind ViewModel.InitializeFavoritesCommand, Mode=OneWay}"
                        Content="{ext:Locale Name=Retry}" />
                </base:EmptyHolder.ActionElement>
            </base:EmptyHolder>
        </Grid>
    </Grid>
</ContentDialog>
