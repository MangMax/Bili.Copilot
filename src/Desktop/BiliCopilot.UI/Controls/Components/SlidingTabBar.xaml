<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Components.SlidingTabBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="SlidingTabHoverForeground" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="SlidingTabPressedForeground" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="SlidingTabFill" ResourceKey="ControlFillColorSecondaryBrush" />
                    <StaticResource x:Key="SlidingTabStroke" ResourceKey="ControlStrokeColorSecondaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="SlidingTabHoverForeground" ResourceKey="AccentTextFillColorPrimaryBrush" />
                    <StaticResource x:Key="SlidingTabPressedForeground" ResourceKey="TextFillColorSecondaryBrush" />
                    <StaticResource x:Key="SlidingTabFill" ResourceKey="ControlFillColorSecondaryBrush" />
                    <StaticResource x:Key="SlidingTabStroke" ResourceKey="ControlStrokeColorSecondaryBrush" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <!-- An outlined selection keeps the platform's hover/disabled text legible. -->
                    <SolidColorBrush x:Key="SlidingTabFill" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="SlidingTabStroke" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SlidingTabHoverForeground" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="SlidingTabPressedForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Keep item interaction feedback in the foreground so it cannot cover the moving indicator. -->
            <Thickness x:Key="SelectorBarPadding">0</Thickness>
            <Thickness x:Key="SelectorBarItemFocusVisualMargin">0</Thickness>
            <Style TargetType="SelectorBarItem">
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Padding" Value="14,4" />
                <Setter Property="MinWidth" Value="56" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="SelectorBarItem">
                            <Grid x:Name="PART_ContainerRoot" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CombinedStates">
                                        <VisualState x:Name="UnselectedNormal" />
                                        <VisualState x:Name="UnselectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SlidingTabHoverForeground}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SlidingTabHoverForeground}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="UnselectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SlidingTabPressedForeground}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SlidingTabPressedForeground}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedNormal">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="SelectedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource SlidingTabPressedForeground}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource SlidingTabPressedForeground}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                    <VisualStateGroup x:Name="DisabledStates">
                                        <VisualState x:Name="Enabled" />
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="PART_TextVisual.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                                <Setter Target="PART_IconVisual.Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Spacing="{ThemeResource SelectorBarItemSpacing}">
                                    <ContentPresenter x:Name="PART_IconVisual" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding Foreground}" />
                                    <TextBlock x:Name="PART_TextVisual" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" />
                                </StackPanel>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border
        Padding="4"
        Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <ScrollViewer
            AutomationProperties.AutomationId="SlidingTabScroller"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled"
            IsTabStop="False"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
            <Grid x:Name="Track" HorizontalAlignment="Left">
                <Canvas IsHitTestVisible="False">
                    <Border
                        x:Name="Indicator"
                        Background="{ThemeResource SlidingTabFill}"
                        BorderBrush="{ThemeResource SlidingTabStroke}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="IndicatorTranslation" />
                        </Border.RenderTransform>
                    </Border>
                </Canvas>
                <SelectorBar x:Name="Selector" AutomationProperties.AutomationId="SlidingTabSelector" />
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
