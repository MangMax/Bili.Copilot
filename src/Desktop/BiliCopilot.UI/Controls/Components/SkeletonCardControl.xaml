<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Components.SkeletonCardControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="238"
    d:DesignWidth="232"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="116" />
        </Grid.RowDefinitions>
        <Border
            Margin="1"
            VerticalAlignment="Stretch"
            Background="{ThemeResource ControlFillColorSecondaryBrush}"
            CornerRadius="4,4,2,2" />
        <Grid Grid.Row="1" Margin="10,8,10,10" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border
                Height="14"
                Background="{ThemeResource ControlFillColorSecondaryBrush}"
                CornerRadius="3" />
            <Border
                Grid.Row="1"
                Width="96"
                Height="12"
                HorizontalAlignment="Left"
                Background="{ThemeResource ControlFillColorTertiaryBrush}"
                CornerRadius="3" />
        </Grid>
    </Grid>
</UserControl>
