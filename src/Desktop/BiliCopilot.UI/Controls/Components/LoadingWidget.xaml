<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="BiliCopilot.UI.Controls.Components.LoadingWidget"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BiliCopilot.UI.Controls.Components"
    IsHitTestVisible="False"
    IsTabStop="False">

    <StackPanel Spacing="8">
        <ProgressRing
            Width="32"
            Height="32"
            HorizontalAlignment="Center"
            IsActive="{x:Bind local:LoadingWidget.IsVisible(Visibility), Mode=OneWay}" />
        <Border
            HorizontalAlignment="Center"
            Style="{x:Bind TextBorderStyle, Mode=OneWay}">
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                Foreground="{x:Bind Foreground, Mode=OneWay}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{x:Bind Text, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
