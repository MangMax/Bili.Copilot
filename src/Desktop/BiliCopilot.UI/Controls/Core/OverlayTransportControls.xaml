<?xml version="1.0" encoding="utf-8"?>
<local:PlayerControlBase
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:danmaku="using:BiliCopilot.UI.Controls.Danmaku"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:triggers="using:CommunityToolkit.WinUI"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    x:Class="BiliCopilot.UI.Controls.Core.OverlayTransportControls"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="PlayerSettingsPresenter"
            TargetType="FlyoutPresenter"
            BasedOn="{StaticResource DefaultFlyoutPresenterStyle}">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="local:PlayerFlyoutMotion.MoveDuration" Value="{StaticResource ControlFastAnimationDuration}" />
            <Setter Property="local:PlayerFlyoutMotion.FadeDuration" Value="{StaticResource ControlFasterAnimationDuration}" />
            <Setter Property="local:PlayerFlyoutMotion.Origin" Value="Bottom" />
        </Style>
        <Style
            x:Key="PlayerMenuPresenter"
            TargetType="MenuFlyoutPresenter"
            BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="SystemBackdrop" Value="{x:Null}" />
            <Setter Property="local:PlayerFlyoutMotion.MoveDuration" Value="{StaticResource ControlFastAnimationDuration}" />
            <Setter Property="local:PlayerFlyoutMotion.FadeDuration" Value="{StaticResource ControlFasterAnimationDuration}" />
            <Setter Property="local:PlayerFlyoutMotion.Origin" Value="Bottom" />
        </Style>
        <Style
            x:Key="PortraitSettingsPresenter"
            TargetType="FlyoutPresenter"
            BasedOn="{StaticResource PlayerSettingsPresenter}">
            <Setter Property="local:PlayerFlyoutMotion.Origin" Value="Right" />
        </Style>
        <Style
            x:Key="PortraitMenuPresenter"
            TargetType="MenuFlyoutPresenter"
            BasedOn="{StaticResource PlayerMenuPresenter}">
            <Setter Property="local:PlayerFlyoutMotion.Origin" Value="Right" />
        </Style>
    </UserControl.Resources>
    <Grid
        x:Name="RootGrid"
        Height="160"
        HorizontalAlignment="Stretch"
        SizeChanged="OnSizeChanged"
        LayoutUpdated="OnLayoutUpdated"
        VerticalAlignment="Bottom">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState" />
                <VisualState x:Name="BelowWideState">
                    <VisualState.Setters>
                        <Setter Target="FullVolumeContainer.Visibility" Value="Collapsed" />
                        <Setter Target="SlimVolumeButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.Setters>
                        <Setter Target="LeftPresenter.Visibility" Value="Collapsed" />
                        <Setter Target="LeftColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.Setters>
                        <Setter Target="FullVolumeContainer.Visibility" Value="Collapsed" />
                        <Setter Target="SlimVolumeButton.Visibility" Value="Visible" />
                        <Setter Target="BackwardButton.Visibility" Value="Collapsed" />
                        <Setter Target="ForwardButton.Visibility" Value="Visible" />
                        <Setter Target="PrevButton.Visibility" Value="Collapsed" />
                        <Setter Target="NextButton.Visibility" Value="Visible" />
                        <Setter Target="DanmakuToggleButton.Visibility" Value="Collapsed" />
                        <Setter Target="DanmakuOptionButton.Visibility" Value="Collapsed" />
                        <Setter Target="LeftPresenter.Visibility" Value="Collapsed" />
                        <Setter Target="CompactOverlayButton.Visibility" Value="Collapsed" />
                        <Setter Target="FullScreenButton.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        <Setter Target="LeftColumn.Width" Value="Auto" />
                        <Setter Target="RootGrid.Height" Value="120" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLandscapeState">
                    <VisualState.Setters>
                        <Setter Target="FullVolumeContainer.Visibility" Value="Collapsed" />
                        <Setter Target="SlimVolumeButton.Visibility" Value="Visible" />
                        <Setter Target="BackwardButton.Visibility" Value="Collapsed" />
                        <Setter Target="ForwardButton.Visibility" Value="Visible" />
                        <Setter Target="PrevButton.Visibility" Value="Collapsed" />
                        <Setter Target="NextButton.Visibility" Value="Visible" />
                        <Setter Target="DanmakuToggleButton.Visibility" Value="Collapsed" />
                        <Setter Target="DanmakuOptionButton.Visibility" Value="Collapsed" />
                        <Setter Target="LeftPresenter.Visibility" Value="Collapsed" />
                        <Setter Target="CompactOverlayButton.Visibility" Value="Collapsed" />
                        <Setter Target="FullScreenButton.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        <Setter Target="LeftColumn.Width" Value="Auto" />
                        <Setter Target="RootGrid.Height" Value="120" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactPortraitState">
                    <VisualState.Setters>
                        <Setter Target="RootGrid.Height" Value="Auto" />
                        <Setter Target="RootGrid.VerticalAlignment" Value="Stretch" />
                        <Setter Target="ControlsBackdrop.Height" Value="160" />
                        <Setter Target="ControlsBackdrop.VerticalAlignment" Value="Bottom" />
                        <Setter Target="ControlsGrid.Padding" Value="0" />
                        <Setter Target="LeftPresenter.Visibility" Value="Collapsed" />
                        <Setter Target="LeftColumn.Width" Value="*" />
                        <Setter Target="RightColumn.Width" Value="Auto" />
                        <Setter Target="TransportHost.(Grid.Row)" Value="1" />
                        <Setter Target="TransportHost.(Grid.Column)" Value="0" />
                        <Setter Target="TransportHost.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="TransportHost.HorizontalAlignment" Value="Center" />
                        <Setter Target="TransportHost.Margin" Value="0,8,0,16" />
                        <Setter Target="AccessoriesHost.VerticalAlignment" Value="Bottom" />
                        <Setter Target="AccessoriesHost.Margin" Value="0,0,8,0" />
                        <Setter Target="CompactRefreshHost.Margin" Value="0" />
                        <Setter Target="AccessoriesHost.VerticalScrollMode" Value="Auto" />
                        <Setter Target="AccessoriesHost.VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Target="RightPanel.Orientation" Value="Vertical" />
                        <Setter Target="RightPanel.Spacing" Value="4" />
                        <Setter Target="RightPanel.Margin" Value="0" />
                        <Setter Target="FullVolumeContainer.Visibility" Value="Collapsed" />
                        <Setter Target="SlimVolumeButton.Visibility" Value="Visible" />
                        <Setter Target="DanmakuOptionButton.Visibility" Value="Collapsed" />
                        <Setter Target="CompactOverlayButton.Visibility" Value="Collapsed" />
                        <Setter Target="FullScreenButton.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        <Setter Target="ProgressPanel.Margin" Value="12,0,12,12" />
                        <Setter Target="AccessoriesEnter.From" Value="60,0,0" />
                        <Setter Target="AccessoriesExit.To" Value="60,0,0" />
                        <Setter Target="VolumeContent.Width" Value="64" />
                        <Setter Target="VolumeHeader.Visibility" Value="Collapsed" />
                        <Setter Target="PortraitVolumeTitle.Visibility" Value="Visible" />
                        <Setter Target="PortraitMuteButton.Visibility" Value="Visible" />
                        <Setter Target="VolumeSlider.Orientation" Value="Vertical" />
                        <Setter Target="VolumeSlider.Height" Value="140" />
                        <Setter Target="VolumeSlider.Width" Value="32" />
                        <Setter Target="VolumeSlider.HorizontalAlignment" Value="Center" />
                        <Setter Target="SpeedContent.Width" Value="114" />
                        <Setter Target="SpeedContent.RowSpacing" Value="0" />
                        <Setter Target="SpeedPresets.Width" Value="74" />
                        <Setter Target="SpeedPresets.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SpeedSlider.(Grid.Column)" Value="1" />
                        <Setter Target="SpeedSlider.(Grid.Row)" Value="0" />
                        <Setter Target="SpeedSlider.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="SpeedSlider.Orientation" Value="Vertical" />
                        <Setter Target="SpeedSlider.Height" Value="222" />
                        <Setter Target="SpeedSlider.Width" Value="32" />
                        <Setter Target="SpeedSlider.Margin" Value="0" />
                        <Setter Target="SpeedSlider.VerticalAlignment" Value="Stretch" />
                        <Setter Target="HalfSpeedButton.(Grid.Row)" Value="0" />
                        <Setter Target="HalfSpeedButton.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedColumn0.Width" Value="*" />
                        <Setter Target="DefaultSpeedButton.(Grid.Row)" Value="1" />
                        <Setter Target="DefaultSpeedButton.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedColumn1.Width" Value="0" />
                        <Setter Target="OneTwoFiveSpeedButton.(Grid.Row)" Value="2" />
                        <Setter Target="OneTwoFiveSpeedButton.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedColumn2.Width" Value="0" />
                        <Setter Target="OneHalfSpeedButton.(Grid.Row)" Value="3" />
                        <Setter Target="OneHalfSpeedButton.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedColumn3.Width" Value="0" />
                        <Setter Target="DoubleSpeedButton.(Grid.Row)" Value="4" />
                        <Setter Target="DoubleSpeedButton.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedColumn4.Width" Value="0" />
                        <Setter Target="TripleSpeedButton.(Grid.Row)" Value="5" />
                        <Setter Target="TripleSpeedButton.(Grid.Column)" Value="0" />
                        <Setter Target="SpeedColumn5.Width" Value="0" />
                        <Setter Target="ChapterListButton.Margin" Value="0" />
                        <Setter Target="SlimVolumeButton.Margin" Value="0" />
                        <Setter Target="SpeedButton.Margin" Value="0" />
                        <Setter Target="SubtitleButton.Margin" Value="0" />
                        <Setter Target="OverflowButton.Margin" Value="0" />
                        <Setter Target="DanmakuToggleButton.Margin" Value="0" />
                        <Setter Target="ChapterFlyout.Placement" Value="Left" />
                        <Setter Target="ChapterFlyout.ShouldConstrainToRootBounds" Value="True" />
                        <Setter Target="VolumeFlyout.Placement" Value="Left" />
                        <Setter Target="VolumeFlyout.ShouldConstrainToRootBounds" Value="True" />
                        <Setter Target="SpeedFlyout.Placement" Value="Left" />
                        <Setter Target="SpeedFlyout.ShouldConstrainToRootBounds" Value="True" />
                        <Setter Target="SubtitleFlyout.Placement" Value="Left" />
                        <Setter Target="SubtitleFlyout.ShouldConstrainToRootBounds" Value="True" />
                        <Setter Target="OverflowFlyout.Placement" Value="Left" />
                        <Setter Target="OverflowFlyout.ShouldConstrainToRootBounds" Value="True" />
                        <Setter Target="ChapterFlyout.FlyoutPresenterStyle" Value="{StaticResource PortraitSettingsPresenter}" />
                        <Setter Target="VolumeFlyout.FlyoutPresenterStyle" Value="{StaticResource PortraitSettingsPresenter}" />
                        <Setter Target="SpeedFlyout.FlyoutPresenterStyle" Value="{StaticResource PortraitSettingsPresenter}" />
                        <Setter Target="SubtitleFlyout.FlyoutPresenterStyle" Value="{StaticResource PortraitSettingsPresenter}" />
                        <Setter Target="OverflowFlyout.MenuFlyoutPresenterStyle" Value="{StaticResource PortraitMenuPresenter}" />
                        <Setter Target="SpeedPresets.ColumnSpacing" Value="0" />
                        <Setter Target="SpeedPresets.RowSpacing" Value="4" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Border
            x:Name="ControlsBackdrop"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Grid.RowSpan="2"
            Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay}">
            <animations:Implicit.HideAnimations>
                <animations:OpacityAnimation
                    From="1"
                    To="0"
                    Duration="0:0:0.2" />
                <animations:TranslationAnimation
                    From="0,0,0"
                    To="0,80,0"
                    Duration="0:0:0.25" />
            </animations:Implicit.HideAnimations>
            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation
                    From="0"
                    To="1"
                    Duration="0:0:0.2" />
                <animations:TranslationAnimation
                    From="0,80,0"
                    To="0,0,0"
                    Duration="0:0:0.25" />
            </animations:Implicit.ShowAnimations>
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <LinearGradientBrush.GradientStops>
                        <GradientStop Offset="0.0" Color="#00000000" />
                        <GradientStop Offset="1" Color="#FF000000" />
                    </LinearGradientBrush.GradientStops>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid Padding="16,0,8,0" x:Name="ControlsGrid">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" />
                <ColumnDefinition x:Name="MiddleColumn" Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" />
            </Grid.ColumnDefinitions>
            <!--  左侧自定义元素  -->
            <Grid
                x:Name="LeftHolderGrid"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
            <Grid x:Name="InformationHost" Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay}">
                <animations:Implicit.HideAnimations>
                    <animations:OpacityAnimation
                        From="1"
                        To="0"
                        Duration="0:0:0.2" />
                    <animations:TranslationAnimation
                        From="0,0,0"
                        To="0,80,0"
                        Duration="0:0:0.25" />
                </animations:Implicit.HideAnimations>
                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation
                        From="0"
                        To="1"
                        Duration="0:0:0.2" />
                    <animations:TranslationAnimation
                        From="0,80,0"
                        To="0,0,0"
                        Duration="0:0:0.25" />
                </animations:Implicit.ShowAnimations>
                <ContentPresenter
                    x:Name="LeftPresenter"
                    Height="80"
                    Margin="0,0,24,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{x:Bind LeftElement, Mode=OneWay}"
                    Visibility="Visible" />
            </Grid>
            <!--  核心播放控制  -->
            <UserControl
                Grid.Column="1"
                VerticalAlignment="Center"
                IsEnabled="{x:Bind ViewModel.Player.IsLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}, FallbackValue=False}"
                x:Name="TransportHost"
                Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay}">
                <animations:Implicit.HideAnimations>
                    <animations:OpacityAnimation
                        From="1"
                        To="0"
                        Duration="0:0:0.2" />
                    <animations:TranslationAnimation
                        From="0,0,0"
                        To="0,80,0"
                        Duration="0:0:0.25" />
                </animations:Implicit.HideAnimations>
                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation
                        From="0"
                        To="1"
                        Duration="0:0:0.2" />
                    <animations:TranslationAnimation
                        From="0,80,0"
                        To="0,0,0"
                        Duration="0:0:0.25" />
                </animations:Implicit.ShowAnimations>
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="PrevButton"
                        Margin="0,0,8,0"
                        Command="{x:Bind ViewModel.PlayPreviousCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsPrevButtonEnabled, Mode=OneWay}"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PrevButtonToolTip, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsVideoNavigationAvailable, Mode=OneWay}">
                        <ic:SymbolIcon
                            FontSize="16"
                            IconVariant="Filled"
                            Symbol="Previous" />
                    </Button>
                    <Button
                        x:Name="BackwardButton"
                        Margin="0,0,8,0"
                        Command="{x:Bind ViewModel.SkipBackwardCommand, Mode=OneWay}"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.BackwardTip, Mode=OneWay}"
                        Visibility="{x:Bind IsSkipButtonsVisible, Mode=OneWay}">
                        <ic:SymbolIcon
                            FontSize="16"
                            IconVariant="Filled"
                            Symbol="ArrowStepBack" />
                    </Button>
                    <Grid>
                        <Button
                            x:Name="PlayPauseButton"
                            Click="OnPlayPauseButtonClick"
                            IsEnabled="{x:Bind IsPlayPauseEnabled(ViewModel.Player.PlaybackState), Mode=OneWay}"
                            Style="{StaticResource PrimaryPlayerButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind GetPlayPauseTip(ViewModel.Player.IsPlaying), Mode=OneWay}">
                            <ic:SymbolIcon
                                FontSize="22"
                                IconVariant="Filled"
                                Symbol="{x:Bind GetPlayPauseSymbol(ViewModel.Player.PlaybackState), Mode=OneWay}" />
                        </Button>
                        <ProgressRing
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderThickness="4"
                            IsActive="{x:Bind IsLoading(ViewModel.Player.PlaybackState, ViewModel.Player.IsLoading), Mode=OneWay}" />
                    </Grid>
                    <Button
                        x:Name="ForwardButton"
                        Margin="8,0,0,0"
                        Command="{x:Bind ViewModel.SkipForwardCommand, Mode=OneWay}"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ForwardTip, Mode=OneWay}"
                        Visibility="{x:Bind IsSkipButtonsVisible, Mode=OneWay}">
                        <ic:SymbolIcon
                            FontSize="16"
                            IconVariant="Filled"
                            Symbol="ArrowStepOver" />
                    </Button>
                    <Button
                        x:Name="NextButton"
                        Margin="8,0,0,0"
                        Command="{x:Bind ViewModel.PlayNextCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsNextButtonEnabled, Mode=OneWay}"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NextButtonToolTip, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsVideoNavigationAvailable, Mode=OneWay}">
                        <ic:SymbolIcon
                            FontSize="16"
                            IconVariant="Filled"
                            Symbol="Next" />
                    </Button>
                </StackPanel>
            </UserControl>
            <!--  右侧附加控制  -->
            <ScrollViewer
                x:Name="AccessoriesHost"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Grid.Column="2"
                Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay}">
                <animations:Implicit.HideAnimations>
                    <animations:OpacityAnimation
                        From="1"
                        To="0"
                        Duration="0:0:0.2" />
                    <animations:TranslationAnimation
                        From="0,0,0"
                        To="0,80,0"
                        Duration="0:0:0.25"
                        x:Name="AccessoriesExit" />
                </animations:Implicit.HideAnimations>
                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation
                        From="0"
                        To="1"
                        Duration="0:0:0.2" />
                    <animations:TranslationAnimation
                        From="0,80,0"
                        To="0,0,0"
                        Duration="0:0:0.25"
                        x:Name="AccessoriesEnter" />
                </animations:Implicit.ShowAnimations>
                <StackPanel
                    x:Name="RightPanel"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    SizeChanged="OnRightPanelSizeChanged">
                    <Grid
                        x:Name="CompactRefreshHost"
                        Margin="0,0,8,0"
                        Visibility="{x:Bind ViewModel.Player.IsCompactOverlay, Mode=OneWay, FallbackValue=Collapsed}">
                        <Button
                            Style="{StaticResource BasicPlayerIconButtonStyle}"
                            AutomationProperties.AutomationId="CompactRefreshPlaybackButton"
                            AutomationProperties.Name="{ext:Locale Name=RefreshPlayback}"
                            Command="{x:Bind ViewModel.RefreshPlaybackCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="{ext:Locale Name=RefreshPlayback}"
                            Visibility="{x:Bind ViewModel.IsPlaybackRefreshAvailable, Mode=OneWay}">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>
                    </Grid>
                    <Button
                        x:Name="ChapterListButton"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ChapterListButton"
                        AutomationProperties.Name="{ext:Locale Name=ChapterList}"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ChapterListToolTip, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsChapterListAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Flyout>
                            <Flyout
                                Placement="Top"
                                x:Name="ChapterFlyout"
                                Opened="OnDisplayFlyoutOpened"
                                Closed="OnFlyoutClosed"
                                AreOpenCloseAnimationsEnabled="False"
                                ShouldConstrainToRootBounds="True"
                                FlyoutPresenterStyle="{StaticResource PlayerSettingsPresenter}">
                                <ScrollViewer
                                    x:Name="ChapterPopup"
                                    HorizontalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel
                                        Spacing="8"
                                        x:Name="ChapterContent"
                                        Width="260">
                                        <TextBlock
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{ext:Locale Name=ChapterList}" />
                                        <ScrollViewer MaxHeight="344">
                                            <ItemsControl ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="items:ChapterItemViewModel">
                                                        <Button
                                                            Margin="0,0,0,4"
                                                            Padding="12,8"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                                            Command="{x:Bind SelectCommand, Mode=OneWay}"
                                                            CornerRadius="{StaticResource ControlCornerRadius}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <!--  当前章节仅用字重与颜色强调，不加播放图标  -->
                                                                <TextBlock
                                                                    VerticalAlignment="Center"
                                                                    FontWeight="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource ChapterFontWeightConverter}}"
                                                                    Foreground="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource ChapterForegroundConverter}}"
                                                                    Style="{StaticResource BodyTextBlockStyle}"
                                                                    Text="{x:Bind Title, Mode=OneWay}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Grid.Column="1"
                                                                    Margin="12,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                                    Text="{x:Bind Position, Mode=OneWay, Converter={StaticResource PlayerPositionConverter}}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                        <ic:SymbolIcon
                            FontSize="14"
                            RequestedTheme="Dark"
                            Symbol="List" />
                    </Button>
                    <StackPanel
                        x:Name="FullVolumeContainer"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            Width="32"
                            Height="32"
                            Command="{x:Bind ViewModel.ToggleMuteStateCommand, Mode=OneWay}"
                            CornerRadius="16"
                            Style="{StaticResource BasicPlayerIconButtonStyle}">
                            <Grid>
                                <ic:SymbolIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    RequestedTheme="Dark"
                                    Symbol="Speaker2"
                                    ToolTipService.ToolTip="{ext:Locale Name=CurrentVolume}"
                                    Visibility="{x:Bind ViewModel.IsMute, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                                <ic:SymbolIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    RequestedTheme="Dark"
                                    Symbol="SpeakerMute"
                                    ToolTipService.ToolTip="{ext:Locale Name=Mute}"
                                    Visibility="{x:Bind ViewModel.IsMute, Mode=OneWay}" />
                            </Grid>
                        </Button>
                        <Slider
                            Width="80"
                            VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.IsMute, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                            LargeChange="10"
                            Maximum="{x:Bind ViewModel.MaxVolume, Mode=OneWay}"
                            Minimum="0"
                            SmallChange="1"
                            TickFrequency="1"
                            ValueChanged="OnVolumeValueChanged"
                            Value="{x:Bind ViewModel.Player.Volume, Mode=OneWay, FallbackValue=0}" />
                    </StackPanel>
                    <Button
                        x:Name="SlimVolumeButton"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{ext:Locale Name=CurrentVolume}"
