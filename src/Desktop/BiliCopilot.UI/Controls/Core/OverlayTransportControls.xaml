<?xml version="1.0" encoding="utf-8" ?>
<local:PlayerControlBase
    x:Class="BiliCopilot.UI.Controls.Core.OverlayTransportControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:danmaku="using:BiliCopilot.UI.Controls.Danmaku"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:triggers="using:CommunityToolkit.WinUI"
    IsHitTestVisible="False"
    Opacity="0"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Height="160"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Bottom"
        SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!--
            底部控制带的渐变遮罩：根 Grid 在竖屏轨道状态下会撑满播放区，
            渐变若留在根上会盖住整块视频，因此单独挂在控制带这一层。
            遮罩同时承担“控制带内的空白处不再穿透到播放手势”的命中职责，
            竖屏轨道由 RailScrim 承担同样的职责.
        -->
        <Border x:Name="BandBackdrop" Grid.RowSpan="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0.0" Color="#00000000" />
                    <GradientStop Offset="1.0" Color="#FF000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!--
            控制区容器：普通窗口与横屏小窗是底部控制带，竖屏小窗是右侧纵向轨道（见 PortraitState）。
            轨道高度不足时由这个 ScrollViewer 纵向滚动，保证所有操作都能到达；
            非轨道状态下滚动被禁用，测量仍受窗口高度约束，底部带的布局与改动前一致.
        -->
        <ScrollViewer
            x:Name="ControlsScroller"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            PointerWheelChanged="OnControlsWheel"
            VerticalContentAlignment="Stretch"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled">
        <Grid x:Name="ControlsGrid" Padding="16,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" />
                <ColumnDefinition x:Name="MiddleColumn" Width="Auto" />
                <ColumnDefinition x:Name="RightColumn" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TransportRow" Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!--  竖屏轨道背景：列宽由轨道内容决定，因此渐变正好铺满轨道宽度  -->
            <Border
                x:Name="RailScrim"
                Grid.RowSpan="2"
                Grid.Column="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Visibility="Collapsed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0.0" Color="#00000000" />
                        <GradientStop Offset="0.6" Color="#66000000" />
                        <GradientStop Offset="1.0" Color="#D9000000" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <!--  左侧自定义元素  -->
            <Grid
                x:Name="LeftHolderGrid"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
            <ContentPresenter
                x:Name="LeftPresenter"
                Height="80"
                Margin="0,0,24,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{x:Bind LeftElement, Mode=OneWay}"
                Visibility="Visible" />

            <!--  核心播放控制  -->
            <UserControl
                x:Name="TransportHost"
                Grid.Column="1"
                VerticalAlignment="Center"
                IsEnabled="{x:Bind ViewModel.Player.IsLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}, FallbackValue=False}">
                <StackPanel
                    x:Name="TransportPanel"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="PrevButton"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.PlayPreviousCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsPrevButtonEnabled, Mode=OneWay}"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.PrevButtonToolTip, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsVideoNavigationAvailable, Mode=OneWay}">
                        <ic:SymbolIcon
                            FontSize="16"
                            IconVariant="Filled"
                            Symbol="Previous" />
                    </Button>
                    <Button
                        x:Name="BackwardButton"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.SkipBackwardCommand, Mode=OneWay}"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.BackwardTip, Mode=OneWay}"
                        Visibility="{x:Bind IsSkipButtonsVisible, Mode=OneWay}">
                        <ic:SymbolIcon
                            FontSize="16"
                            IconVariant="Filled"
                            Symbol="ArrowStepBack" />
                    </Button>
                    <Grid>
                        <Button
                            x:Name="PlayPauseButton"
                            Click="OnPlayPauseButtonClick"
                            IsEnabled="{x:Bind IsPlayPauseEnabled(ViewModel.Player.PlaybackState), Mode=OneWay}"
                            Style="{StaticResource PrimaryPlayerButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind GetPlayPauseTip(ViewModel.Player.IsPlaying), Mode=OneWay}">
                            <ic:SymbolIcon
                                FontSize="22"
                                IconVariant="Filled"
                                Symbol="{x:Bind GetPlayPauseSymbol(ViewModel.Player.PlaybackState), Mode=OneWay}" />
                        </Button>
                        <ProgressRing
                            Width="52"
                            Height="52"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderThickness="4"
                            IsActive="{x:Bind IsLoading(ViewModel.Player.PlaybackState, ViewModel.Player.IsLoading), Mode=OneWay}" />
                    </Grid>
                    <Button
                        x:Name="ForwardButton"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.SkipForwardCommand, Mode=OneWay}"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ForwardTip, Mode=OneWay}"
                        Visibility="{x:Bind IsSkipButtonsVisible, Mode=OneWay}">
                        <ic:SymbolIcon
                            FontSize="16"
                            IconVariant="Filled"
                            Symbol="ArrowStepOver" />
                    </Button>
                    <Button
                        x:Name="NextButton"
                        HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.PlayNextCommand, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsNextButtonEnabled, Mode=OneWay}"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.NextButtonToolTip, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsVideoNavigationAvailable, Mode=OneWay}">
                        <ic:SymbolIcon
                            FontSize="16"
                            IconVariant="Filled"
                            Symbol="Next" />
                    </Button>
                </StackPanel>
            </UserControl>

            <!--  右侧附加控制  -->
            <StackPanel
                x:Name="RightPanel"
                Grid.Column="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                SizeChanged="OnRightPanelSizeChanged"
                Spacing="8">
                <Button
                    x:Name="ChapterListButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="ChapterListButton"
                    AutomationProperties.Name="{ext:Locale Name=ChapterList}"
                    Style="{StaticResource BasicPlayerIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ChapterListToolTip, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsChapterListAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ic:SymbolIcon
                        FontSize="14"
                        RequestedTheme="Dark"
                        Symbol="List" />
                    <Button.Flyout>
                        <Flyout
                            Closed="OnFlyoutClosed"
                            Opened="OnDisplayFlyoutOpened"
                            Placement="Top">
                            <Grid x:Name="ChapterFlyoutPanel" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{ext:Locale Name=ChapterList}" />
                                <ScrollViewer
                                    x:Name="ChapterListScroller"
                                    Grid.Row="1"
                                    HorizontalScrollMode="Disabled"
                                    MaxHeight="344"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.Chapters, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="items:ChapterItemViewModel">
                                                <Button
                                                    Margin="0,0,0,4"
                                                    Padding="12,8"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                                    Command="{x:Bind SelectCommand, Mode=OneWay}"
                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <!--  当前章节仅用字重与颜色强调，不加播放图标  -->
                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            FontWeight="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource ChapterFontWeightConverter}}"
                                                            Foreground="{x:Bind IsPlaying, Mode=OneWay, Converter={StaticResource ChapterForegroundConverter}}"
                                                            Style="{StaticResource BodyTextBlockStyle}"
                                                            Text="{x:Bind Title, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            Margin="12,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Style="{StaticResource CaptionTextBlockStyle}"
                                                            Text="{x:Bind Position, Mode=OneWay, Converter={StaticResource PlayerPositionConverter}}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <StackPanel
                    x:Name="FullVolumeContainer"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <Button
                        Width="32"
                        Height="32"
                        Command="{x:Bind ViewModel.ToggleMuteStateCommand, Mode=OneWay}"
                        CornerRadius="16"
                        Style="{StaticResource BasicPlayerIconButtonStyle}">
                        <Grid>
                            <ic:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                RequestedTheme="Dark"
                                Symbol="Speaker2"
                                ToolTipService.ToolTip="{ext:Locale Name=CurrentVolume}"
                                Visibility="{x:Bind ViewModel.IsMute, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                            <ic:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                RequestedTheme="Dark"
                                Symbol="SpeakerMute"
                                ToolTipService.ToolTip="{ext:Locale Name=Mute}"
                                Visibility="{x:Bind ViewModel.IsMute, Mode=OneWay}" />
                        </Grid>
                    </Button>
                    <Slider
                        Width="80"
                        VerticalAlignment="Center"
                        IsEnabled="{x:Bind ViewModel.IsMute, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                        LargeChange="10"
                        Maximum="{x:Bind ViewModel.MaxVolume, Mode=OneWay}"
                        Minimum="0"
                        SmallChange="1"
                        TickFrequency="1"
                        ValueChanged="OnVolumeValueChanged"
                        Value="{x:Bind ViewModel.Player.Volume, Mode=OneWay, FallbackValue=0}" />
                </StackPanel>
                <Button
                    x:Name="SlimVolumeButton"
                    VerticalAlignment="Center"
                    Style="{StaticResource BasicPlayerIconButtonStyle}"
                    ToolTipService.ToolTip="{ext:Locale Name=CurrentVolume}"
                    Visibility="Collapsed">
                    <Grid>
                        <ic:SymbolIcon
                            FontSize="14"
                            Symbol="Speaker2"
                            Visibility="{x:Bind ViewModel.IsMute, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                        <ic:SymbolIcon
                            FontSize="14"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Symbol="SpeakerMute"
                            Visibility="{x:Bind ViewModel.IsMute, Mode=OneWay}" />
                    </Grid>

                    <Button.Flyout>
                        <Flyout
                            Closed="OnFlyoutClosed"
                            Opened="OnDisplayFlyoutOpened"
                            Placement="Top">
                            <ScrollViewer
                                x:Name="VolumeFlyoutScroller"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="VolumeFlyoutPanel" Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{ext:Locale Name=CurrentVolume}" />
                                    <HyperlinkButton
                                        Grid.Column="1"
                                        Padding="4,2"
                                        VerticalAlignment="Center"
                                        Command="{x:Bind ViewModel.ToggleMuteStateCommand, Mode=OneWay}">
                                        <Grid>
                                            <TextBlock
                                                FontSize="12"
                                                Text="{ext:Locale Name=Mute}"
                                                Visibility="{x:Bind ViewModel.IsMute, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                                            <TextBlock
                                                FontSize="12"
                                                Text="{ext:Locale Name=Unmute}"
                                                Visibility="{x:Bind ViewModel.IsMute, Mode=OneWay}" />
                                        </Grid>
                                    </HyperlinkButton>
                                </Grid>
                                <Slider
                                    x:Name="VolumeSlider"
                                    VerticalAlignment="Center"
                                    IsEnabled="{x:Bind ViewModel.IsMute, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                                    LargeChange="10"
                                    Maximum="{x:Bind ViewModel.MaxVolume, Mode=OneWay}"
                                    Minimum="0"
                                    SmallChange="1"
                                    TickFrequency="1"
                                    ValueChanged="OnVolumeValueChanged"
                                    Value="{x:Bind ViewModel.Player.Volume, Mode=OneWay, FallbackValue=0}" />
                            </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="SpeedButton"
                    VerticalAlignment="Center"
                    Style="{StaticResource BasicPlayerIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind GetSpeedText(ViewModel.Player.PlaybackRate), Mode=OneWay}">
                    <ic:SymbolIcon FontSize="14" Symbol="TopSpeed" />
                    <Button.Flyout>
                        <Flyout
                            Closed="OnFlyoutClosed"
                            Opened="OnDisplayFlyoutOpened"
                            Placement="Top">
                            <ScrollViewer
                                x:Name="SpeedFlyoutScroller"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SpeedFlyoutPanel" Spacing="12">
                                <!--
                                    底部带保持原来的六列横排；竖屏轨道由代码把同一组按钮重排成一列纵排，
                                    不是把原横向面板整体缩窄。滑块在竖屏也改为纵向。
                                -->
                                <Border
                                    MinHeight="28"
                                    Padding="4,0,4,4"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                    <Grid
                                        x:Name="SpeedQuickGrid"
                                        ColumnSpacing="2"
                                        RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ToggleButton
                                            x:Name="HalfSpeedButton"
                                            Grid.Column="0"
                                            MinWidth="0"
                                            Height="28"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="0.5x"
                                            Tag="0.5" />
                                        <ToggleButton
                                            x:Name="DefaultSpeedButton"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            Height="28"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="1.0x"
                                            Tag="1.0" />
                                        <ToggleButton
                                            x:Name="OneTwoFiveSpeedButton"
                                            Grid.Column="2"
                                            MinWidth="0"
                                            Height="28"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="1.25x"
                                            Tag="1.25" />
                                        <ToggleButton
                                            x:Name="OneHalfSpeedButton"
                                            Grid.Column="3"
                                            MinWidth="0"
                                            Height="28"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="1.5x"
                                            Tag="1.5" />
                                        <ToggleButton
                                            x:Name="DoubleSpeedButton"
                                            Grid.Column="4"
                                            MinWidth="0"
                                            Height="28"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="2.0x"
                                            Tag="2.0" />
                                        <ToggleButton
                                            x:Name="TripleSpeedButton"
                                            Grid.Column="5"
                                            MinWidth="0"
                                            Height="28"
                                            Padding="8,0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnQuickSpeedButtonClick"
                                            Content="3.0x"
                                            Tag="3.0" />
                                    </Grid>
                                </Border>
                                <Slider
                                    x:Name="SpeedSlider"
                                    MinWidth="0"
                                    Margin="0,0,0,-6"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    LargeChange="0.5"
                                    Maximum="3"
                                    Minimum="0.1"
                                    SmallChange="0.05"
                                    StepFrequency="0.05"
                                    ValueChanged="OnSpeedValueChanged"
                                    Value="{x:Bind ViewModel.Player.PlaybackRate, Mode=OneWay, FallbackValue=1}" />
                            </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="SubtitleButton"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SubtitleButton"
                    AutomationProperties.Name="{ext:Locale Name=Subtitle}"
                    Style="{StaticResource BasicPlayerIconButtonStyle}"
                    ToolTipService.ToolTip="{ext:Locale Name=Subtitle}"
                    Visibility="{x:Bind ViewModel.IsSubtitleEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                    <Grid>
                        <!--  字幕开关打开时用主题色点亮图标，关闭时回到默认前景色  -->
                        <ic:SymbolIcon
                            FontSize="14"
                            Symbol="Subtitles"
                            Visibility="{x:Bind ViewModel.IsSubtitleEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                        <ic:SymbolIcon
                            FontSize="14"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            IconVariant="Filled"
                            Symbol="Subtitles"
                            Visibility="{x:Bind ViewModel.IsSubtitleEnabled, Mode=OneWay}" />
                    </Grid>
                    <Button.Flyout>
                        <Flyout
                            Closed="OnSubtitleFlyoutClosed"
                            Opened="OnSubtitleFlyoutOpened"
                            ShouldConstrainToRootBounds="False">
                            <Flyout.FlyoutPresenterStyle>
                                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>

                            <!--
                                字幕菜单在同一弹出层内分两级：第一层是字幕总开关与当前视频的字幕轨列表，
                                第二层承载位置、字号、字体、延迟等参数；返回只切换层级，不关闭菜单。
                                入口的可见性只取决于当前视频是否有字幕，不受开关状态影响。
                            -->
                            <!--
                                整个字幕弹层放进一个滚动容器：内容高度由实际窗口约束，
                                窄窗口里各层设置都能滚动到，不再依赖固定 MaxHeight 被外层裁掉。
                            -->
                            <ScrollViewer
                                x:Name="SubtitleFlyoutScroller"
                                HorizontalScrollBarVisibility="Disabled"
                                HorizontalScrollMode="Disabled"
                                VerticalScrollBarVisibility="Auto">
                            <Grid x:Name="SubtitleFlyoutPanel">
                                <!--  第一层：字幕总开关 + 字幕轨列表  -->
                                <Grid Visibility="{x:Bind ViewModel.IsSubtitleParameterVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!--  标题与参数页入口左右排布：标题在左，设置入口贴右  -->
                                    <Grid
                                        Margin="16,8,8,8"
                                        ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{ext:Locale Name=Subtitle}" />
                                        <HyperlinkButton
                                            x:Name="SubtitleParameterEntryButton"
                                            Grid.Column="1"
                                            MinWidth="0"
                                            Margin="0,0,4,0"
                                            Padding="8,4"
                                            VerticalAlignment="Center"
                                            AutomationProperties.AutomationId="SubtitleParameterEntryButton"
                                            AutomationProperties.Name="{ext:Locale Name=Settings}"
                                            Click="OnSubtitleParameterEntryClick"
                                            Content="{ext:Locale Name=Settings}"
                                            FontSize="12" />
                                    </Grid>
                                    <StackPanel
                                        Grid.Row="1"
                                        Margin="16,0,16,8"
                                        Spacing="4">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{ext:Locale Name=SubtitleEnabled}" />
                                            <ToggleSwitch
                                                Grid.Column="1"
                                                MinWidth="0"
                                                MinHeight="0"
                                                Margin="0"
                                                Padding="0"
                                                VerticalAlignment="Center"
                                                AutomationProperties.AutomationId="SubtitleEnabledSwitch"
                                                AutomationProperties.Name="{ext:Locale Name=SubtitleEnabled}"
                                                IsOn="{x:Bind ViewModel.IsSubtitleEnabled, Mode=TwoWay}"
                                                OffContent=""
                                                OnContent="" />
                                        </Grid>
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{ext:Locale Name=SubtitleEnabledDescription}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid
                                        Grid.Row="2"
                                        Margin="0,0,0,12"
                                        Padding="16,0"
                                        RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{ext:Locale Name=SubtitleList}" />
                                            <ItemsRepeater
                                                x:Name="SubtitleRepeater"
                                                Grid.Row="1"
                                                ItemsSource="{x:Bind ViewModel.Subtitles, Mode=OneWay}">
                                                <ItemsRepeater.ItemTemplate>
                                                    <DataTemplate x:DataType="items:SubtitleItemViewModel">
                                                        <base:AppToggleCard
                                                            MaxWidth="280"
                                                            HorizontalAlignment="Stretch"
                                                            AutomationProperties.AutomationId="{x:Bind Data.Id, Mode=OneWay}"
                                                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                                            BorderBrush="Transparent"
                                                            BorderThickness="2"
                                                            Command="{x:Bind ActiveCommand, Mode=OneWay}"
                                                            IsChecked="{x:Bind IsSelected, Mode=OneWay}"
                                                            IsEnableCheck="False">
                                                            <StackPanel>
                                                                <base:TrimTextBlock MaxLines="1" Text="{x:Bind Name, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </base:AppToggleCard>
                                                    </DataTemplate>
                                                </ItemsRepeater.ItemTemplate>
                                                <ItemsRepeater.Layout>
                                                    <StackLayout Spacing="8" />
                                                </ItemsRepeater.Layout>
                                            </ItemsRepeater>
                                        </Grid>
                                </Grid>

                                <!--  第二层：字幕参数  -->
                                <Grid Visibility="{x:Bind ViewModel.IsSubtitleParameterVisible, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="8,8,8,0" ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="SubtitleParameterBackButton"
                                            AutomationProperties.AutomationId="SubtitleParameterBackButton"
                                            Width="32"
                                            Height="32"
                                            Padding="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{ext:Locale Name=Back}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="OnSubtitleParameterBackClick"
                                            CornerRadius="{StaticResource ControlCornerRadius}"
                                            ToolTipService.ToolTip="{ext:Locale Name=Back}">
                                            <ic:SymbolIcon FontSize="12" Symbol="ChevronLeft" />
                                        </Button>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{ext:Locale Name=SubtitleSetting}" />
                                    </Grid>
                                    <StackPanel
                                        Grid.Row="1"
                                        Padding="16,8,16,12"
                                        Spacing="8">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{ext:Locale Name=SubtitlePosition}" />
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <Grid>
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{ext:Locale Name=HorizontalScreen}"
                                                            TextLineBounds="Tight"
                                                            Visibility="{x:Bind ViewModel.IsVerticalScreen, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                            Text="{ext:Locale Name=VerticalScreen}"
                                                            TextLineBounds="Tight"
                                                            Visibility="{x:Bind ViewModel.IsVerticalScreen, Mode=OneWay}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <base:TrimTextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="2"
                                                Text="{ext:Locale Name=SubtitlePositionTip}" />
                                            <Slider
                                                x:Name="SubtitlePositionSlider"
                                                AutomationProperties.AutomationId="SubtitlePositionSlider"
                                                Margin="0,-8,0,0"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{ext:Locale Name=SubtitlePosition}"
                                                Maximum="150"
                                                Minimum="0"
                                                ValueChanged="OnSubtitlePositionChanged"
                                                Value="{x:Bind ViewModel.SubtitlePosition, Mode=OneWay}" />
                                            <Border
                                                Width="200"
                                                Height="2"
                                                Margin="0,4"
                                                HorizontalAlignment="Center"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                                CornerRadius="2" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Text="{ext:Locale Name=SubtitleFontSize}"
                                                    ToolTipService.ToolTip="{ext:Locale Name=SubtitleFontSizeDescription}" />
                                                <Border
                                                    Grid.Column="1"
                                                    Padding="4"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                    BorderThickness="2"
                                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind ViewModel.SubtitleFontSize, Mode=OneWay}"
                                                        TextLineBounds="Tight" />
                                                </Border>
                                            </Grid>
                                            <Slider
                                                x:Name="SubtitleFontSizeSlider"
                                                AutomationProperties.AutomationId="SubtitleFontSizeSlider"
                                                Margin="0,-8,0,0"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{ext:Locale Name=SubtitleFontSize}"
                                                Maximum="150"
                                                Minimum="1"
                                                ValueChanged="OnSubtitleFontSizeChanged"
                                                Value="{x:Bind ViewModel.SubtitleFontSize, Mode=OneWay}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{ext:Locale Name=SubtitleFontFamily}"
                                                ToolTipService.ToolTip="{ext:Locale Name=SubtitleFontFamilyDescription}" />
                                            <ComboBox
                                                x:Name="SubtitleFontComboBox"
                                                AutomationProperties.AutomationId="SubtitleFontComboBox"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{ext:Locale Name=SubtitleFontFamily}"
                                                ItemsSource="{x:Bind ViewModel.Fonts, Mode=OneWay}"
                                                Loaded="OnSubtitleFontComboLoaded"
                                                SelectionChanged="OnSubtitleFontChanged"
                                                SelectionChangedTrigger="Committed" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{ext:Locale Name=SubtitleDelaySeconds}"
                                                ToolTipService.ToolTip="{ext:Locale Name=SubtitleDelaySecondsDescription}" />
                                            <NumberBox
                                                x:Name="SubtitleDelayNumberBox"
                                                AutomationProperties.AutomationId="SubtitleDelayNumberBox"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.Name="{ext:Locale Name=SubtitleDelaySeconds}"
                                                Maximum="99"
                                                Minimum="-99"
                                                SpinButtonPlacementMode="Inline"
                                                ValueChanged="OnSubtitleDelayChanged"
                                                Value="{x:Bind ViewModel.SubtitleDelaySeconds, Mode=OneWay}" />
                                        </StackPanel>
                                </Grid>
                            </Grid>
                            </ScrollViewer>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <!--  横排时两个弹幕按钮的间距由原来的 8px 外边距 + 6px Spacing 折算为 14；竖屏轨道改为 4  -->
                <StackPanel
                    x:Name="DanmakuGroup"
                    Orientation="Horizontal"
                    Spacing="14"
                    Visibility="{x:Bind ViewModel.IsDanmakuControlVisible, Mode=OneWay}">
                    <ToggleButton
                        x:Name="DanmakuToggleButton"
                        AutomationProperties.Name="{ext:Locale Name=DanmakuSwitch}"
                        Content="弹"
                        FontSize="12"
                        FontWeight="Black"
                        IsChecked="{x:Bind ViewModel.Danmaku.IsShowDanmaku, Mode=TwoWay, FallbackValue=False}"
                        IsEnabled="{x:Bind ViewModel.IsDanmakuLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                        Style="{StaticResource TogglePlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{ext:Locale Name=DanmakuSwitch}" />
                    <Button
                        x:Name="DanmakuOptionButton"
                        AutomationProperties.Name="{ext:Locale Name=DanmakuDisplaySettings}"
                        IsEnabled="{x:Bind ViewModel.IsDanmakuLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{ext:Locale Name=DanmakuDisplaySettings}">
                        <ic:SymbolIcon FontSize="14" Symbol="ContentSettings" />
                        <Button.Flyout>
                            <Flyout
                                Opened="OnDisplayFlyoutOpened"
                                Closed="OnDanmakuOptionsClosed"
                                Placement="Top">
                                <ScrollViewer
                                    x:Name="DanmakuOptionsScroller"
                                    HorizontalScrollBarVisibility="Disabled"
                                    HorizontalScrollMode="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <danmaku:DanmakuDisplayOptions ViewModel="{x:Bind ViewModel.Danmaku, Mode=OneWay}" />
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Button
                    x:Name="CompactOverlayButton"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ToggleCompactOverlayCommand, Mode=OneWay}"
                    Style="{StaticResource BasicPlayerIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind GetCompactOverlayTip(ViewModel.Player.IsCompactOverlay), Mode=OneWay}">
                    <ic:SymbolIcon FontSize="14" Symbol="{x:Bind GetCompactOverlaySymbol(ViewModel.Player.IsCompactOverlay), Mode=OneWay}" />
                </Button>
                <Button
                    x:Name="FullScreenButton"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ToggleFullScreenCommand, Mode=OneWay}"
                    Style="{StaticResource BasicPlayerIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind GetFullScreenTip(ViewModel.Player.IsFullScreen), Mode=OneWay}">
                    <ic:SymbolIcon FontSize="14" Symbol="{x:Bind GetFullScreenSymbol(ViewModel.Player.IsFullScreen), Mode=OneWay}" />
                </Button>
                <Button
                    x:Name="OverflowButton"
                    VerticalAlignment="Center"
                    Style="{StaticResource BasicPlayerIconButtonStyle}"
                    ToolTipService.ToolTip="{ext:Locale Name=MoreOptions}"
                    Visibility="Collapsed">
                    <ic:SymbolIcon FontSize="14" Symbol="MoreVertical" />
                    <Button.Flyout>
                        <MenuFlyout
                            Closed="OnFlyoutClosed"
                            Opened="OnDisplayFlyoutOpened"
                            ShouldConstrainToRootBounds="False">
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ToggleCompactOverlayCommand, Mode=OneWay}" Text="{x:Bind GetCompactOverlayTip(ViewModel.Player.IsCompactOverlay), Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <ic:SymbolIcon FontSize="14" Symbol="{x:Bind GetCompactOverlaySymbol(ViewModel.Player.IsCompactOverlay), Mode=OneWay}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind ViewModel.ToggleFullScreenCommand, Mode=OneWay}" Text="{x:Bind GetFullScreenTip(ViewModel.Player.IsFullScreen), Mode=OneWay}">
                                <MenuFlyoutItem.Icon>
                                    <ic:SymbolIcon FontSize="14" Symbol="{x:Bind GetFullScreenSymbol(ViewModel.Player.IsFullScreen), Mode=OneWay}" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <!--
            进度条和它的局部暗底放在同一个动画容器里：竖屏时它们一起从下缘进出，
            右栏则由 ControlsScroller 单独从右缘进出，两者不再共用一个父级位移。
        -->
        <Grid
            x:Name="ProgressHost"
            Grid.Row="1"
            VerticalAlignment="Bottom">
        <Border
            x:Name="ProgressBackdrop"
            Margin="0,-24,0,0"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Offset="0.0" Color="#00000000" />
                    <GradientStop Offset="1.0" Color="#B3000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!--  底部进度条  -->
        <Grid
            x:Name="ProgressPanel"
            Margin="16,-32,16,12"
            ColumnSpacing="12"
            Visibility="{x:Bind ProgressBarVisible, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition />
                <ColumnDefinition Width="60" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="CommonPositionContainer"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsTextScaleFactorEnabled="False"
                    RequestedTheme="Dark"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind GetTimeText(ViewModel.Player.Position), Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsPreviewProgressChanging, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsTextScaleFactorEnabled="False"
                    RequestedTheme="Dark"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind GetTimeText(ViewModel.PreviewPosition), Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsPreviewProgressChanging, Mode=OneWay}" />
            </Grid>
            <TextBlock
                x:Name="ChangingTimeBlock"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                IsTextScaleFactorEnabled="False"
                RequestedTheme="Dark"
                Style="{StaticResource CaptionTextBlockStyle}"
                Visibility="Collapsed" />
            <!--
                自绘分段进度条：内部依次叠放 轨道 / 缓存 / 已播放 三层，
                缓冲进度按章节分段计算，不再像 Slider 那样整条覆盖.
                Slider 与 CacheBar 均已移除，避免出现“两层进度条”.
            -->
            <local:ChapterSegmentBar
                x:Name="ProgressSlider"
                Grid.Column="1"
                Margin="0,0,4,0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                IsEnabled="{x:Bind ViewModel.Player.IsLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}, FallbackValue=False}"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
            <TextBlock
                Grid.Column="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                IsTextScaleFactorEnabled="False"
                RequestedTheme="Dark"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind GetTimeText(ViewModel.Player.Duration), Mode=OneWay}" />
        </Grid>
        </Grid>



        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideState" />
                <VisualState x:Name="BelowWideState">
                    <VisualState.Setters>
                        <Setter Target="FullVolumeContainer.Visibility" Value="Collapsed" />
                        <Setter Target="SlimVolumeButton.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumState">
                    <VisualState.Setters>
                        <Setter Target="LeftPresenter.Visibility" Value="Collapsed" />
                        <Setter Target="LeftColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.Setters>
                        <Setter Target="FullVolumeContainer.Visibility" Value="Collapsed" />
                        <Setter Target="SlimVolumeButton.Visibility" Value="Visible" />
                        <Setter Target="BackwardButton.Visibility" Value="Collapsed" />
                        <Setter Target="ForwardButton.Visibility" Value="Visible" />
                        <Setter Target="PrevButton.Visibility" Value="Collapsed" />
                        <Setter Target="NextButton.Visibility" Value="Visible" />
                        <Setter Target="DanmakuToggleButton.Visibility" Value="Collapsed" />
                        <Setter Target="DanmakuOptionButton.Visibility" Value="Collapsed" />
                        <Setter Target="LeftPresenter.Visibility" Value="Collapsed" />
                        <Setter Target="CompactOverlayButton.Visibility" Value="Collapsed" />
                        <Setter Target="FullScreenButton.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        <Setter Target="LeftColumn.Width" Value="Auto" />
                    </VisualState.Setters>
                </VisualState>
                <!--
                    竖屏小窗：控件全部搬到右侧纵向轨道，底部只留进度条。
                    不沿用窄宽度隐藏规则，高度不足时由 ControlsScroller 纵向滚动。
                    轨道只在 CompactOverlay presenter 且实际区域高 > 宽时启用（见 OverlayControlLayout），
                    普通窗口与横屏小窗仍使用上面的宽度状态.
                -->
                <VisualState x:Name="PortraitState">
                    <VisualState.Setters>
                        <Setter Target="BandBackdrop.Visibility" Value="Collapsed" />
                        <Setter Target="ControlsGrid.Padding" Value="0" />
                        <Setter Target="TransportRow.Height" Value="Auto" />
                        <Setter Target="RightColumn.Width" Value="Auto" />
                        <Setter Target="LeftPresenter.Visibility" Value="Collapsed" />
                        <Setter Target="TransportHost.(Grid.Column)" Value="2" />
                        <Setter Target="TransportHost.HorizontalAlignment" Value="Right" />
                        <Setter Target="TransportHost.VerticalAlignment" Value="Top" />
                        <Setter Target="TransportHost.Margin" Value="0,8,8,8" />
                        <Setter Target="TransportPanel.Orientation" Value="Vertical" />
                        <Setter Target="TransportPanel.Spacing" Value="4" />
                        <Setter Target="RightPanel.(Grid.Row)" Value="1" />
                        <Setter Target="RightPanel.HorizontalAlignment" Value="Right" />
                        <Setter Target="RightPanel.VerticalAlignment" Value="Top" />
                        <Setter Target="RightPanel.Orientation" Value="Vertical" />
                        <Setter Target="RightPanel.Spacing" Value="4" />
                        <Setter Target="RightPanel.Margin" Value="0,0,8,8" />
                        <Setter Target="DanmakuGroup.Orientation" Value="Vertical" />
                        <Setter Target="DanmakuGroup.Spacing" Value="4" />
                        <Setter Target="RailScrim.Visibility" Value="Visible" />
                        <Setter Target="ProgressBackdrop.Visibility" Value="Visible" />
                        <Setter Target="CompactOverlayButton.Visibility" Value="Collapsed" />
                        <Setter Target="FullScreenButton.Visibility" Value="Collapsed" />
                        <Setter Target="OverflowButton.Visibility" Value="Visible" />
                        <Setter Target="FullVolumeContainer.Visibility" Value="Collapsed" />
                        <Setter Target="SlimVolumeButton.Visibility" Value="Visible" />
                        <Setter Target="ControlsScroller.VerticalScrollMode" Value="Auto" />
                        <Setter Target="ControlsScroller.VerticalScrollBarVisibility" Value="Auto" />
                        <Setter Target="ProgressPanel.Margin" Value="16,0,16,8" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</local:PlayerControlBase>
