                        VerticalAlignment="Center"
                        Style="{StaticResource BasicPlayerIconButtonStyle}"
                        ToolTipService.ToolTip="{ext:Locale Name=MoreOptions}"
                        Visibility="Collapsed">
                        <Button.Flyout>
                            <MenuFlyout
                                Closed="OnFlyoutClosed"
                                Opened="OnDisplayFlyoutOpened"
                                ShouldConstrainToRootBounds="True"
                                x:Name="OverflowFlyout"
                                AreOpenCloseAnimationsEnabled="False"
                                Placement="Top"
                                MenuFlyoutPresenterStyle="{StaticResource PlayerMenuPresenter}">
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ToggleCompactOverlayCommand, Mode=OneWay}" Text="{x:Bind GetCompactOverlayTip(ViewModel.Player.IsCompactOverlay), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <ic:SymbolIcon FontSize="14" Symbol="{x:Bind GetCompactOverlaySymbol(ViewModel.Player.IsCompactOverlay), Mode=OneWay}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Command="{x:Bind ViewModel.ToggleFullScreenCommand, Mode=OneWay}" Text="{x:Bind GetFullScreenTip(ViewModel.Player.IsFullScreen), Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <ic:SymbolIcon FontSize="14" Symbol="{x:Bind GetFullScreenSymbol(ViewModel.Player.IsFullScreen), Mode=OneWay}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <ic:SymbolIcon FontSize="14" Symbol="MoreVertical" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        <!--  底部进度条  -->
        <Grid
            x:Name="ProgressHost"
            Grid.Row="1"
            Visibility="{x:Bind ViewModel.IsControlsVisible, Mode=OneWay}">
            <animations:Implicit.HideAnimations>
                <animations:OpacityAnimation
                    From="1"
                    To="0"
                    Duration="0:0:0.2" />
                <animations:TranslationAnimation
                    From="0,0,0"
                    To="0,80,0"
                    Duration="0:0:0.25" />
            </animations:Implicit.HideAnimations>
            <animations:Implicit.ShowAnimations>
                <animations:OpacityAnimation
                    From="0"
                    To="1"
                    Duration="0:0:0.2" />
                <animations:TranslationAnimation
                    From="0,80,0"
                    To="0,0,0"
                    Duration="0:0:0.25" />
            </animations:Implicit.ShowAnimations>
            <Grid
                Margin="16,-32,16,12"
                ColumnSpacing="12"
                Visibility="{x:Bind ViewModel.IsTimelineProgressVisible, Mode=OneWay}"
                x:Name="ProgressPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition/>
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Grid
                    x:Name="CommonPositionContainer"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsTextScaleFactorEnabled="False"
                        RequestedTheme="Dark"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind GetTimeText(ViewModel.Player.Position), Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPreviewProgressChanging, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        IsTextScaleFactorEnabled="False"
                        RequestedTheme="Dark"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind GetTimeText(ViewModel.PreviewPosition), Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsPreviewProgressChanging, Mode=OneWay}" />
                </Grid>
                <TextBlock
                    x:Name="ChangingTimeBlock"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsTextScaleFactorEnabled="False"
                    RequestedTheme="Dark"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Visibility="Collapsed" />
                <!--
                自绘分段进度条：内部依次叠放 轨道 / 缓存 / 已播放 三层，
                缓冲进度按章节分段计算，不再像 Slider 那样整条覆盖.
                Slider 与 CacheBar 均已移除，避免出现“两层进度条”.
            -->
                <local:ChapterSegmentBar
                    x:Name="ProgressSlider"
                    Grid.Column="1"
                    Margin="0,0,4,0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.Player.IsLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}, FallbackValue=False}"
                    ViewModel="{x:Bind ViewModel, Mode=OneWay}" />
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsTextScaleFactorEnabled="False"
                    RequestedTheme="Dark"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind GetTimeText(ViewModel.Player.Duration), Mode=OneWay}" />
            </Grid>

            <!--  直播态：没有可跳转的时间轴，只保留一条静态轨道与已播时长，不出现圆点。  -->
            <Grid
                x:Name="LiveProgressPanel"
                Margin="16,-32,16,12"
                ColumnSpacing="12"
                Visibility="{x:Bind ViewModel.IsLive, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <Border
                    Padding="6,1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    CornerRadius="4">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="LIVE" />
                </Border>
                <Grid
                    Grid.Column="1"
                    Height="4"
                    VerticalAlignment="Center">
                    <Border
                        Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="2" />
                </Grid>
                <TextBlock
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsTextScaleFactorEnabled="False"
                    RequestedTheme="Dark"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.LiveConnector.UptimeText, Mode=OneWay, FallbackValue=''}" />
            </Grid>
        </Grid>
    </Grid>
</local:PlayerControlBase>
