                        <Button.Flyout>
                            <Flyout
                                Closed="OnFlyoutClosed"
                                Opened="OnDisplayFlyoutOpened"
                                Placement="Top"
                                x:Name="SpeedFlyout"
                                AreOpenCloseAnimationsEnabled="False"
                                ShouldConstrainToRootBounds="True"
                                FlyoutPresenterStyle="{StaticResource PlayerSettingsPresenter}">
                                <ScrollViewer
                                    x:Name="SpeedPopup"
                                    HorizontalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <Grid
                                        x:Name="SpeedContent"
