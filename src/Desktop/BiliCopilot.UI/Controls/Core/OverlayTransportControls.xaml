                                            ViewModel="{x:Bind ViewModel.Danmaku, Mode=OneWay}" />
                                    </ScrollViewer>
                                </Flyout>
                            </Button.Flyout>
                            <ic:SymbolIcon FontSize="14" Symbol="ContentSettings" />
                        </Button>
                    </StackPanel>
                    <Button
                        x:Name="CompactOverlayButton"
