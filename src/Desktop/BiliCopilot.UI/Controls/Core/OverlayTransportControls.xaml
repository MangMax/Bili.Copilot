                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnQuickSpeedButtonClick"
                                                Content="1.0x"
                                                Tag="1.0"
                                                VerticalContentAlignment="Center"
                                                Padding="8,0"
                                                Height="32" />
                                            <ToggleButton
                                                x:Name="OneTwoFiveSpeedButton"
                                                Grid.Column="2"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnQuickSpeedButtonClick"
                                                Content="1.25x"
                                                Tag="1.25"
                                                VerticalContentAlignment="Center"
                                                Padding="8,0"
                                                Height="32" />
                                            <ToggleButton
                                                x:Name="OneHalfSpeedButton"
                                                Grid.Column="3"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnQuickSpeedButtonClick"
                                                Content="1.5x"
                                                Tag="1.5"
                                                VerticalContentAlignment="Center"
                                                Padding="8,0"
                                                Height="32" />
                                            <ToggleButton
                                                x:Name="DoubleSpeedButton"
                                                Grid.Column="4"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnQuickSpeedButtonClick"
                                                Content="2.0x"
                                                Tag="2.0"
                                                VerticalContentAlignment="Center"
                                                Padding="8,0"
                                                Height="32" />
                                            <ToggleButton
                                                x:Name="TripleSpeedButton"
                                                Grid.Column="5"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="OnQuickSpeedButtonClick"
                                                Content="3.0x"
                                                Tag="3.0"
                                                VerticalContentAlignment="Center"
                                                Padding="8,0"
                                                Height="32" />
