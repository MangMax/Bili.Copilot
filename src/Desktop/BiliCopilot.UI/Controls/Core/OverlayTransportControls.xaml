                                        <Slider
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            LargeChange="0.5"
                                            Maximum="3"
                                            Minimum="0.1"
                                            SmallChange="0.05"
                                            StepFrequency="0.05"
                                            ValueChanged="OnSpeedValueChanged"
                                            Value="{x:Bind ViewModel.Player.PlaybackRate, Mode=OneWay, FallbackValue=1}"
