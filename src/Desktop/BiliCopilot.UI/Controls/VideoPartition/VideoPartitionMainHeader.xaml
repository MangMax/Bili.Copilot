<?xml version="1.0" encoding="utf-8" ?>
<local:VideoPartitionDetailControlBase
    x:Class="BiliCopilot.UI.Controls.VideoPartition.VideoPartitionMainHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Controls.VideoPartition"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Richasy.BiliKernel.Models"
    mc:Ignorable="d">

    <Grid
        Padding="16,0"
        ColumnSpacing="8"
        Visibility="{x:Bind ViewModel, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
        <Grid.ChildrenTransitions>
            <RepositionThemeTransition IsStaggeringEnabled="False" />
        </Grid.ChildrenTransitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <components:PartitionItemControl
            VerticalAlignment="Center"
            FontWeight="Bold"
            ViewModel="{x:Bind ViewModel.Data, Mode=OneWay}" />

        <ScrollViewer
            Grid.Column="1"
            Margin="0,5,0,0"
            Padding="8,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Hidden"
            VerticalScrollMode="Disabled">
            <SelectorBar x:Name="Selector" />
        </ScrollViewer>

        <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                MinWidth="120"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                ItemsSource="{x:Bind ViewModel.SortTypes, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedSortType, Mode=OneWay}"
                SelectionChanged="OnSortTypeSelectionChanged"
                Visibility="{x:Bind ViewModel.IsRecommend, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PartitionVideoSortType">
                        <TextBlock Text="{x:Bind Converter={StaticResource SortTypeTextConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
                <animations:Implicit.ShowAnimations>
                    <animations:OpacityAnimation
                        From="0"
                        To="1"
                        Duration="0:0:0.2" />
                </animations:Implicit.ShowAnimations>
                <animations:Implicit.HideAnimations>
                    <animations:OpacityAnimation
                        From="1"
                        To="0"
                        Duration="0:0:0.2" />
                </animations:Implicit.HideAnimations>
            </ComboBox>
            <!--
                撤销刷新与刷新按钮并排，两者外观一致：撤销只在推荐子分区刷新完成后出现，
                位置固定在刷新按钮左侧。
                刷新进度就地画在刷新按钮的图标位置，不另起浮层或独立进度控件。
            -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <!--
                    撤销入口的显示与淡出由 code-behind 驱动（UndoRefreshButtonAnimator）：
                    容器上不能套重排过渡，否则撤销折叠时刷新按钮的相对偏移变化，会被一并动画。
                    刷新按钮本身右对齐、撤销折叠时并不位移，因此这里不需要任何补位过渡。
                -->
                <Button
                    x:Name="UndoRefreshButton"
                    AutomationProperties.AutomationId="UndoRefreshButton"
                    AutomationProperties.Name="{ext:Locale Name=UndoRefresh}"
                    Command="{x:Bind ViewModel.UndoRefreshCommand, Mode=OneWay}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ic:SymbolIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Symbol="ArrowUndo" />
                        <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=UndoRefresh}" />
                    </StackPanel>
                    <!--  出现时淡入并轻微放大；消失由 code-behind 的淡出接管。  -->
                    <animations:Implicit.ShowAnimations>
                        <animations:OpacityAnimation
                            From="0"
                            To="1"
                            Duration="0:0:0.18" />
                        <animations:ScaleAnimation
                            From="0.96"
                            To="1"
                            Duration="0:0:0.22" />
                    </animations:Implicit.ShowAnimations>
                </Button>
                <Button
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="RefreshRecommendButton"
                    AutomationProperties.Name="{ext:Locale Name=Refresh}"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsRecommendRefreshing, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                    Visibility="{x:Bind ViewModel.IsRecommend, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Grid
                            Width="14"
                            Height="14"
                            VerticalAlignment="Center">
                            <!--  图标与进度环原位交叉淡入淡出，切换时不闪断。  -->
                            <ic:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Symbol="ArrowSync"
                                Visibility="{x:Bind ViewModel.IsRecommendRefreshing, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
                            <ProgressRing
                                Width="14"
                                Height="14"
                                MinWidth="14"
                                MinHeight="14"
                                AutomationProperties.AutomationId="RefreshProgressRing"
                                AutomationProperties.Name="{ext:Locale Name=RefreshingRecommendVideos}"
                                IsActive="{x:Bind ViewModel.IsRecommendRefreshing, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsRecommendRefreshing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <!--  进度环原地淡入并轻微放大，替代原来的静态图标。  -->
                                <animations:Implicit.ShowAnimations>
                                    <animations:OpacityAnimation
                                        From="0"
                                        To="1"
                                        Duration="0:0:0.16" />
                                    <animations:ScaleAnimation
                                        From="0.8"
                                        To="1"
                                        Duration="0:0:0.2" />
                                </animations:Implicit.ShowAnimations>
                            </ProgressRing>
                        </Grid>
                        <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=Refresh}" />
                    </StackPanel>
                    <animations:Implicit.ShowAnimations>
                        <animations:OpacityAnimation
                            From="0"
                            To="1"
                            Duration="0:0:0.2" />
                    </animations:Implicit.ShowAnimations>
                    <animations:Implicit.HideAnimations>
                        <animations:OpacityAnimation
                            From="1"
                            To="0"
                            Duration="0:0:0.2" />
                    </animations:Implicit.HideAnimations>
                </Button>
                <Button
                    Width="32"
                    Height="32"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    AutomationProperties.Name="{ext:Locale Name=Refresh}"
                    Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="{ext:Locale Name=Refresh}"
                    Visibility="{x:Bind ViewModel.IsRecommend, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                    <ic:SymbolIcon
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Symbol="ArrowSync" />
                    <animations:Implicit.ShowAnimations>
                        <animations:OpacityAnimation
                            From="0"
                            To="1"
                            Duration="0:0:0.2" />
                    </animations:Implicit.ShowAnimations>
                    <animations:Implicit.HideAnimations>
                        <animations:OpacityAnimation
                            From="1"
                            To="0"
                            Duration="0:0:0.2" />
                    </animations:Implicit.HideAnimations>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</local:VideoPartitionDetailControlBase>
