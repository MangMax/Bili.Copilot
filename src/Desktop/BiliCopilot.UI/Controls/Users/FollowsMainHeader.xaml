<?xml version="1.0" encoding="utf-8" ?>
<local:FollowsPageControlBase
    x:Class="BiliCopilot.UI.Controls.Users.FollowsMainHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:local="using:BiliCopilot.UI.Controls.Users"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="2*" MaxWidth="280" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock
            VerticalAlignment="Center"
            Style="{StaticResource BodyStrongTextBlockStyle}"
            Text="{x:Bind ViewModel.ListTitle, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
        <AutoSuggestBox
            Grid.Column="1"
            Margin="8,0"
            VerticalAlignment="Center"
            AutomationProperties.AutomationId="FollowSearchBox"
            AutomationProperties.Name="{ext:Locale Name=SearchAllFollows}"
            PlaceholderText="{ext:Locale Name=SearchAllFollows}"
            QueryIcon="Find"
            QuerySubmitted="OnSearchSubmitted"
            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            TextChanged="OnSearchTextChanged" />
        <Button
            Grid.Column="2"
            VerticalAlignment="Center"
            AutomationProperties.Name="{ext:Locale Name=Refresh}"
            Command="{x:Bind ViewModel.RefreshCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon
                    FontFamily="{StaticResource BiliIconsFontFamily}"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Glyph="{StaticResource IconArrowSync}" />
                <TextBlock VerticalAlignment="Center" Text="{ext:Locale Name=Refresh}" />
            </StackPanel>
        </Button>
    </Grid>
</local:FollowsPageControlBase>
