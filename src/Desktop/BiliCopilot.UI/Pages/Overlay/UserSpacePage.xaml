<?xml version="1.0" encoding="utf-8"?>
<local:UserSpacePageBase
    x:Class="BiliCopilot.UI.Pages.Overlay.UserSpacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comment="using:BiliCopilot.UI.Controls.Comment"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BiliCopilot.UI.Pages.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:moment="using:BiliCopilot.UI.Controls.Moment"
    mc:Ignorable="d">
    <Grid
        x:Name="PageLayout"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        ActualThemeChanged="OnPageThemeChanged"
        SizeChanged="OnPageSizeChanged">
        <Canvas IsHitTestVisible="False">
            <Grid x:Name="Backdrop" Height="600">
                <Grid x:Name="BackdropImage">
                    <controls:RecommendationCoverImage
                        Source="{x:Bind ViewModel.Card.Banner.SourceUri, Mode=OneWay, FallbackValue={x:Null}}" />
                    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.18" />
                </Grid>
                <Border x:Name="BackdropFade">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop x:Name="BackdropFadeStart" Offset="0.12" />
                            <GradientStop x:Name="BackdropFadeMiddle" Offset="0.6" />
                            <GradientStop Offset="1" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Canvas>
        <moment:UserSpacePageBody
            x:Name="SpaceBody"
            Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}" />
        <moment:UserSpaceVideoSearchSection
            x:Name="SearchSection"
            Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay}" />
        <comment:CommentOverlayPanel
            x:Name="CommentPanel"
            IsPanelOpened="{x:Bind ViewModel.IsCommentsOpened, Mode=TwoWay}"
            ViewModel="{x:Bind ViewModel.CommentModule, Mode=OneWay}" />
    </Grid>
</local:UserSpacePageBase>
