<?xml version="1.0" encoding="utf-8"?>
<local:PgcDetailPageBase
    x:Class="BiliCopilot.UI.Pages.Overlay.PgcDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:components="using:BiliCopilot.UI.Controls.Components"
    xmlns:controls="using:BiliCopilot.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:BiliCopilot.UI.Extensions"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:items="using:BiliCopilot.UI.ViewModels.Items"
    xmlns:local="using:BiliCopilot.UI.Pages.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:BiliCopilot.UI.ViewModels.View"
    mc:Ignorable="d">

    <local:PgcDetailPageBase.Resources>
        <UniformGridLayout
            x:Key="EpisodeLayout"
            ItemsStretch="Fill"
            MinColumnSpacing="16"
            MinItemWidth="300"
            MinRowSpacing="18" />
        <DataTemplate x:Key="ReviewTemplate" x:DataType="vm:PgcReviewItemViewModel">
            <Grid Margin="0,0,0,16" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <controls:RecommendationCoverImage
                    Width="36"
                    Height="36"
                    VerticalAlignment="Top"
                    CornerRadius="18"
                    Source="{x:Bind Avatar, Mode=OneWay, FallbackValue={x:Null}}" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="{x:Bind AuthorName, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Text="{x:Bind ScoreText, Mode=OneWay}"
                            Visibility="{x:Bind ScoreText, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind TimeText, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind Title, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}" />
                    <TextBlock
                        IsTextSelectionEnabled="True"
                        MaxLines="8"
                        Text="{x:Bind Content, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind Progress, Mode=OneWay}"
                            Visibility="{x:Bind Progress, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{x:Bind LikeText, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}">
                            <ic:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Symbol="ThumbLike" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="{x:Bind LikeText, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LaborTemplate" x:DataType="vm:PgcLaborItemViewModel">
            <StackPanel Margin="0,0,0,10" Spacing="2">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Title, Mode=OneWay}" />
                <TextBlock
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Content, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>
    </local:PgcDetailPageBase.Resources>

    <Grid
        x:Name="PageLayout"
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        SizeChanged="OnPageSizeChanged">
        <!--  视差背景：随内容滚动缓慢上移  -->
        <Canvas IsHitTestVisible="False">
            <Grid x:Name="Backdrop" Height="760">
                <Grid x:Name="BackdropImage">
                    <controls:RecommendationCoverImage
                        Source="{x:Bind ViewModel.Cover, Mode=OneWay, FallbackValue={x:Null}}"
                        Stretch="UniformToFill" />
                    <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Opacity="0.58" />
                </Grid>
                <Border x:Name="BackdropFade">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0.28" Color="#00000000" />
                            <GradientStop Offset="0.82" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                            <GradientStop Offset="1" Color="{ThemeResource SolidBackgroundFillColorBase}" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>
        </Canvas>

        <ScrollView x:Name="PageScroll" Padding="20,0" Style="{StaticResource PageScrollViewStyle}">
            <StackPanel Margin="0,0,0,24">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="168" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  页头：大海报 + 右侧信息，和海报墙应用一样聚焦  -->
                    <Grid
                        Grid.Row="1"
                        Padding="28,0"
                        ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="200" Height="286">
                            <Border
                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <controls:RecommendationCoverImage
                                    x:Name="PosterCover"
                                    CornerRadius="12"
                                    Source="{x:Bind ViewModel.Cover, Mode=OneWay, FallbackValue={x:Null}}" />
                            </Border>
                        </Grid>
                        <StackPanel
                            Grid.Column="1"
                            Spacing="10"
                            VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border
                                    Padding="9,3"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Visibility="{x:Bind ViewModel.ScoreText, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Text="{x:Bind ViewModel.ScoreText, Mode=OneWay}" />
                                </Border>
                                <Border
                                    Padding="9,3"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Visibility="{x:Bind ViewModel.ProgressText, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind ViewModel.Tags, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                MaxLines="2"
                                Style="{StaticResource TitleLargeTextBlockStyle}"
                                Text="{x:Bind ViewModel.SeasonTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind ViewModel.SeasonTitle, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="1"
                                Text="{x:Bind ViewModel.Alias, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind ViewModel.Alias, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                MaxLines="3"
                                Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="18">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.PlayCount, Converter={StaticResource CountConverter}, Mode=OneWay, FallbackValue='—'}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{ext:Locale Name=PlayCount}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.DanmakuCount, Converter={StaticResource CountConverter}, Mode=OneWay, FallbackValue='—'}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{ext:Locale Name=DanmakuCount}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind ViewModel.FollowCount, Converter={StaticResource CountConverter}, Mode=OneWay, FallbackValue='—'}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{ext:Locale Name=PgcFollowCount}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel
                                Margin="0,4,0,0"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    Padding="18,7"
                                    Command="{x:Bind ViewModel.PlayCommand}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    AutomationProperties.AutomationId="PgcDetailPlay">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ic:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            Symbol="Play" />
                                        <TextBlock Text="{ext:Locale Name=Play}" />
                                    </StackPanel>
                                </Button>
                                <ToggleButton
                                    Padding="14,7"
                                    Command="{x:Bind ViewModel.ToggleFollowCommand}"
                                    IsChecked="{x:Bind ViewModel.IsFollowed, Mode=OneWay}"
                                    AutomationProperties.AutomationId="PgcDetailFollow">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <ic:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            IconVariant="{x:Bind ViewModel.IsFollowed, Mode=OneWay, Converter={StaticResource BoolToIconVariantConverter}}"
                                            Symbol="Heart" />
                                        <TextBlock Text="{ext:Locale Name=Follow}" />
                                    </StackPanel>
                                </ToggleButton>
                                <Button
                                    Width="36"
                                    Height="36"
                                    Padding="0"
                                    Command="{x:Bind ViewModel.RefreshCommand}"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="{ext:Locale Name=Refresh}"
                                    AutomationProperties.Name="{ext:Locale Name=Refresh}">
                                    <ic:SymbolIcon FontSize="15" Symbol="ArrowSync" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid
                        Grid.Row="2"
                        Padding="28,0"
                        MinHeight="46">
                        <components:SlidingTabBar
                            x:Name="TabSelector"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="PgcDetailTabs" />
                    </Grid>
                </Grid>

                <!--  正片 / 花絮等分区内容  -->
                <Grid
                    Margin="24,8,24,0"
                    Visibility="{x:Bind ViewModel.HasEpisodes, Mode=OneWay}">
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Episodes, Mode=OneWay}" Layout="{StaticResource EpisodeLayout}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="items:EpisodeItemViewModel">
                                <base:CardControl
                                    Padding="8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalAlignment="Top"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnEpisodeClick"
                                    CornerRadius="{StaticResource CardSurfaceRadius}"
                                    Tag="{x:Bind}"
                                    AutomationProperties.AutomationId="PgcDetailEpisode"
                                    AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}">
                                    <components:CardContentPanel>
                                        <components:CardMediaFrame Cover="{x:Bind Cover, Mode=OneWay, FallbackValue={x:Null}}">
                                            <components:CardMediaFrame.BottomEnd>
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="11.5"
                                                    Foreground="#F2FFFFFF"
                                                    Text="{x:Bind Duration, Mode=OneWay}" />
                                            </components:CardMediaFrame.BottomEnd>
                                        </components:CardMediaFrame>
                                        <Border MinHeight="22">
                                            <TextBlock
                                                Margin="0,8,0,0"
                                                FontSize="13"
                                                MaxLines="1"
                                                Text="{x:Bind Title, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </components:CardContentPanel>
                                </base:CardControl>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </Grid>

                <!--  演职人员分区  -->
                <StackPanel
                    Margin="28,8,28,0"
                    MaxWidth="960"
                    HorizontalAlignment="Left"
                    Spacing="10"
                    Visibility="{x:Bind ViewModel.ShowIntro, Mode=OneWay}">
                    <ItemsRepeater ItemTemplate="{StaticResource LaborTemplate}" ItemsSource="{x:Bind ViewModel.LaborItems, Mode=OneWay}" />
                </StackPanel>

                <!--  评价：短评与长评分开，各自分页  -->
                <StackPanel
                    Margin="28,8,28,0"
                    MaxWidth="960"
                    HorizontalAlignment="Left"
                    Spacing="14"
                    Visibility="{x:Bind ViewModel.ShowReviews, Mode=OneWay}">
                    <ProgressRing
                        Width="32"
                        Height="32"
                        HorizontalAlignment="Left"
                        IsActive="{x:Bind ViewModel.IsReviewsLoading, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsReviewsLoading, Mode=OneWay}" />
                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowShortReviews, Mode=OneWay}">
                        <ItemsRepeater ItemTemplate="{StaticResource ReviewTemplate}" ItemsSource="{x:Bind ViewModel.ShortReviews, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Spacing="10" Visibility="{x:Bind ViewModel.ShowLongReviews, Mode=OneWay}">
                        <ItemsRepeater ItemTemplate="{StaticResource ReviewTemplate}" ItemsSource="{x:Bind ViewModel.LongReviews, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.ReviewPageText, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}">
                        <Button
                            Padding="12,4"
                            Command="{x:Bind ViewModel.PrevReviewPageCommand}"
                            Content="{ext:Locale Name=PrevPage}"
                            IsEnabled="{x:Bind ViewModel.CanGoPrevReviewPage, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind ViewModel.ReviewPageText, Mode=OneWay}" />
                        <Button
                            Padding="12,4"
                            Command="{x:Bind ViewModel.NextReviewPageCommand}"
                            Content="{ext:Locale Name=NextPage}"
                            IsEnabled="{x:Bind ViewModel.CanGoNextReviewPage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollView>

        <ProgressRing
            Width="36"
            Height="36"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <InfoBar
            Margin="28,24"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Severity="Warning"
            Message="{ext:Locale Name=FailedToLoadPgcDetail}">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="{ext:Locale Name=Retry}" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</local:PgcDetailPageBase>
