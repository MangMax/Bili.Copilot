<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared card frame tokens: video, live, article and tag controls all consume these. -->
    <!-- Outer card radius = cover radius + inset. -->
    <CornerRadius x:Key="CardCoverRadius">4</CornerRadius>
    <CornerRadius x:Key="CardSurfaceRadius">12</CornerRadius>
    <SolidColorBrush x:Key="CardMediaForeground" Color="White" />
    <SolidColorBrush x:Key="CardTagBackground" Color="Black" />
    <!-- Match the content and accent badges in the approved web design. -->
    <SolidColorBrush x:Key="CardContentBadgeBackground" Color="#CC0C4470" />
    <Style x:Key="CardTagBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{StaticResource CardTagBackground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CardTagTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CardMediaForeground}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CardCoverBadgeStyle" TargetType="Border">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource AccentFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="CardCoverBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style
        x:Key="CardMetaTimeTextStyle"
        TargetType="TextBlock"
        BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
</ResourceDictionary>
