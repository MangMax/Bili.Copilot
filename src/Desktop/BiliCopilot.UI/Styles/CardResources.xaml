<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared card frame tokens: the popular video, live and tag controls all consume these. -->
    <!-- Outer card radius = cover radius + inset. -->
    <CornerRadius x:Key="PopularCoverRadius">4</CornerRadius>
    <CornerRadius x:Key="PopularCardRadius">12</CornerRadius>
    <SolidColorBrush x:Key="PopularMediaForeground" Color="White" />
    <SolidColorBrush x:Key="PopularTagBackground" Color="Black" />
    <!-- Match the content and accent badges in the approved web design. -->
    <SolidColorBrush x:Key="PopularContentBadgeBackground" Color="#CC0C4470" />
    <Style x:Key="CardTagBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{StaticResource PopularTagBackground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CardTagTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PopularMediaForeground}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
